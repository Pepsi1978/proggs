<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>JarvisWindows</AssemblyName>
    <RootNamespace>JarvisWindows</RootNamespace>
    <Product>Jarvis Windows HP</Product>
    <!-- Regel 6: Version pro Commit genau einmal erhöhen. Zeitstempel setzt der Bau selbst aus der Systemzeit. -->
    <Version>1.0.22</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="Exists('Resources\AppIcon.ico')">Resources\AppIcon.ico</ApplicationIcon>
    <NoWarn>$(NoWarn);CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8625;CS1998;CS4014;CA1416;NU1701;WFO1000</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Sources\**\*.cs" />
    <!-- Beide UI-Welten sind nötig (NotifyIcon, WPF); die globalen WinForms-Namen stünden sonst mit WPF im Streit. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
    <AssemblyMetadata Include="BuildTimestamp" Value="$([System.DateTime]::Now.ToString('dd.MM.yyyy, HH:mm'))" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="1.13.8" />
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.win-x64" Version="1.13.8" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3650.58" />
    <PackageReference Include="System.Speech" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="funktionen.md;jarvis-wissen.md" CopyToOutputDirectory="PreserveNewest" Link="Resources\%(Filename)%(Extension)" />
    <Content Include="..\Jarvis\app\src\main\assets\funktionen.md" CopyToOutputDirectory="PreserveNewest" Link="Resources\handy-funktionen.md" />
    <Content Include="..\Jarvis\app\src\main\assets\parakeet\bpe.vocab" CopyToOutputDirectory="PreserveNewest" Link="Resources\bpe.vocab" />
    <Content Include="Resources\**\*" CopyToOutputDirectory="PreserveNewest" Link="Resources\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>

