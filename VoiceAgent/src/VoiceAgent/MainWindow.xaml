<Window x:Class="VoiceAgent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VoiceAgent"
        mc:Ignorable="d"
        Title="VoiceAgent" Height="640" Width="840"
        Icon="/assets/voiceagent.ico"
        Background="#15171C">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Kopfzeile: Status + Mikrofon-Schalter + Einstellungen -->
        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,10">
            <TextBlock x:Name="StatusText" DockPanel.Dock="Left"
                       Text="Bereit" FontSize="13" Foreground="#9AA0AA"
                       VerticalAlignment="Center"/>
            <Button x:Name="SettingsButton" DockPanel.Dock="Right" Content="Einstellungen"
                    Padding="12,4" Click="SettingsButton_Click"/>
            <ToggleButton x:Name="MicToggle" DockPanel.Dock="Right" Content="Mikrofon: an"
                          Margin="0,0,8,0" Padding="12,4" Click="MicToggle_Click"/>
        </DockPanel>

        <!-- Gespraechsverlauf -->
        <Border Grid.Row="1" Background="#1E2128" CornerRadius="8" Padding="10">
            <TextBox x:Name="ConversationBox" IsReadOnly="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" BorderThickness="0"
                     Background="Transparent" Foreground="#E4E6EB" FontSize="14"/>
        </Border>

        <!-- Eingabezeile (Text-Eingabe ergaenzend zur Sprache) -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="InputBox" Grid.Column="0" FontSize="14" Padding="8,6"
                     Background="#23262E" Foreground="#E4E6EB" BorderBrush="#333845"
                     KeyDown="InputBox_KeyDown"/>
            <Button x:Name="SendButton" Grid.Column="1" Content="Senden" Margin="8,0,0,0"
                    Padding="18,6" Click="SendButton_Click"/>
        </Grid>
    </Grid>
</Window>
