<Window x:Class="VoiceAgent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VoiceAgent"
        mc:Ignorable="d"
        Title="VoiceAgent" Height="640" Width="980"
        Icon="/assets/voiceagent.ico"
        Background="#FBFAF8"
        FontFamily="Segoe UI">
    <Window.Resources>
        <!-- Flache, abgerundete Buttons (helle Variante) -->
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Foreground" Value="#37322B"/>
            <Setter Property="Background" Value="#ECE7DD"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="8" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#E0D9CC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dunkler Akzent-Button (Neue Session) -->
        <Style x:Key="DarkButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Background" Value="#1F1B16"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="9" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#332C24"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Mikrofon-Schalter: abgerundet wie die Buttons (Radius 8), in BEIDEN Zustaenden rund.
             Zustand wird ueber die Farbe gezeigt (Ruhe = hell, wach/aktiv = dunkel) statt ueber
             den eckigen WPF-Default-Stil. -->
        <Style x:Key="FlatToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="#37322B"/>
            <Setter Property="Background" Value="#ECE7DD"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="b" CornerRadius="8" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#E0D9CC"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#1F1B16"/>
                                <Setter TargetName="b" Property="TextElement.Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Abgerundete, helle Texteingabe -->
        <Style x:Key="RoundedInput" TargetType="TextBox">
            <Setter Property="BorderBrush" Value="#E0D9CC"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#37322B"/>
            <Setter Property="CaretBrush" Value="#37322B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="12" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sessions-Listeneintrag: abgerundet, Hover, aktiv = Terracotta -->
        <Style x:Key="SessionItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Foreground" Value="#37322B"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="b" CornerRadius="8" Background="Transparent" Padding="2">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#ECE7DD"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#E3DDD0"/>
                                <Setter TargetName="b" Property="TextElement.Foreground" Value="#9A6B2F"/>
                                <Setter TargetName="b" Property="TextElement.FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarCol" Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ Sidebar: Sessions (Layout C, warm-hell) ============ -->
        <Border Grid.Column="0" Background="#F3F0EA" BorderBrush="#E7E2D8" BorderThickness="0,0,1,0">
            <DockPanel Margin="12">
                <Button DockPanel.Dock="Top" x:Name="NewSessionButton" Content="＋  Neue Session"
                        Click="NewSessionButton_Click" Height="36" Margin="0,0,0,10"
                        Style="{StaticResource DarkButton}"/>

                <Border DockPanel.Dock="Top" CornerRadius="10" Background="#E9E5DC" Margin="0,0,0,12">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="🔍" Margin="9,0,4,0"
                                   VerticalAlignment="Center" Foreground="#8A8275"/>
                        <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0"
                                 Foreground="#37322B" CaretBrush="#37322B" Padding="2,7,8,7"
                                 VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged"
                                 ToolTip="Sessions durchsuchen…"/>
                    </DockPanel>
                </Border>

                <TextBlock DockPanel.Dock="Top" Text="SESSIONS" FontSize="10" Foreground="#A8A090"
                           Margin="2,0,0,6"/>
                <ListBox x:Name="SessionList" BorderThickness="0" Background="Transparent"
                         ItemContainerStyle="{StaticResource SessionItem}"
                         SelectionChanged="SessionList_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Background="Transparent">
                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Umbenennen" Click="RenameSession_Click"/>
                                        <MenuItem Header="Anpinnen / Lösen" Click="PinSession_Click"/>
                                        <MenuItem Header="Löschen" Click="DeleteSession_Click"/>
                                    </ContextMenu>
                                </Grid.ContextMenu>
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                           Padding="8,7,8,7"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ============ Hauptbereich ============ -->
        <Grid Grid.Column="1" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Kopfzeile: Status + Uhr + Kontext-Pille + Schalter -->
            <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,12">
                <TextBlock x:Name="StatusText" DockPanel.Dock="Left"
                           Text="Bereit" FontSize="13" Foreground="#8A8275"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="ClockText" DockPanel.Dock="Left" Margin="16,0,0,0"
                           FontSize="13" FontWeight="SemiBold" Foreground="#37322B"
                           VerticalAlignment="Center"/>
                <Button x:Name="SettingsButton" DockPanel.Dock="Right" Content="⚙  Einstellungen"
                        Style="{StaticResource FlatButton}" Click="SettingsButton_Click"/>
                <Button x:Name="LogButton" DockPanel.Dock="Right" Content="Live-Log"
                        Margin="0,0,8,0" Style="{StaticResource FlatButton}" Click="LogButton_Click"/>
                <ToggleButton x:Name="MicToggle" DockPanel.Dock="Right" Content="🎙 Mikrofon: an"
                              Margin="0,0,8,0" Style="{StaticResource FlatToggle}" Click="MicToggle_Click"/>
                <Border DockPanel.Dock="Right" x:Name="ContextPill" CornerRadius="8" Background="#F4EAD6"
                        Padding="11,4" Margin="0,0,8,0" VerticalAlignment="Center">
                    <TextBlock x:Name="ContextPillText" Foreground="#9A6B2F" FontSize="12" Text="◐ Kontext 0%"/>
                </Border>
            </DockPanel>

            <!-- Gespraechsverlauf -->
            <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="12"
                    BorderBrush="#ECE6DB" BorderThickness="1">
                <RichTextBox x:Name="ConversationBox" IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto" BorderThickness="0"
                             Background="Transparent" Foreground="#37322B" FontSize="14">
                    <RichTextBox.Resources>
                        <Style TargetType="Paragraph">
                            <Setter Property="Margin" Value="0,0,0,8"/>
                        </Style>
                    </RichTextBox.Resources>
                </RichTextBox>
            </Border>

            <!-- Eingabezeile (schwebend, abgerundet) -->
            <Grid Grid.Row="2" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="InputBox" Grid.Column="0" FontSize="14"
                         Style="{StaticResource RoundedInput}" KeyDown="InputBox_KeyDown"/>
                <Button x:Name="SendButton" Grid.Column="1" Content="Senden" Margin="10,0,0,0"
                        Padding="20,7" Style="{StaticResource DarkButton}" Click="SendButton_Click"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
