<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- WinForms NUR fuer das Tray-Icon (System.Windows.Forms.NotifyIcon). Es handhabt den
         Explorer-Neustart (Almanach §6.1) und das Tray-Kontextmenue (§6.3) selbst — robuster
         als ein eigener Shell_NotifyIcon-Nachbau. -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>VoiceAgent</RootNamespace>
    <AssemblyName>VoiceAgent</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\voiceagent.ico</ApplicationIcon>
    <!-- Sichtbare App-Version (Regel: version-bump-visible-always). Bei JEDER Aenderung hochzaehlen.
         Wird in der Titelleiste angezeigt ("VoiceAgent v1.0.0") und beim Start geloggt. -->
    <Version>1.3.0</Version>
  </PropertyGroup>

  <!-- WICHTIG (Almanach-Kandidat): UseWindowsForms + UseWPF + ImplicitUsings zieht
       System.Drawing und System.Windows.Forms als GLOBALE usings ein. Dadurch werden in den
       WPF-Dateien Color/MessageBox/Application mehrdeutig (CS0104). Diese zwei globalen usings
       entfernen — der Tray-Code (Services/TrayIcon.cs) zieht sie lokal per file-scoped using. -->
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="assets\voiceagent.ico" />
    <!-- Faehigkeiten-Liste: wird neben die EXE kopiert und beim Start eingelesen (siehe AgentCapabilities). -->
    <Content Include="capabilities.md" CopyToOutputDirectory="PreserveNewest" />
    <!-- Erinnerungs-Signalton (Frank's WAV): wird neben die EXE kopiert und vom Chime abgespielt. -->
    <Content Include="assets\message1.wav" CopyToOutputDirectory="PreserveNewest" />
    <!-- Wake-Word-Bestaetigungston: wird beim Erkennen des Weckworts abgespielt. -->
    <Content Include="assets\wakeword.wav" CopyToOutputDirectory="PreserveNewest" />
    <!-- Einschlafton (abfallend): beim automatischen Stille-Timeout, wenn der Agent aufhoert zuzuhoeren. -->
    <Content Include="assets\sleep.wav" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Auswaehlbare Start-/Stop-Toene (CC0, Freesound). Ordner-Scan zur Laufzeit (ChimeLibrary).
         CopyToPublishDirectory zusaetzlich, damit sie beim Single-File-Publish nicht fehlen (Almanach §1.9). -->
    <Content Include="assets\sounds\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Wake-Word-Modell (sherpa-onnx KWS, int8). Als Content neben die EXE kopieren — die native
         API erwartet Dateipfade, NICHT embedded (Best-Practice wake-word §6). -->
    <Content Include="assets\wakeword-model\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.8" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <!-- Wake-Word-Erkennung: Meta-Paket + Windows-x64-Runtime (gleiche Version, Almanach #4).
         Apache-2.0, 100 % offline. Bei Release-Publish: RID win-x64 + <SelfContained>true</SelfContained>
         explizit setzen (seit .NET 8 impliziert RID kein self-contained mehr — Almanach #29);
         KEIN PublishTrimmed (WPF, Almanach §1.5/#30). -->
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="1.13.2" />
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.win-x64" Version="1.13.2" />
  </ItemGroup>

</Project>
