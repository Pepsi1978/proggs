<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== OpenCode Launcher · Light ===== -->
    <!-- Gleiche Keys wie DarkTheme.xaml. -->

    <SolidColorBrush x:Key="WindowBg"          Color="#F5F4FA"/>
    <SolidColorBrush x:Key="TitleBarBg"        Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBg"            Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceBg"         Color="#F6F5FC"/>
    <SolidColorBrush x:Key="HoverBg"           Color="#EEECF8"/>
    <SolidColorBrush x:Key="ChipBg"            Color="#EEECF7"/>

    <SolidColorBrush x:Key="BorderBrushSoft"   Color="#E7E4F1"/>
    <SolidColorBrush x:Key="BorderBrushStrong" Color="#DBD8EA"/>
    <SolidColorBrush x:Key="GridLineBrush"     Color="#E7E4F1"/>

    <SolidColorBrush x:Key="TextBrush"         Color="#211D33"/>
    <SolidColorBrush x:Key="MutedBrush"        Color="#6A6782"/>
    <SolidColorBrush x:Key="DimBrush"          Color="#9995AD"/>

    <SolidColorBrush x:Key="AccentBrush"        Color="#7C6CF5"/>
    <SolidColorBrush x:Key="AccentHoverBrush"   Color="#6455E0"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#5646C8"/>
    <SolidColorBrush x:Key="AccentSoftBg"       Color="#ECEAFB"/>
    <SolidColorBrush x:Key="AccentLineBrush"    Color="#D9D4F7"/>

    <SolidColorBrush x:Key="SelectedBg"         Color="#EEEBFC"/>
    <SolidColorBrush x:Key="SelectedBorderBrush" Color="#7C6CF5"/>
    <SolidColorBrush x:Key="RowSelectedBg"      Color="#F1EEFC"/>

    <SolidColorBrush x:Key="StatusOkBg"    Color="#DCFCE7"/>
    <SolidColorBrush x:Key="StatusOkFg"    Color="#15803D"/>
    <SolidColorBrush x:Key="StatusWarnBg"  Color="#FEF3C7"/>
    <SolidColorBrush x:Key="StatusWarnFg"  Color="#B45309"/>
    <SolidColorBrush x:Key="StatusBadBg"   Color="#FEE2E2"/>
    <SolidColorBrush x:Key="StatusBadFg"   Color="#DC2626"/>

    <SolidColorBrush x:Key="CloseHoverBg"  Color="#E5484D"/>

    <!-- 0 = OS-Titelleiste im Light-Style -->
    <system:Int32 x:Key="ImmersiveDark" xmlns:system="clr-namespace:System;assembly=mscorlib">0</system:Int32>

</ResourceDictionary>
