{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "theme": "dark",
  "skipDangerousModePermissionPrompt": true,
  "claudeMdExcludes": [
    "**/proggs/CLAUDE.md",
    "**/proggs/CLAUDE.local.md",
    "**/.claude/rules/**"
  ],
  "statusLine": {
    "type": "command",
    "command": "bash ~/proggs/claude-code-setup/hooks/statusline.sh",
    "refreshInterval": 10
  }
}
