<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>OpenCodeLauncher</RootNamespace>
    <AssemblyName>OpenCodeLauncher</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.16.6</Version>
    <FileVersion>1.16.6.0</FileVersion>
    <AssemblyVersion>1.16.6.0</AssemblyVersion>
    <Company>Pepsi1978</Company>
    <Product>OpenCode Launcher</Product>
    <Copyright>© 2026 Pepsi1978</Copyright>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\opencode-setup\AGENTS-global.md" Link="Profiles\OpenCode\standard\global.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Profiles\OpenCode\standard\project.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
