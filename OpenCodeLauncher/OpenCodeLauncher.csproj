<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>OpenCodeLauncher</RootNamespace>
    <AssemblyName>OpenCodeLauncher</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.17.3</Version>
    <FileVersion>1.17.3.0</FileVersion>
    <AssemblyVersion>1.17.3.0</AssemblyVersion>
    <Company>Pepsi1978</Company>
    <Product>OpenCode Launcher</Product>
    <Copyright>© 2026 Pepsi1978</Copyright>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\opencode-setup\AGENTS-global.md" Link="Profiles\OpenCode\standard\global.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Profiles\OpenCode\standard\project.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Profiles\ClaudeCode ist ein LIVE Claude-Code-Config-Ordner (CLAUDE_CONFIG_DIR), kein
       Assembly-Inhalt. Vom Build-Globbing ausschliessen, damit Laufzeit-Dateien (Login-Token,
       projects/, sessions/) niemals kompiliert oder in den Publish-Output gebuendelt werden. -->
  <ItemGroup>
    <Compile Remove="Profiles\ClaudeCode\**" />
    <Page Remove="Profiles\ClaudeCode\**" />
    <None Remove="Profiles\ClaudeCode\**" />
    <Content Remove="Profiles\ClaudeCode\**" />
    <EmbeddedResource Remove="Profiles\ClaudeCode\**" />
  </ItemGroup>

</Project>
