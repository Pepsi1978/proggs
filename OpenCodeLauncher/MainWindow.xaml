<Window x:Class="OpenCodeLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:OpenCodeLauncher.ViewModels"
        xmlns:m="clr-namespace:OpenCodeLauncher.Models"
        Title="OpenCode Launcher"
        Height="900" Width="1720"
        MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="#242434"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextElement.Foreground="#E8E8EC"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
        FontSize="14">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="18"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#28283A"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="#39394E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style x:Key="AccentBtn" TargetType="Button">
            <Setter Property="Background" Value="#5B5BD6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="22,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#6F6FE0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#4A4AB8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#3A3A44"/>
                                <Setter Property="Foreground" Value="#888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GhostBtn" TargetType="Button" BasedOn="{StaticResource AccentBtn}">
            <Setter Property="Background" Value="#2B2B3D"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#34344A"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#29293B"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HeaderToggleBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E8E8EC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#34344A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2C2C40"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WindowBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#C0C0CC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#34344A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2C2C40"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ModelItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Foreground" Value="#E8E8EC"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="#2D2D42" CornerRadius="10" Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="#34344A">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#35354F"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#5B5BD6"/>
                                <Setter TargetName="bd" Property="Background" Value="#383858"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="RowBackground" Value="#28283A"/>
            <Setter Property="AlternatingRowBackground" Value="#2C2C40"/>
            <Setter Property="Foreground" Value="#E8E8EC"/>
            <Setter Property="BorderBrush" Value="#39394E"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#39394E"/>
            <Setter Property="VerticalGridLinesBrush" Value="#39394E"/>
            <Setter Property="RowHeight" Value="34"/>
            <Setter Property="ColumnHeaderHeight" Value="38"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="CanUserSortColumns" Value="True"/>
            <Setter Property="CanUserResizeColumns" Value="True"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#242434"/>
            <Setter Property="Foreground" Value="#B8B8C4"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="#39394E"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#3B3B5A"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#383858"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="#242434" CornerRadius="18" BorderBrush="#242434" BorderThickness="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Titelleiste (dragbar) -->
            <Grid Grid.Row="0" Height="56" Background="#242434" MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <Border Width="30" Height="30" CornerRadius="9" Background="#313154" Margin="0,0,12,0">
                        <TextBlock Text="✦" Foreground="#9C9CFF" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="OpenCode Launcher" Foreground="#F2F2FA" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Version}" Foreground="#888894" FontSize="12" Margin="12,1,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Button x:Name="MinBtn" Style="{StaticResource WindowBtn}" Width="40" Height="32" Content="—" FontSize="18" Click="MinBtn_Click"/>
                    <Button x:Name="MaxBtn" Style="{StaticResource WindowBtn}" Width="40" Height="32" Content="▢" FontSize="18" Click="MaxBtn_Click"/>
                    <Button x:Name="CloseBtn" Style="{StaticResource WindowBtn}" Width="40" Height="32" Content="✕" FontSize="16" Click="CloseBtn_Click"/>
                </StackPanel>
            </Grid>

            <!-- Hauptbereich -->
            <Grid Grid.Row="1" Margin="14,10,14,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" MinWidth="240"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Linke Spalte: Modelle (Drag&Drop) -->
                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="Modelle" FontSize="13" FontWeight="SemiBold" Foreground="#B8B8C4" VerticalAlignment="Center"/>
                            <Button Style="{StaticResource GhostBtn}" Content="+ Hinzufügen" DockPanel.Dock="Right" Margin="8,0,0,0" Padding="10,5" FontSize="12"
                                    Command="{Binding AddModelCommand}"/>
                        </DockPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="ModelGroupsList" ItemsSource="{Binding ModelGroups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="m:ModelGroupEntry">
                                        <Border Background="#26263A" BorderBrush="#373750" BorderThickness="1" CornerRadius="10" Margin="0,0,0,8" Padding="8"
                                                AllowDrop="True"
                                                PreviewMouseLeftButtonDown="ModelGroup_PreviewMouseLeftButtonDown"
                                                PreviewMouseMove="ModelGroup_PreviewMouseMove"
                                                DragEnter="ModelGroup_DragEnter" DragOver="ModelGroup_DragOver" Drop="ModelGroup_Drop">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="⋮⋮" Foreground="#606078" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" Cursor="SizeAll"
                                                               PreviewMouseLeftButtonDown="ModelGroupGrip_PreviewMouseLeftButtonDown"
                                                               PreviewMouseMove="ModelGroupGrip_PreviewMouseMove"/>
                                                    <Button Grid.Column="1" Style="{StaticResource HeaderToggleBtn}" HorizontalContentAlignment="Left"
                                                            Command="{Binding DataContext.ToggleGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}">
                                                        <TextBlock Text="{Binding HeaderText}" Foreground="#E8E8EC" FontSize="13" FontWeight="SemiBold"/>
                                                    </Button>
                                                    <TextBlock Grid.Column="2" Text="▾" Foreground="#8A8AF0" FontSize="13" VerticalAlignment="Center"/>
                                                </Grid>

                                                <ListBox Style="{x:Null}"
                                                         Background="Transparent" BorderThickness="0"
                                                         ItemsSource="{Binding Models}"
                                                         SelectedItem="{Binding DataContext.SelectedModel, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                                                         ItemContainerStyle="{StaticResource ModelItem}"
                                                         AllowDrop="True"
                                                         Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}"
                                                         PreviewMouseLeftButtonDown="ModelList_PreviewMouseLeftButtonDown"
                                                         PreviewMouseMove="ModelList_PreviewMouseMove"
                                                         DragEnter="ModelList_DragEnter" DragOver="ModelList_DragOver" Drop="ModelList_Drop"
                                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate DataType="m:ModelEntry">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="⋮⋮" Foreground="#555560" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" Cursor="SizeAll"/>
                                                                <StackPanel Grid.Column="1">
                                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="#E8E8EC"/>
                                                                    <TextBlock Text="{Binding ModelString}" FontSize="11" Foreground="#888894"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <DockPanel Grid.Row="2" Margin="0,10,0,0">
                            <Button Style="{StaticResource GhostBtn}" Content="Entfernen" DockPanel.Dock="Right" Padding="10,5" FontSize="12"
                                    Command="{Binding RemoveModelCommand}"/>
                            <TextBlock Text="Drag zum Sortieren" FontSize="11" Foreground="#666670" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Grid>
                </Border>

                <!-- Rechte Spalte: Provider -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#B8B8C4" VerticalAlignment="Center" Margin="0,0,12,0">
                                <Run Text="Provider"/>
                                <Run Text=" — " Foreground="#555560"/>
                                <Run Text="{Binding SelectedModel.DisplayName, FallbackValue='—'}" Foreground="#8A8AF0"/>
                            </TextBlock>
                            <Button Style="{StaticResource GhostBtn}" Content="↻ Aktualisieren" DockPanel.Dock="Right" Padding="10,5" FontSize="12"
                                    Command="{Binding RefreshCommand}"/>
                        </DockPanel>
                        <DataGrid x:Name="ProviderGrid" Grid.Row="1"
                                  ItemsSource="{Binding Providers}" SelectedItem="{Binding SelectedProvider}"
                                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                                  HeadersVisibility="Column" CanUserSortColumns="True"
                                  ColumnWidth="Auto" RowHeaderWidth="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Provider" Binding="{Binding ProviderName}" Width="520" SortMemberPath="ProviderName"/>
                                <DataGridTextColumn Header="Input $/1M" Binding="{Binding InputPerMillion, StringFormat={}{0:0.####}}" Width="170"/>
                                <DataGridTextColumn Header="Output $/1M" Binding="{Binding OutputPerMillion, StringFormat={}{0:0.####}}" Width="170"/>
                                <DataGridTextColumn Header="Cache Read $/1M" Binding="{Binding CacheReadText}" Width="220"/>
                                <DataGridTextColumn Header="Kontext" Binding="{Binding ContextLength, StringFormat=N0}" Width="150"/>
                                <DataGridTextColumn Header="Throughput" Binding="{Binding ThroughputText}" Width="150"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="*" MinWidth="160"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Fußleiste: Arbeitsverzeichnis + Start + Version -->
            <Border Grid.Row="2" Background="#242434" BorderBrush="#3A3A52" BorderThickness="0,1,0,0" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Arbeitsverzeichnis:" Foreground="#888894" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Grid.Column="1" x:Name="WorkDirBox" Text="{Binding WorkDir, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" Padding="9,7" Background="#2B2B3D" Foreground="#E8E8EC" BorderBrush="#41415A" BorderThickness="1"/>
                    <Button Grid.Column="2" Style="{StaticResource GhostBtn}" Content="…" Margin="0,0,8,0" Padding="14,5" Click="BrowseWorkDir_Click"/>
                    <Button Grid.Column="3" Style="{StaticResource GhostBtn}" Content="Fehlerdetails" Padding="12,7" Margin="0,0,8,0" IsEnabled="{Binding HasLastError}"
                            Command="{Binding ShowLastErrorCommand}"/>
                    <Button Grid.Column="4" Style="{StaticResource GhostBtn}" Content="Logs" Padding="12,7" Margin="0,0,8,0"
                            Command="{Binding OpenLogFolderCommand}"/>
                    <TextBlock Grid.Column="5" x:Name="StatusBlock" Text="{Binding StatusText}" Foreground="#888894" VerticalAlignment="Center" Margin="0,0,16,0" TextTrimming="CharacterEllipsis" MaxWidth="360"/>
                    <Button Grid.Column="6" Style="{StaticResource AccentBtn}" Content="▶ Start" Padding="28,10" FontSize="14"
                            Command="{Binding StartCommand}"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
