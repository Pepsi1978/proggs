<Window x:Class="OpenCodeLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:OpenCodeLauncher.ViewModels"
        xmlns:m="clr-namespace:OpenCodeLauncher.Models"
        Title="OpenCode Launcher"
        Height="720" Width="1180"
        MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="#1F1F27"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextElement.Foreground="#E8E8EC"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
        FontSize="14">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#26262E"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="#3A3A44"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style x:Key="AccentBtn" TargetType="Button">
            <Setter Property="Background" Value="#5B5BD6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="22,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#6F6FE0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#4A4AB8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#3A3A44"/>
                                <Setter Property="Foreground" Value="#888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GhostBtn" TargetType="Button" BasedOn="{StaticResource AccentBtn}">
            <Setter Property="Background" Value="#1F1F26"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2E2E38"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#26262E"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ModelItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Foreground" Value="#E8E8EC"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="#20202A" CornerRadius="8" Padding="{TemplateBinding Padding}" BorderThickness="2" BorderBrush="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2A2A36"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#5B5BD6"/>
                                <Setter TargetName="bd" Property="Background" Value="#2E2E3E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="RowBackground" Value="#22222C"/>
            <Setter Property="AlternatingRowBackground" Value="#262630"/>
            <Setter Property="Foreground" Value="#E8E8EC"/>
            <Setter Property="BorderBrush" Value="#3A3A44"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#33333D"/>
            <Setter Property="VerticalGridLinesBrush" Value="#33333D"/>
            <Setter Property="RowHeight" Value="34"/>
            <Setter Property="ColumnHeaderHeight" Value="38"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="CanUserSortColumns" Value="True"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1B1B22"/>
            <Setter Property="Foreground" Value="#B8B8C4"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="#33333D"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#3A3A4E"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2E2E3E"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="#1F1F27" CornerRadius="0" BorderBrush="#33333D" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Titelleiste (dragbar) -->
            <Grid Grid.Row="0" Height="48" Background="#1F1F27" MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <TextBlock Text="✦" Foreground="#8A8AF0" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="OpenCode Launcher" Foreground="#E8E8EC" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Version}" Foreground="#888894" FontSize="12" Margin="12,1,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Button x:Name="MinBtn" Width="40" Height="32" Background="Transparent" BorderThickness="0" Foreground="#C0C0CC" Content="—" Click="MinBtn_Click" Cursor="Hand"/>
                    <Button x:Name="MaxBtn" Width="40" Height="32" Background="Transparent" BorderThickness="0" Foreground="#C0C0CC" Content="□" Click="MaxBtn_Click" Cursor="Hand"/>
                    <Button x:Name="CloseBtn" Width="40" Height="32" Background="Transparent" BorderThickness="0" Foreground="#C0C0CC" Content="✕" Click="CloseBtn_Click" Cursor="Hand"/>
                </StackPanel>
            </Grid>

            <!-- Hauptbereich -->
            <Grid Grid.Row="1" Margin="16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" MinWidth="240"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Linke Spalte: Modelle (Drag&Drop) -->
                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="Modelle" FontSize="13" FontWeight="SemiBold" Foreground="#B8B8C4" VerticalAlignment="Center"/>
                            <Button Style="{StaticResource GhostBtn}" Content="+ Hinzufügen" DockPanel.Dock="Right" Margin="8,0,0,0" Padding="10,5" FontSize="12"
                                    Command="{Binding AddModelCommand}"/>
                        </DockPanel>
                        <ListBox x:Name="ModelList" Grid.Row="1" Style="{x:Null}"
                                 Background="Transparent" BorderThickness="0"
                                 ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}"
                                 ItemContainerStyle="{StaticResource ModelItem}"
                                 AllowDrop="True" Drop="ModelList_Drop" DragEnter="ModelList_DragEnter" PreviewMouseMove="ModelList_PreviewMouseMove"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="m:ModelEntry">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="⋮⋮" Foreground="#555560" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" Cursor="SizeAll"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="#E8E8EC"/>
                                            <TextBlock Text="{Binding Slug}" FontSize="11" Foreground="#888894"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <DockPanel Grid.Row="2" Margin="0,10,0,0">
                            <Button Style="{StaticResource GhostBtn}" Content="Entfernen" DockPanel.Dock="Right" Padding="10,5" FontSize="12"
                                    Command="{Binding RemoveModelCommand}"/>
                            <TextBlock Text="Drag zum Sortieren" FontSize="11" Foreground="#666670" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Grid>
                </Border>

                <!-- Rechte Spalte: Provider -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#B8B8C4" VerticalAlignment="Center" Margin="0,0,12,0">
                                <Run Text="Provider"/>
                                <Run Text=" — " Foreground="#555560"/>
                                <Run Text="{Binding SelectedModel.DisplayName, FallbackValue='—'}" Foreground="#8A8AF0"/>
                            </TextBlock>
                            <Button Style="{StaticResource GhostBtn}" Content="↻ Aktualisieren" DockPanel.Dock="Right" Padding="10,5" FontSize="12"
                                    Command="{Binding RefreshCommand}"/>
                        </DockPanel>
                        <DataGrid x:Name="ProviderGrid" Grid.Row="1"
                                  ItemsSource="{Binding Providers}" SelectedItem="{Binding SelectedProvider}"
                                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                                  HeadersVisibility="Column" CanUserSortColumns="True"
                                  ColumnWidth="Auto" RowHeaderWidth="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Provider" Binding="{Binding ProviderName}" Width="*" SortMemberPath="ProviderName"/>
                                <DataGridTextColumn Header="Input $/1M" Binding="{Binding InputPerMillion, StringFormat={}{0:0.####}}" Width="90"/>
                                <DataGridTextColumn Header="Output $/1M" Binding="{Binding OutputPerMillion, StringFormat={}{0:0.####}}" Width="100"/>
                                <DataGridTextColumn Header="Cache Read $/1M" Binding="{Binding CacheReadText}" Width="120"/>
                                <DataGridTextColumn Header="Kontext" Binding="{Binding ContextLength, StringFormat=N0}" Width="90"/>
                                <DataGridTextColumn Header="Throughput" Binding="{Binding ThroughputText}" Width="105"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Fußleiste: Arbeitsverzeichnis + Start + Version -->
            <Border Grid.Row="2" Background="#1F1F26" BorderBrush="#33333D" BorderThickness="0,1,0,0" Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Arbeitsverzeichnis:" Foreground="#888894" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Grid.Column="1" x:Name="WorkDirBox" Text="{Binding WorkDir, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" Padding="8,6" Background="#1A1A22" Foreground="#E8E8EC" BorderBrush="#3A3A44" BorderThickness="1"/>
                    <Button Grid.Column="2" Style="{StaticResource GhostBtn}" Content="…" Margin="0,0,8,0" Padding="14,5" Click="BrowseWorkDir_Click"/>
                    <TextBlock Grid.Column="3" x:Name="StatusBlock" Text="{Binding StatusText}" Foreground="#888894" VerticalAlignment="Center" Margin="0,0,16,0" TextTrimming="CharacterEllipsis" MaxWidth="280"/>
                    <Button Grid.Column="4" Style="{StaticResource AccentBtn}" Content="▶ Start" Padding="28,10" FontSize="14"
                            Command="{Binding StartCommand}"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
