{
  "enabledPlugins": {},
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ \"$CLAUDE_CODE_REMOTE\" = \"true\" ] && [ -f \"$CLAUDE_PROJECT_DIR/.claude/hooks/cloud-sitzung-hinweis.md\" ]; then cat \"$CLAUDE_PROJECT_DIR/.claude/hooks/cloud-sitzung-hinweis.md\"; fi; exit 0",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "if [ \"$(uname -s)\" = \"Darwin\" ] || [ \"$(uname -s)\" = \"Linux\" ]; then bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/openlauncher-deploy-guard.sh\"; else pwsh -NoProfile -File \"C:/Users/barwa/proggs/.claude/hooks/openlauncher-deploy-guard.ps1\"; fi",
            "timeout": 15,
            "statusMessage": "Prüfe OpenLauncher-Deploy-Weg …"
          }
        ]
      }
    ]
  }
}
