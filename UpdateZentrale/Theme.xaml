<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Farbwelt: tiefes Anthrazit mit violettem Akzent. Alles andere leitet sich hieraus ab. -->
    <Color x:Key="FarbeHintergrund">#0B0C10</Color>
    <Color x:Key="FarbeFlaeche">#14161E</Color>
    <Color x:Key="FarbeFlaecheHoch">#1B1E28</Color>
    <Color x:Key="FarbeRand">#262A36</Color>
    <Color x:Key="FarbeAkzent">#7C5CFF</Color>
    <Color x:Key="FarbeAkzentHell">#9D86FF</Color>
    <Color x:Key="FarbeText">#EEF0F6</Color>
    <Color x:Key="FarbeTextLeise">#9AA1B4</Color>

    <SolidColorBrush x:Key="PinselHintergrund" Color="{StaticResource FarbeHintergrund}" />
    <SolidColorBrush x:Key="PinselFlaeche" Color="{StaticResource FarbeFlaeche}" />
    <SolidColorBrush x:Key="PinselFlaecheHoch" Color="{StaticResource FarbeFlaecheHoch}" />
    <SolidColorBrush x:Key="PinselRand" Color="{StaticResource FarbeRand}" />
    <SolidColorBrush x:Key="PinselAkzent" Color="{StaticResource FarbeAkzent}" />
    <SolidColorBrush x:Key="PinselText" Color="{StaticResource FarbeText}" />
    <SolidColorBrush x:Key="PinselTextLeise" Color="{StaticResource FarbeTextLeise}" />

    <LinearGradientBrush x:Key="PinselAkzentVerlauf" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource FarbeAkzent}" Offset="0" />
        <GradientStop Color="#4DA3FF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PinselKarte" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#171A24" Offset="0" />
        <GradientStop Color="#12141C" Offset="1" />
    </LinearGradientBrush>

    <FontFamily x:Key="SchriftUi">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="SchriftMono">Cascadia Mono, Consolas</FontFamily>

    <!-- Typografie -->
    <Style x:Key="TitelGross" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SchriftUi}" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource PinselText}" />
    </Style>

    <Style x:Key="TitelKarte" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SchriftUi}" />
        <Setter Property="FontSize" Value="15.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource PinselText}" />
    </Style>

    <Style x:Key="TextLeise" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SchriftUi}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource PinselTextLeise}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SchriftUi}" />
        <Setter Property="Foreground" Value="{StaticResource PinselText}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <!-- Schaltflaechen: eine Basis, drei Auspraegungen -->
    <Style x:Key="SchalterBasis" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource SchriftUi}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource PinselText}" />
        <Setter Property="Padding" Value="16,9" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Huelle"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="9">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Huelle" Property="Opacity" Value="0.86" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Huelle" Property="Opacity" Value="0.7" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Huelle" Property="Opacity" Value="0.35" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SchalterHaupt" TargetType="Button" BasedOn="{StaticResource SchalterBasis}">
        <Setter Property="Background" Value="{StaticResource PinselAkzentVerlauf}" />
        <Setter Property="BorderBrush" Value="#6B4BF0" />
    </Style>

    <Style x:Key="SchalterZweit" TargetType="Button" BasedOn="{StaticResource SchalterBasis}">
        <Setter Property="Background" Value="{StaticResource PinselFlaecheHoch}" />
        <Setter Property="BorderBrush" Value="{StaticResource PinselRand}" />
    </Style>

    <Style x:Key="SchalterLeise" TargetType="Button" BasedOn="{StaticResource SchalterBasis}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource PinselRand}" />
        <Setter Property="Foreground" Value="{StaticResource PinselTextLeise}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Padding" Value="12,7" />
    </Style>

    <!-- Schiebeschalter fuer "Immer als Administrator" -->
    <Style x:Key="Schiebeschalter" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="23" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border x:Name="Bahn" CornerRadius="12"
                                Background="#2A2F3D" BorderBrush="#363C4C" BorderThickness="1" />
                        <Ellipse x:Name="Knopf" Width="17" Height="17" Fill="#B9C0D0"
                                 HorizontalAlignment="Left" Margin="3,0,0,0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bahn" Property="Background" Value="{StaticResource PinselAkzentVerlauf}" />
                            <Setter TargetName="Bahn" Property="BorderBrush" Value="#6B4BF0" />
                            <Setter TargetName="Knopf" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knopf" Property="Margin" Value="0,0,3,0" />
                            <Setter TargetName="Knopf" Property="Fill" Value="White" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bahn" Property="Opacity" Value="0.85" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Schlanke Bildlaufleiste, damit die Karten nicht von Windows-Grau gerahmt werden -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="9" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="#333949" CornerRadius="5" Margin="2,0" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" />
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" />
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Gruppenueberschrift in der Liste -->
    <Style x:Key="GruppenUeberschrift" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource PinselTextLeise}" />
        <Setter Property="Margin" Value="4,18,0,8" />
    </Style>

</ResourceDictionary>
