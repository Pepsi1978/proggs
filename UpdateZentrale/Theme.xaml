<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Nur Formen und Typografie. Alle Farben kommen per DynamicResource aus Themes/Dunkel.xaml
         bzw. Themes/Hell.xaml, damit die Umschaltung zur Laufzeit durchschlägt. -->

    <FontFamily x:Key="SchriftUi">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="SchriftMono">Cascadia Mono, Consolas</FontFamily>

    <Style x:Key="TitelGross" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SchriftUi}" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource PinselText}" />
    </Style>

    <Style x:Key="TitelKarte" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SchriftUi}" />
        <Setter Property="FontSize" Value="15.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource PinselText}" />
    </Style>

    <Style x:Key="TextLeise" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SchriftUi}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource PinselTextLeise}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SchriftUi}" />
        <Setter Property="Foreground" Value="{DynamicResource PinselText}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <!-- Schaltflächen: eine Basis, drei Ausprägungen -->
    <Style x:Key="SchalterBasis" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource SchriftUi}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource PinselText}" />
        <Setter Property="Padding" Value="16,9" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Huelle"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="9">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Huelle" Property="Opacity" Value="0.86" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Huelle" Property="Opacity" Value="0.7" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Huelle" Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SchalterHaupt" TargetType="Button" BasedOn="{StaticResource SchalterBasis}">
        <Setter Property="Background" Value="{DynamicResource PinselAkzentVerlauf}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PinselAkzentRand}" />
        <Setter Property="Foreground" Value="{DynamicResource PinselAufAkzent}" />
    </Style>

    <Style x:Key="SchalterZweit" TargetType="Button" BasedOn="{StaticResource SchalterBasis}">
        <Setter Property="Background" Value="{DynamicResource PinselFlaecheHoch}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PinselRand}" />
    </Style>

    <Style x:Key="SchalterLeise" TargetType="Button" BasedOn="{StaticResource SchalterBasis}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource PinselRand}" />
        <Setter Property="Foreground" Value="{DynamicResource PinselTextLeise}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Padding" Value="12,7" />
    </Style>

    <!-- Ruhige Ausprägung für „Aktuell": sichtbar, aber ohne Aufforderungscharakter -->
    <Style x:Key="SchalterRuhig" TargetType="Button" BasedOn="{StaticResource SchalterBasis}">
        <Setter Property="Background" Value="{DynamicResource PinselPlaketteFlaeche}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PinselPlaketteRand}" />
        <Setter Property="Foreground" Value="{DynamicResource PinselTextLeise}" />
    </Style>

    <!-- Schiebeschalter (Administratormodus, Hell/Dunkel) -->
    <Style x:Key="Schiebeschalter" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="23" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border x:Name="Bahn" CornerRadius="12"
                                Background="{DynamicResource PinselSchalterBahn}"
                                BorderBrush="{DynamicResource PinselSchalterRand}" BorderThickness="1" />
                        <Ellipse x:Name="Knopf" Width="17" Height="17"
                                 Fill="{DynamicResource PinselSchalterKnopf}"
                                 HorizontalAlignment="Left" Margin="3,0,0,0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bahn" Property="Background" Value="{DynamicResource PinselAkzentVerlauf}" />
                            <Setter TargetName="Bahn" Property="BorderBrush" Value="{DynamicResource PinselAkzentRand}" />
                            <Setter TargetName="Knopf" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knopf" Property="Margin" Value="0,0,3,0" />
                            <Setter TargetName="Knopf" Property="Fill" Value="White" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bahn" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bahn" Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Schlanke Bildlaufleiste, damit die Karten nicht von Windows-Grau gerahmt werden -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="9" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="{DynamicResource PinselRollbalken}"
                                                    CornerRadius="5" Margin="2,0" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" />
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" />
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Eingabezeile des eingebauten Terminals -->
    <Style x:Key="BefehlsZeile" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource SchriftMono}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource PinselKonsoleText}" />
        <Setter Property="CaretBrush" Value="{DynamicResource PinselKonsoleText}" />
        <Setter Property="Background" Value="{DynamicResource PinselKonsole}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PinselKonsoleRand}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="9,7" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GruppenUeberschrift" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource PinselTextLeise}" />
        <Setter Property="Margin" Value="4,18,0,8" />
    </Style>

</ResourceDictionary>
