<Window x:Class="UpdateZentrale.HauptFenster"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:UpdateZentrale.ViewModels"
        Title="UpdateZentrale"
        Height="880" Width="1320" MinHeight="620" MinWidth="1040"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PinselHintergrund}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <Window.DataContext>
        <vm:HauptViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Sanfter Lichtschein oben links: gibt der Flaeche Tiefe, ohne von den Karten abzulenken -->
        <Border Grid.RowSpan="3" IsHitTestVisible="False">
            <Border.Background>
                <RadialGradientBrush GradientOrigin="0.12,0" Center="0.12,0" RadiusX="0.85" RadiusY="0.7">
                    <GradientStop Color="#2A1E5C" Offset="0" />
                    <GradientStop Color="#00000000" Offset="1" />
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <!-- ================= Kopfzeile ================= -->
        <Grid Grid.Row="0" Margin="28,24,28,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Width="34" Height="34" CornerRadius="10"
                            Background="{StaticResource PinselAkzentVerlauf}" Margin="0,0,12,0">
                        <TextBlock Text="&#x2191;" FontSize="19" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="UpdateZentrale" Style="{StaticResource TitelGross}" VerticalAlignment="Center" />
                    <Border Margin="14,0,0,0" Padding="10,4" CornerRadius="8" VerticalAlignment="Center"
                            Background="#1E2230" BorderBrush="{StaticResource PinselRand}" BorderThickness="1">
                        <TextBlock Text="{Binding UpdateZusammenfassung}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource PinselTextLeise}" />
                    </Border>
                </StackPanel>
                <TextBlock Text="Alle Werkzeuge an einem Ort pruefen und aktualisieren."
                           Style="{StaticResource TextLeise}" Margin="46,4,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Katalog oeffnen" Style="{StaticResource SchalterLeise}"
                        Command="{Binding KatalogOeffnenCommand}" Margin="0,0,8,0"
                        ToolTip="programs.json oeffnen - dort werden neue Programme eingetragen." />
                <Button Content="Neu laden" Style="{StaticResource SchalterLeise}"
                        Command="{Binding KatalogNeuLadenCommand}" Margin="0,0,8,0"
                        ToolTip="Katalog neu einlesen, ohne die App neu zu starten." />
                <Button Content="Alle pruefen" Style="{StaticResource SchalterZweit}"
                        Command="{Binding AllePruefenCommand}" Margin="0,0,8,0"
                        IsEnabled="{Binding LaeuftSammelvorgang, Converter={StaticResource Nicht}}" />
                <Button Content="Alle Updates installieren" Style="{StaticResource SchalterHaupt}"
                        Command="{Binding AlleAktualisierenCommand}"
                        IsEnabled="{Binding LaeuftSammelvorgang, Converter={StaticResource Nicht}}" />
            </StackPanel>
        </Grid>

        <!-- Hinweisband, wenn der Katalog nicht gelesen werden konnte -->
        <Border Grid.Row="0" Margin="28,0,28,0" VerticalAlignment="Bottom" Padding="14,10" CornerRadius="9"
                Background="#3A1B22" BorderBrush="#7A2B38" BorderThickness="1"
                Visibility="{Binding KatalogFehler, Converter={StaticResource TextSichtbar}}">
            <TextBlock Text="{Binding KatalogFehler}" Foreground="#FFB4C0" FontSize="12.5" TextWrapping="Wrap" />
        </Border>

        <!-- ================= Hauptbereich ================= -->
        <Grid Grid.Row="1" Margin="28,14,28,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="400" />
            </Grid.ColumnDefinitions>

            <ListBox x:Name="ProgrammListe"
                     ItemsSource="{Binding Ansicht}"
                     SelectedItem="{Binding AusgewaehltesProgramm}"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     HorizontalContentAlignment="Stretch">

                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource GruppenUeberschrift}" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,10,10" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Rahmen" CornerRadius="14"
                                            Background="{StaticResource PinselKarte}"
                                            BorderBrush="{StaticResource PinselRand}" BorderThickness="1">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Rahmen" Property="BorderBrush" Value="#394054" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Rahmen" Property="BorderBrush" Value="#6B4BF0" />
                                            <Setter TargetName="Rahmen" Property="Background" Value="#191C28" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="16,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Kennzeichen mit Programmfarbe -->
                            <Border Grid.Column="0" Width="46" Height="46" CornerRadius="13"
                                    VerticalAlignment="Top" Margin="0,2,14,0"
                                    Background="{Binding Akzent, Converter={StaticResource HexPinsel}}">
                                <TextBlock Text="{Binding Kuerzel}" FontSize="16" FontWeight="Bold"
                                           Foreground="#0B0C10"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <!-- Name, Beschreibung, Merkmale -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource TitelKarte}" />

                                    <Border Margin="10,1,0,0" Padding="7,2" CornerRadius="6" VerticalAlignment="Center"
                                            Background="#1E2230" BorderBrush="{StaticResource PinselRand}" BorderThickness="1">
                                        <TextBlock Text="{Binding ArtText}" FontSize="10.5"
                                                   Foreground="{StaticResource PinselTextLeise}" />
                                    </Border>

                                    <Border Margin="6,1,0,0" Padding="7,2" CornerRadius="6" VerticalAlignment="Center"
                                            Background="#16281E" BorderBrush="#245437" BorderThickness="1"
                                            Visibility="{Binding Laeuft, Converter={StaticResource BoolSichtbar}}">
                                        <TextBlock Text="laeuft gerade" FontSize="10.5" Foreground="#5FE29B" />
                                    </Border>

                                    <Border Margin="6,1,0,0" Padding="7,2" CornerRadius="6" VerticalAlignment="Center"
                                            Background="#1B2436" BorderBrush="#2C3B57" BorderThickness="1"
                                            Visibility="{Binding ImAutostart, Converter={StaticResource BoolSichtbar}}">
                                        <TextBlock Text="Autostart" FontSize="10.5" Foreground="#89B4FF" />
                                    </Border>
                                </StackPanel>

                                <TextBlock Text="{Binding Beschreibung}" Style="{StaticResource TextLeise}"
                                           Margin="0,4,18,0" />

                                <TextBlock Text="{Binding Hinweis}" Style="{StaticResource TextLeise}"
                                           Foreground="#7E8699" FontStyle="Italic" Margin="0,4,18,0"
                                           Visibility="{Binding HatHinweis, Converter={StaticResource BoolSichtbar}}" />

                                <!-- Version und Zustand -->
                                <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                    <Border Padding="9,4" CornerRadius="7"
                                            Background="{Binding Zustand, Converter={StaticResource ZustandHintergrund}}">
                                        <TextBlock Text="{Binding Zustand, Converter={StaticResource ZustandText}}"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{Binding Zustand, Converter={StaticResource ZustandVordergrund}}" />
                                    </Border>

                                    <TextBlock Text="{Binding VersionsText}" FontFamily="{StaticResource SchriftMono}"
                                               FontSize="12" Foreground="{StaticResource PinselTextLeise}"
                                               VerticalAlignment="Center" Margin="10,0,0,0" />
                                </StackPanel>

                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource TextLeise}"
                                           Margin="0,6,18,0" Foreground="#8B93A7" />

                                <Border Margin="0,8,18,0" Padding="9,6" CornerRadius="7"
                                        Background="#3A2A16" BorderBrush="#6B4A1E" BorderThickness="1"
                                        Visibility="{Binding AdminWarnung, Converter={StaticResource BoolSichtbar}}">
                                    <TextBlock Text="Achtung: Dieses Programm steht im Autostart. Mit Administratorrechten startet Windows es dort nicht mehr automatisch."
                                               FontSize="11" Foreground="#FFCE8A" TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>

                            <!-- Bedienelemente -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Width="186">
                                <Button Content="Aktualisieren" Style="{StaticResource SchalterHaupt}"
                                        Command="{Binding AktualisierenCommand}"
                                        IsEnabled="{Binding KannAktualisieren}" />

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="Pruefen" Style="{StaticResource SchalterZweit}"
                                            Command="{Binding PruefenCommand}" IsEnabled="{Binding KannAktualisieren}" />
                                    <Button Grid.Column="2" Content="Starten" Style="{StaticResource SchalterLeise}"
                                            Command="{Binding StartenCommand}" IsEnabled="{Binding KannStarten}" />
                                </Grid>

                                <Border Margin="0,10,0,0" Padding="10,7" CornerRadius="9"
                                        Background="#161925" BorderBrush="{StaticResource PinselRand}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Als Administrator" FontSize="11.5" FontWeight="SemiBold" />
                                            <TextBlock Text="bei jedem Start" FontSize="10"
                                                       Foreground="{StaticResource PinselTextLeise}" />
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" Style="{StaticResource Schiebeschalter}"
                                                      VerticalAlignment="Center"
                                                      IsChecked="{Binding AlsAdministrator, Mode=TwoWay}"
                                                      IsEnabled="{Binding KannStarten}"
                                                      ToolTip="Setzt den Windows-Kompatibilitaetsschalter 'Programm als Administrator ausfuehren'." />
                                    </Grid>
                                </Border>

                                <ProgressBar Height="3" Margin="0,10,0,0" IsIndeterminate="True"
                                             Background="Transparent" BorderThickness="0" Foreground="#7C5CFF"
                                             Visibility="{Binding IstBeschaeftigt, Converter={StaticResource BoolSichtbar}}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <GridSplitter Grid.Column="1" Width="6" Background="Transparent" HorizontalAlignment="Center" />

            <!-- ================= Protokoll ================= -->
            <Border Grid.Column="2" CornerRadius="14" Background="#101219"
                    BorderBrush="{StaticResource PinselRand}" BorderThickness="1" Margin="0,0,0,0">
                <Grid Margin="16,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="Protokoll" Style="{StaticResource TitelKarte}" />
                        <TextBlock Text="{Binding AusgewaehltesProgramm.Name}" Style="{StaticResource TextLeise}"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <Border Grid.Row="1" Margin="0,12,0,10" Padding="11,9" CornerRadius="9"
                            Background="#161925" BorderBrush="{StaticResource PinselRand}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="{Binding AusgewaehltesProgramm.StatusText}" FontSize="12"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding AusgewaehltesProgramm.VersionsText}"
                                       FontFamily="{StaticResource SchriftMono}" FontSize="11.5"
                                       Foreground="{StaticResource PinselTextLeise}" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" CornerRadius="9" Background="#0A0B10"
                            BorderBrush="#1E2230" BorderThickness="1">
                        <ScrollViewer x:Name="ProtokollLeser" Margin="10,8" VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding AusgewaehltesProgramm.Protokoll}"
                                       FontFamily="{StaticResource SchriftMono}" FontSize="11.5"
                                       Foreground="#9FB4C9" TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= Fusszeile ================= -->
        <Border Grid.Row="2" Margin="28,14,28,18" Padding="16,10" CornerRadius="11"
                Background="#101219" BorderBrush="{StaticResource PinselRand}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding KopfStatus}" Style="{StaticResource TextLeise}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Zustaende auffrischen" Style="{StaticResource SchalterLeise}"
                            Command="{Binding ZustaendeAuffrischenCommand}" Margin="0,0,12,0" />
                    <TextBlock Text="{Binding AnwendungsVersion}" Style="{StaticResource TextLeise}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
