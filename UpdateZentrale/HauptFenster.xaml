<Window x:Class="UpdateZentrale.HauptFenster"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:UpdateZentrale.ViewModels"
        Title="UpdateZentrale"
        Height="880" Width="1340" MinHeight="620" MinWidth="1060"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PinselHintergrund}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <Window.DataContext>
        <vm:HauptViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Sanfter Lichtschein oben links: gibt der Fläche Tiefe, ohne von den Karten abzulenken -->
        <Border Grid.RowSpan="3" IsHitTestVisible="False" Background="{DynamicResource PinselSchein}" />

        <!-- ================= Kopfzeile ================= -->
        <Grid Grid.Row="0" Margin="28,24,28,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Width="34" Height="34" CornerRadius="10"
                            Background="{DynamicResource PinselAkzentVerlauf}" Margin="0,0,12,0">
                        <TextBlock Text="&#x2191;" FontSize="19" FontWeight="Bold"
                                   Foreground="{DynamicResource PinselAufAkzent}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="UpdateZentrale" Style="{StaticResource TitelGross}" VerticalAlignment="Center" />
                    <Border Margin="14,0,0,0" Padding="10,4" CornerRadius="8" VerticalAlignment="Center"
                            Background="{DynamicResource PinselPlaketteFlaeche}"
                            BorderBrush="{DynamicResource PinselPlaketteRand}" BorderThickness="1">
                        <TextBlock Text="{Binding UpdateZusammenfassung}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PinselTextLeise}" />
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="46,5,0,0">
                    <TextBlock Text="Alle Werkzeuge an einem Ort prüfen und aktualisieren."
                               Style="{StaticResource TextLeise}" VerticalAlignment="Center" />

                    <Border Margin="10,0,0,0" Padding="7,2" CornerRadius="6" VerticalAlignment="Center"
                            Background="{DynamicResource PinselLaeuftFlaeche}"
                            BorderBrush="{DynamicResource PinselLaeuftRand}" BorderThickness="1"
                            Visibility="{Binding IstErhoeht, Converter={StaticResource BoolSichtbar}}">
                        <TextBlock Text="Administrator" FontSize="10.5"
                                   Foreground="{DynamicResource PinselLaeuftText}" />
                    </Border>

                    <Button Content="Als Administrator neu starten" Style="{StaticResource SchalterLeise}"
                            FontSize="11" Padding="9,3" Margin="10,0,0,0"
                            Command="{Binding AlsAdminNeuStartenCommand}"
                            Visibility="{Binding NichtErhoeht, Converter={StaticResource BoolSichtbar}}"
                            ToolTip="Startet die UpdateZentrale erhöht neu, damit jede Installation durchläuft." />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">

                <!-- Hell/Dunkel -->
                <Border Padding="11,6" CornerRadius="9" Margin="0,0,10,0"
                        Background="{DynamicResource PinselFlaecheHoch}"
                        BorderBrush="{DynamicResource PinselRand}" BorderThickness="1"
                        Effect="{DynamicResource KartenSchatten}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x1F319;" FontSize="13" VerticalAlignment="Center" Margin="0,0,7,0"
                                   ToolTip="Dunkler Modus" />
                        <ToggleButton Style="{StaticResource Schiebeschalter}" VerticalAlignment="Center"
                                      IsChecked="{Binding HellModus, Mode=TwoWay}"
                                      ToolTip="Zwischen hellem und dunklem Modus umschalten" />
                        <TextBlock Text="&#x2600;" FontSize="13" VerticalAlignment="Center" Margin="7,0,0,0"
                                   ToolTip="Heller Modus" />
                    </StackPanel>
                </Border>

                <Button Content="Katalog öffnen" Style="{StaticResource SchalterLeise}"
                        Command="{Binding KatalogOeffnenCommand}" Margin="0,0,8,0"
                        ToolTip="programs.json öffnen – dort werden neue Programme eingetragen." />
                <Button Content="Neu laden" Style="{StaticResource SchalterLeise}"
                        Command="{Binding KatalogNeuLadenCommand}" Margin="0,0,8,0"
                        ToolTip="Katalog neu einlesen, ohne die App neu zu starten." />
                <Button Content="Alle prüfen" Style="{StaticResource SchalterZweit}"
                        Command="{Binding AllePruefenCommand}" Margin="0,0,8,0"
                        IsEnabled="{Binding LaeuftSammelvorgang, Converter={StaticResource Nicht}}" />
                <Button Content="Alle Updates installieren" Style="{StaticResource SchalterHaupt}"
                        Command="{Binding AlleAktualisierenCommand}"
                        IsEnabled="{Binding LaeuftSammelvorgang, Converter={StaticResource Nicht}}" />
            </StackPanel>
        </Grid>

        <!-- Hinweisband, wenn der Katalog nicht gelesen werden konnte -->
        <Border Grid.Row="0" Margin="28,0,28,0" VerticalAlignment="Bottom" Padding="14,10" CornerRadius="9"
                Background="{DynamicResource PinselFehlerFlaeche}"
                BorderBrush="{DynamicResource PinselFehlerRand}" BorderThickness="1"
                Effect="{DynamicResource KartenSchatten}"
                Visibility="{Binding KatalogFehler, Converter={StaticResource TextSichtbar}}">
            <TextBlock Text="{Binding KatalogFehler}" Foreground="{DynamicResource PinselFehlerText}"
                       FontSize="12.5" TextWrapping="Wrap" />
        </Border>

        <!-- ================= Hauptbereich ================= -->
        <Grid Grid.Row="1" Margin="28,14,28,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="400" />
            </Grid.ColumnDefinitions>

            <ListBox x:Name="ProgrammListe"
                     ItemsSource="{Binding Ansicht}"
                     SelectedItem="{Binding AusgewaehltesProgramm}"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     HorizontalContentAlignment="Stretch">

                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource GruppenUeberschrift}" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,10,10" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Rahmen" CornerRadius="14"
                                            Background="{DynamicResource PinselKarte}"
                                            BorderBrush="{DynamicResource PinselRand}" BorderThickness="1"
                                            Effect="{DynamicResource KartenSchatten}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Rahmen" Property="BorderBrush"
                                                    Value="{DynamicResource PinselRandHell}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Rahmen" Property="BorderBrush"
                                                    Value="{DynamicResource PinselAkzentRand}" />
                                            <Setter TargetName="Rahmen" Property="Background"
                                                    Value="{DynamicResource PinselKarteGewaehlt}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="16,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Kennzeichen in der Programmfarbe -->
                            <Border Grid.Column="0" Width="46" Height="46" CornerRadius="13"
                                    VerticalAlignment="Top" Margin="0,2,14,0"
                                    Background="{Binding Akzent, Converter={StaticResource HexPinsel}}">
                                <TextBlock Text="{Binding Kuerzel}" FontSize="16" FontWeight="Bold"
                                           Foreground="{DynamicResource PinselAufKennzeichen}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <!-- Name, Beschreibung, Merkmale -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource TitelKarte}" />

                                    <Border Margin="10,1,0,0" Padding="7,2" CornerRadius="6" VerticalAlignment="Center"
                                            Background="{DynamicResource PinselPlaketteFlaeche}"
                                            BorderBrush="{DynamicResource PinselPlaketteRand}" BorderThickness="1">
                                        <TextBlock Text="{Binding ArtText}" FontSize="10.5"
                                                   Foreground="{DynamicResource PinselTextLeise}" />
                                    </Border>

                                    <Border Margin="6,1,0,0" Padding="7,2" CornerRadius="6" VerticalAlignment="Center"
                                            Background="{DynamicResource PinselLaeuftFlaeche}"
                                            BorderBrush="{DynamicResource PinselLaeuftRand}" BorderThickness="1"
                                            Visibility="{Binding Laeuft, Converter={StaticResource BoolSichtbar}}">
                                        <TextBlock Text="läuft gerade" FontSize="10.5"
                                                   Foreground="{DynamicResource PinselLaeuftText}" />
                                    </Border>

                                    <Border Margin="6,1,0,0" Padding="7,2" CornerRadius="6" VerticalAlignment="Center"
                                            Background="{DynamicResource PinselAutostartFlaeche}"
                                            BorderBrush="{DynamicResource PinselAutostartRand}" BorderThickness="1"
                                            Visibility="{Binding ImAutostart, Converter={StaticResource BoolSichtbar}}">
                                        <TextBlock Text="Autostart" FontSize="10.5"
                                                   Foreground="{DynamicResource PinselAutostartText}" />
                                    </Border>
                                </StackPanel>

                                <TextBlock Text="{Binding Beschreibung}" Style="{StaticResource TextLeise}"
                                           Margin="0,4,18,0" />

                                <TextBlock Text="{Binding Hinweis}" Style="{StaticResource TextLeise}"
                                           Foreground="{DynamicResource PinselTextSehrLeise}" FontStyle="Italic"
                                           Margin="0,4,18,0"
                                           Visibility="{Binding HatHinweis, Converter={StaticResource BoolSichtbar}}" />

                                <!-- Version und Zustand -->
                                <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                    <Border Padding="9,4" CornerRadius="7"
                                            Background="{Binding Zustand, Converter={StaticResource ZustandHintergrund}}">
                                        <TextBlock Text="{Binding Zustand, Converter={StaticResource ZustandText}}"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{Binding Zustand, Converter={StaticResource ZustandVordergrund}}" />
                                    </Border>

                                    <TextBlock Text="{Binding VersionsText}" FontFamily="{StaticResource SchriftMono}"
                                               FontSize="12" Foreground="{DynamicResource PinselTextLeise}"
                                               VerticalAlignment="Center" Margin="10,0,0,0" />
                                </StackPanel>

                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource TextLeise}"
                                           Margin="0,6,18,0" />

                                <!-- Was beim letzten Lauf herauskam – überlebt das Schließen der App -->
                                <TextBlock Text="{Binding BerichtKurz}" Style="{StaticResource TextLeise}"
                                           FontSize="11" Margin="0,4,18,0"
                                           Foreground="{DynamicResource PinselTextSehrLeise}"
                                           Visibility="{Binding HatBericht, Converter={StaticResource BoolSichtbar}}" />

                                <!-- Update liegt bereit, das Programm hat es nur noch nicht übernommen -->
                                <Border Margin="0,8,18,0" Padding="9,6" CornerRadius="7"
                                        Background="{DynamicResource PinselAutostartFlaeche}"
                                        BorderBrush="{DynamicResource PinselAutostartRand}" BorderThickness="1"
                                        Visibility="{Binding UebernahmeOffen, Converter={StaticResource BoolSichtbar}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding UebernahmeText}" FontSize="11"
                                                   Foreground="{DynamicResource PinselAutostartText}"
                                                   TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                            <Button Content="Jetzt starten und übernehmen"
                                                    Style="{StaticResource SchalterLeise}" FontSize="11"
                                                    Padding="9,4" Margin="0,0,6,0"
                                                    Command="{Binding StartenCommand}" />
                                            <Button Content="Protokoll öffnen" Style="{StaticResource SchalterLeise}"
                                                    FontSize="11" Padding="9,4"
                                                    Command="{Binding ProtokollOeffnenCommand}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Update lief nicht durch oder blieb wirkungslos: Grund plus Protokoll -->
                                <Border Margin="0,8,18,0" Padding="9,6" CornerRadius="7"
                                        Background="{DynamicResource PinselFehlerFlaeche}"
                                        BorderBrush="{DynamicResource PinselFehlerRand}" BorderThickness="1"
                                        Visibility="{Binding BerichtIstFehler, Converter={StaticResource BoolSichtbar}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding BerichtGrund}" FontSize="11"
                                                   Foreground="{DynamicResource PinselFehlerText}"
                                                   TextWrapping="Wrap" />
                                        <Button Content="Protokoll öffnen" Style="{StaticResource SchalterLeise}"
                                                FontSize="11" Padding="9,4" Margin="0,7,0,0"
                                                HorizontalAlignment="Left"
                                                Command="{Binding ProtokollOeffnenCommand}" />
                                    </StackPanel>
                                </Border>

                                <Border Margin="0,8,18,0" Padding="9,6" CornerRadius="7"
                                        Background="{DynamicResource PinselWarnFlaeche}"
                                        BorderBrush="{DynamicResource PinselWarnRand}" BorderThickness="1"
                                        Visibility="{Binding AdminWarnung, Converter={StaticResource BoolSichtbar}}">
                                    <StackPanel>
                                        <TextBlock Text="Dieses Programm steht im Autostart. Den normalen Autostart überspringt Windows bei Programmen mit Administratorrechten – eine geplante Aufgabe startet es trotzdem, sogar ohne Rückfrage."
                                                   FontSize="11" Foreground="{DynamicResource PinselWarnText}"
                                                   TextWrapping="Wrap" />
                                        <Button Content="Autostart auf Administratorrechte umstellen"
                                                Style="{StaticResource SchalterLeise}" FontSize="11"
                                                Padding="9,4" Margin="0,7,0,0" HorizontalAlignment="Left"
                                                Command="{Binding AutostartUmstellenCommand}" />
                                    </StackPanel>
                                </Border>

                                <Border Margin="0,8,18,0" Padding="9,6" CornerRadius="7"
                                        Background="{DynamicResource PinselWarnFlaeche}"
                                        BorderBrush="{DynamicResource PinselWarnRand}" BorderThickness="1"
                                        Visibility="{Binding KonsolenAdminWarnung, Converter={StaticResource BoolSichtbar}}">
                                    <TextBlock Text="Dieses Kommandozeilen-Werkzeug wird von anderen Programmen im Hintergrund gestartet (Launcher, Terminal). Mit Administratorrechten bricht so ein Start mit Windows-Fehler 740 ab, weil ohne Fenster keine Rückfrage möglich ist."
                                               FontSize="11" Foreground="{DynamicResource PinselWarnText}"
                                               TextWrapping="Wrap" />
                                </Border>

                                <Border Margin="0,8,18,0" Padding="9,6" CornerRadius="7"
                                        Background="{DynamicResource PinselLaeuftFlaeche}"
                                        BorderBrush="{DynamicResource PinselLaeuftRand}" BorderThickness="1"
                                        Visibility="{Binding AutostartAlsAufgabe, Converter={StaticResource BoolSichtbar}}">
                                    <StackPanel>
                                        <TextBlock Text="Startet bei der Anmeldung als geplante Aufgabe mit Administratorrechten."
                                                   FontSize="11" Foreground="{DynamicResource PinselLaeuftText}"
                                                   TextWrapping="Wrap" />
                                        <Button Content="Wieder auf normalen Autostart zurückstellen"
                                                Style="{StaticResource SchalterLeise}" FontSize="11"
                                                Padding="9,4" Margin="0,7,0,0" HorizontalAlignment="Left"
                                                Command="{Binding AutostartUmstellenCommand}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Bedienelemente -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Width="188">

                                <!-- Nur bei echtem Update betont; sonst ruhig und mit Text „Aktuell" -->
                                <Button Content="{Binding AktionsText}"
                                        Command="{Binding AktualisierenCommand}"
                                        IsEnabled="{Binding AktionMoeglich}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SchalterRuhig}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AktionBetont}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource PinselAkzentVerlauf}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource PinselAkzentRand}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource PinselAufAkzent}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="Prüfen" Style="{StaticResource SchalterZweit}"
                                            Command="{Binding PruefenCommand}" IsEnabled="{Binding KannPruefen}" />
                                    <Button Grid.Column="2" Content="Starten" Style="{StaticResource SchalterLeise}"
                                            Command="{Binding StartenCommand}" IsEnabled="{Binding KannStarten}" />
                                </Grid>

                                <Border Margin="0,10,0,0" Padding="10,7" CornerRadius="9"
                                        Background="{DynamicResource PinselFlaecheHoch}"
                                        BorderBrush="{DynamicResource PinselRand}" BorderThickness="1"
                                        Visibility="{Binding AdminSchalterMoeglich, Converter={StaticResource BoolSichtbar}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Als Administrator" FontSize="11.5" FontWeight="SemiBold" />
                                            <TextBlock Text="bei jedem Start" FontSize="10"
                                                       Foreground="{DynamicResource PinselTextLeise}" />
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" Style="{StaticResource Schiebeschalter}"
                                                      VerticalAlignment="Center"
                                                      IsChecked="{Binding AlsAdministrator, Mode=TwoWay}"
                                                      ToolTip="Setzt den Windows-Kompatibilitätsschalter: Programm als Administrator ausführen." />
                                    </Grid>
                                </Border>

                                <!-- Paket-Apps: Windows lässt für sie keinen erhöhten Start zu -->
                                <Border Margin="0,10,0,0" Padding="10,7" CornerRadius="9"
                                        Background="{DynamicResource PinselFlaecheHoch}"
                                        BorderBrush="{DynamicResource PinselRand}" BorderThickness="1"
                                        Visibility="{Binding AdminNichtMoeglich, Converter={StaticResource BoolSichtbar}}">
                                    <StackPanel>
                                        <TextBlock Text="Kein Administratorstart" FontSize="11.5" FontWeight="SemiBold" />
                                        <TextBlock Text="Windows lässt Paket-Apps grundsätzlich nicht erhöht laufen. Das Update übernimmt die UpdateZentrale mit ihren eigenen Rechten."
                                                   FontSize="10" TextWrapping="Wrap" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource PinselTextLeise}" />
                                    </StackPanel>
                                </Border>

                                <ProgressBar Height="3" Margin="0,10,0,0" IsIndeterminate="True"
                                             Background="Transparent" BorderThickness="0"
                                             Foreground="{DynamicResource PinselAkzent}"
                                             Visibility="{Binding IstBeschaeftigt, Converter={StaticResource BoolSichtbar}}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <GridSplitter Grid.Column="1" Width="6" Background="Transparent" HorizontalAlignment="Center" />

            <!-- ================= Protokoll und Terminal ================= -->
            <Border Grid.Column="2" CornerRadius="14" Background="{DynamicResource PinselFlaecheTief}"
                    BorderBrush="{DynamicResource PinselRand}" BorderThickness="1"
                    Effect="{DynamicResource KartenSchatten}">
                <Grid Margin="16,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="2*" MinHeight="120" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="1.3*" MinHeight="120" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="Protokoll" Style="{StaticResource TitelKarte}" />
                        <TextBlock Text="{Binding AusgewaehltesProgramm.Name}" Style="{StaticResource TextLeise}"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <Border Grid.Row="1" Margin="0,12,0,10" Padding="11,9" CornerRadius="9"
                            Background="{DynamicResource PinselFlaecheHoch}"
                            BorderBrush="{DynamicResource PinselRand}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="{Binding AusgewaehltesProgramm.StatusText}" FontSize="12"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding AusgewaehltesProgramm.VersionsText}"
                                       FontFamily="{StaticResource SchriftMono}" FontSize="11.5"
                                       Foreground="{DynamicResource PinselTextLeise}" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" CornerRadius="9" Background="{DynamicResource PinselKonsole}"
                            BorderBrush="{DynamicResource PinselKonsoleRand}" BorderThickness="1">
                        <ScrollViewer Margin="10,8" VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding AusgewaehltesProgramm.Protokoll}"
                                       FontFamily="{StaticResource SchriftMono}" FontSize="11.5"
                                       Foreground="{DynamicResource PinselKonsoleText}" TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Border>

                    <!-- Eingebautes Terminal: läuft mit den Rechten der UpdateZentrale -->
                    <Grid Grid.Row="3" Margin="0,16,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding TerminalKopf}" Style="{StaticResource TitelKarte}"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Fenster" Style="{StaticResource SchalterLeise}" Padding="9,4"
                                    FontSize="11" Command="{Binding TerminalFensterOeffnenCommand}"
                                    Margin="0,0,6,0"
                                    ToolTip="Ein echtes Terminalfenster im Repo-Ordner öffnen" />
                            <Button Content="Leeren" Style="{StaticResource SchalterLeise}" Padding="9,4"
                                    FontSize="11" Command="{Binding TerminalLeerenCommand}" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="4" CornerRadius="9" Background="{DynamicResource PinselKonsole}"
                            BorderBrush="{DynamicResource PinselKonsoleRand}" BorderThickness="1">
                        <ScrollViewer x:Name="TerminalLeser" Margin="10,8" VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding TerminalAusgabe}"
                                       FontFamily="{StaticResource SchriftMono}" FontSize="11.5"
                                       Foreground="{DynamicResource PinselKonsoleText}" TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Border>

                    <Grid Grid.Row="5" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource BefehlsZeile}"
                                 Text="{Binding Befehl, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding TerminalLaeuft, Converter={StaticResource Nicht}}"
                                 ToolTip="PowerShell-Befehl eingeben und mit der Eingabetaste ausführen">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding BefehlAusfuehrenCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Grid.Column="1" Content="Ausführen" Style="{StaticResource SchalterZweit}"
                                Margin="8,0,0,0" Padding="13,7"
                                Command="{Binding BefehlAusfuehrenCommand}"
                                IsEnabled="{Binding TerminalLaeuft, Converter={StaticResource Nicht}}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= Fußzeile ================= -->
        <Border Grid.Row="2" Margin="28,14,28,18" Padding="16,10" CornerRadius="11"
                Background="{DynamicResource PinselFlaecheTief}"
                BorderBrush="{DynamicResource PinselRand}" BorderThickness="1"
                Effect="{DynamicResource KartenSchatten}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding KopfStatus}" Style="{StaticResource TextLeise}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="Immer als Administrator starten" Style="{StaticResource TextLeise}"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ToggleButton Style="{StaticResource Schiebeschalter}" VerticalAlignment="Center"
                                  Margin="0,0,16,0"
                                  IsChecked="{Binding ImmerAlsAdmin, Mode=TwoWay}"
                                  ToolTip="Windows startet die UpdateZentrale dann immer erhöht (Abfrage der Benutzerkontensteuerung)." />
                    <Button Content="Protokolle" Style="{StaticResource SchalterLeise}"
                            Command="{Binding ProtokolleOeffnenCommand}" Margin="0,0,8,0"
                            ToolTip="Ordner mit den Tagesprotokollen und der Update-Historie öffnen" />
                    <Button Content="Zustände auffrischen" Style="{StaticResource SchalterLeise}"
                            Command="{Binding ZustaendeAuffrischenCommand}" Margin="0,0,12,0" />
                    <TextBlock Text="{Binding AnwendungsVersion}" Style="{StaticResource TextLeise}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
