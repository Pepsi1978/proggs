<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dunkles Farbset. Jeder Schlüssel existiert in Hell.xaml unter demselben Namen; die App
         tauscht zur Laufzeit nur dieses eine Wörterbuch aus. Deshalb greifen alle Verwendungen
         per DynamicResource, nie per StaticResource. -->

    <SolidColorBrush x:Key="PinselHintergrund" Color="#0B0C10" />
    <SolidColorBrush x:Key="PinselFlaeche" Color="#14161E" />
    <SolidColorBrush x:Key="PinselFlaecheHoch" Color="#1B1E28" />
    <SolidColorBrush x:Key="PinselFlaecheTief" Color="#101219" />
    <SolidColorBrush x:Key="PinselRand" Color="#262A36" />
    <SolidColorBrush x:Key="PinselRandHell" Color="#394054" />
    <SolidColorBrush x:Key="PinselText" Color="#EEF0F6" />
    <SolidColorBrush x:Key="PinselTextLeise" Color="#9AA1B4" />
    <SolidColorBrush x:Key="PinselTextSehrLeise" Color="#7E8699" />

    <SolidColorBrush x:Key="PinselAkzent" Color="#7C5CFF" />
    <SolidColorBrush x:Key="PinselAkzentRand" Color="#6B4BF0" />
    <SolidColorBrush x:Key="PinselAufAkzent" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PinselAufKennzeichen" Color="#0B0C10" />

    <LinearGradientBrush x:Key="PinselAkzentVerlauf" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#7C5CFF" Offset="0" />
        <GradientStop Color="#4DA3FF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PinselKarte" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#171A24" Offset="0" />
        <GradientStop Color="#12141C" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="PinselKarteGewaehlt" Color="#191C28" />

    <RadialGradientBrush x:Key="PinselSchein" GradientOrigin="0.12,0" Center="0.12,0" RadiusX="0.85" RadiusY="0.7">
        <GradientStop Color="#2A1E5C" Offset="0" />
        <GradientStop Color="#00000000" Offset="1" />
    </RadialGradientBrush>

    <!-- Konsolenbereich -->
    <SolidColorBrush x:Key="PinselKonsole" Color="#0A0B10" />
    <SolidColorBrush x:Key="PinselKonsoleRand" Color="#1E2230" />
    <SolidColorBrush x:Key="PinselKonsoleText" Color="#9FB4C9" />

    <!-- Merkmal-Plaketten -->
    <SolidColorBrush x:Key="PinselPlaketteFlaeche" Color="#1E2230" />
    <SolidColorBrush x:Key="PinselPlaketteRand" Color="#262A36" />

    <SolidColorBrush x:Key="PinselLaeuftFlaeche" Color="#16281E" />
    <SolidColorBrush x:Key="PinselLaeuftRand" Color="#245437" />
    <SolidColorBrush x:Key="PinselLaeuftText" Color="#5FE29B" />

    <SolidColorBrush x:Key="PinselAutostartFlaeche" Color="#1B2436" />
    <SolidColorBrush x:Key="PinselAutostartRand" Color="#2C3B57" />
    <SolidColorBrush x:Key="PinselAutostartText" Color="#89B4FF" />

    <SolidColorBrush x:Key="PinselWarnFlaeche" Color="#3A2A16" />
    <SolidColorBrush x:Key="PinselWarnRand" Color="#6B4A1E" />
    <SolidColorBrush x:Key="PinselWarnText" Color="#FFCE8A" />

    <SolidColorBrush x:Key="PinselFehlerFlaeche" Color="#3A1B22" />
    <SolidColorBrush x:Key="PinselFehlerRand" Color="#7A2B38" />
    <SolidColorBrush x:Key="PinselFehlerText" Color="#FFB4C0" />

    <!-- Bedienelemente -->
    <SolidColorBrush x:Key="PinselSchalterBahn" Color="#2A2F3D" />
    <SolidColorBrush x:Key="PinselSchalterRand" Color="#363C4C" />
    <SolidColorBrush x:Key="PinselSchalterKnopf" Color="#B9C0D0" />
    <SolidColorBrush x:Key="PinselRollbalken" Color="#333949" />

</ResourceDictionary>
