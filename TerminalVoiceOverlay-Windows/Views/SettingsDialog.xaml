<Window x:Class="TerminalVoiceOverlay.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Einstellungen"
        Width="640" Height="720"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- Karte: abgesetzter Block pro Themenbereich -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="#FF262626"/>
            <Setter Property="BorderBrush" Value="#FF383838"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <!-- Karten-Ueberschrift -->
        <Style x:Key="CardHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFFFCF6B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <!-- Feld-Beschriftung -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFDDDDDD"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <!-- Erklaerungstext (klein, grau) -->
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF9A9A9A"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <!-- Dunkles Eingabefeld (dunkler als die Karte fuer Kontrast) -->
        <Style x:Key="DarkBox" TargetType="TextBox">
            <Setter Property="Background" Value="#FF1B1B1B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF454545"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>
        <Style x:Key="DarkCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFDDDDDD"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#FF333333"/>
            <Setter Property="Foreground" Value="#FFEEEEEE"/>
            <Setter Property="BorderBrush" Value="#FF505050"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Border CornerRadius="16"
            Background="#FF1A1A1A"
            BorderBrush="#FF3A3A3A"
            BorderThickness="1"
            Padding="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Einstellungen"
                       Foreground="#FFF5F5F5"
                       FontWeight="Bold"
                       FontSize="16"
                       Margin="2,0,0,14"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                <StackPanel>

                    <!-- Karte: API-Schluessel -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardHeader}" Text="API-Schlüssel"/>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Groq API Key (für Whisper-Transkription)"/>
                            <TextBox x:Name="GroqKeyBox" Style="{StaticResource DarkBox}" Margin="0,0,0,10"/>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Gemini API Key (optional, für Text-Korrektur)"/>
                            <TextBox x:Name="GeminiKeyBox" Style="{StaticResource DarkBox}"/>
                        </StackPanel>
                    </Border>

                    <!-- Karte: Transkriptions-Modell -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardHeader}" Text="Transkriptions-Modell"/>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Welches Modell wandelt deine Sprache in Text um?"/>
                            <ComboBox x:Name="TranscriptionEngineBox"
                                      Background="#FF1B1B1B" Foreground="Black"
                                      BorderBrush="#FF454545" BorderThickness="1"
                                      Padding="8,6" FontSize="13" Margin="0,0,0,8">
                                <ComboBoxItem Content="Groq Whisper — schnell, mit Stille-Schutz"/>
                                <ComboBoxItem Content="Gemini Transcribe — genauer, kostenlos (empfohlen)"/>
                                <ComboBoxItem Content="Gemini Transcribe Live — Streaming-Variante"/>
                            </ComboBox>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Gemini Transcribe ist der von Google für fertige Aufnahmen vorgesehene Weg: gemessen 4,4 s statt 15,1 s gegenüber der Live-Variante, Wortfehlerrate 2,6 % gegenüber 4,0 % (Groq: 4,6 %), und dein Wörterbuch geht direkt in die Erkennung. Die Live-Variante ist für Echtzeit-Streaming gebaut und hier nur zum Vergleich drin. Der Stille-Schutz gegen Whisper-Halluzinationen (&quot;Vielen Dank&quot;, &quot;Untertitel&quot;) greift nur bei Groq — er hängt an Whisper-Messwerten, die Gemini nicht liefert. Fällt Gemini aus (Kontingent erschöpft, Netz weg), springt automatisch Groq ein, damit kein Diktat verloren geht. Die Umschaltung wirkt sofort, ohne Neustart."/>
                        </StackPanel>
                    </Border>

                    <!-- Karte: Persoenliches Woerterbuch -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardHeader}" Text="Persönliches Wörterbuch"/>
                            <CheckBox x:Name="UseVocabularyCheck" Style="{StaticResource DarkCheck}"
                                      Content="Wörterbuch verwenden (bei der Erkennung UND der Gemini-Korrektur)" Margin="0,0,0,8"/>
                            <TextBox x:Name="VocabularyBox" Style="{StaticResource DarkBox}"
                                     AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     MinHeight="84" MaxHeight="150" Margin="0,0,0,6"/>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Wörter und Eigennamen, die du oft sprichst und die falsch transkribiert werden — eines pro Zeile oder per Komma getrennt (z.B. Backend, Subagent, Codex, Playwright). Beim Gemini-Transkriptions-Modell gehen die ersten 100 Einträge direkt als customVocabulary in die Erkennung, werden also schon beim Zuhören richtig geschrieben. Zusätzlich schreibt Gemini sie bei der Korrektur kontextabhängig korrekt; es ersetzt nicht stur. Gilt für alle Profile und wird auf diesem Rechner mit dem zweiten Overlay geteilt."/>
                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,14,0,4"
                                       Text="Einleitungstext an Gemini (steht vor der Wortliste — erklärt Gemini, was es mit dem Wörterbuch tun soll)"/>
                            <TextBox x:Name="PreambleBox" Style="{StaticResource DarkBox}"
                                     AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     MinHeight="70" MaxHeight="130"/>
                        </StackPanel>
                    </Border>

                    <!-- Karte: Gemini-Korrektur-Prompts -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardHeader}" Text="Gemini-Korrektur-Prompts"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                                       Text="Bearbeite die Vorlagen (Profil 1–10), die an Gemini geschickt werden — inklusive der Position deines gesprochenen Texts und des Wörterbuchs."/>
                            <Button x:Name="BtnEditPrompts" Style="{StaticResource SecondaryButton}"
                                    Content="Gemini-Prompts bearbeiten…" HorizontalAlignment="Left" Margin="0,0,0,14"/>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Trennzeichen zwischen Always-On-Prompts"/>
                            <TextBox x:Name="SeparatorBox" Style="{StaticResource DarkBox}"/>
                        </StackPanel>
                    </Border>

                    <!-- Karte: Overlay-Verhalten -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardHeader}" Text="Overlay-Verhalten"/>
                            <CheckBox x:Name="AutoHideCheck" Style="{StaticResource DarkCheck}"
                                      Content="Automatisch einklappen (nur Mic-Button, bei Maus-Hover ausklappen)" Margin="0,0,0,4"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12"
                                       Text="Aus = das Overlay bleibt immer voll sichtbar. Wirkt nach dem nächsten Overlay-Neustart."/>
                            <CheckBox x:Name="HorizontalCheck" Style="{StaticResource DarkCheck}"
                                      Content="Horizontal anzeigen (Leiste unten statt Streifen rechts)" Margin="0,0,0,4"/>
                            <TextBlock Style="{StaticResource Hint}"
                                        Text="Wirkt nach dem nächsten Overlay-Neustart. Schneller umschalten: der ⇄-Knopf direkt im Overlay neben dem Stern."/>
                        </StackPanel>
                    </Border>

                    <!-- Karte: Google Drive Backup -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardHeader}" Text="Google Drive Backup"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10"
                                       Text="Lege in console.cloud.google.com ein Desktop-OAuth-Client an und füge Client ID und Secret hier ein. Dann 'Verbinden' klicken, Google-Konto auswählen, fertig."/>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Google Client ID"/>
                            <TextBox x:Name="GoogleClientIdBox" Style="{StaticResource DarkBox}" Margin="0,0,0,10"/>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Google Client Secret"/>
                            <TextBox x:Name="GoogleClientSecretBox" Style="{StaticResource DarkBox}" Margin="0,0,0,12"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="Status:" Foreground="#FFCCCCCC" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock x:Name="GoogleStatus" Text="nicht verbunden" Foreground="#FFE53935" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnGoogleConnect" Content="Verbinden"
                                        Background="#FF16A34A" Foreground="White"
                                        BorderThickness="0" Padding="14,6" Cursor="Hand" Margin="0,0,8,0"/>
                                <Button x:Name="BtnGoogleDisconnect" Content="Trennen"
                                        Style="{StaticResource SecondaryButton}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button x:Name="BtnCancel" Content="Abbrechen"
                        Style="{StaticResource SecondaryButton}" Padding="14,7" Margin="0,0,8,0"/>
                <Button x:Name="BtnOk" Content="Speichern"
                        Background="#FFB8860B" Foreground="White"
                        BorderThickness="0" Padding="18,7" Cursor="Hand"
                        IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
