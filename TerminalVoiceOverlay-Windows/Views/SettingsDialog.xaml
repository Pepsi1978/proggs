<Window x:Class="TerminalVoiceOverlay.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Einstellungen"
        Width="620" Height="640"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ResizeMode="NoResize">
    <Border CornerRadius="16"
            Background="#FF1E1E1E"
            BorderBrush="#FF3A3A3A"
            BorderThickness="1"
            Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Einstellungen"
                       Foreground="#FFEEEEEE"
                       FontWeight="Bold"
                       FontSize="14"
                       Margin="0,0,0,12"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="API-Schluessel" Foreground="#FFFFD700" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"/>

                    <TextBlock Text="Groq API Key (fuer Whisper-Transkription)" Foreground="#FFCCCCCC" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox x:Name="GroqKeyBox"
                             Background="#FF2D2D2D" Foreground="White"
                             BorderBrush="#FF454545" BorderThickness="1"
                             Padding="8,6" FontSize="13" Margin="0,0,0,10"/>

                    <TextBlock Text="Gemini API Key (optional, fuer Text-Korrektur)" Foreground="#FFCCCCCC" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox x:Name="GeminiKeyBox"
                             Background="#FF2D2D2D" Foreground="White"
                             BorderBrush="#FF454545" BorderThickness="1"
                             Padding="8,6" FontSize="13" Margin="0,0,0,16"/>

                    <TextBlock Text="Separator-Template (zwischen Always-On Prompts)" Foreground="#FFCCCCCC" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox x:Name="SeparatorBox"
                             Background="#FF2D2D2D" Foreground="White"
                             BorderBrush="#FF454545" BorderThickness="1"
                             Padding="8,6" FontSize="13" Margin="0,0,0,16"/>

                    <TextBlock Text="Overlay-Verhalten" Foreground="#FFFFD700" FontWeight="SemiBold" FontSize="13" Margin="0,8,0,8"/>
                    <CheckBox x:Name="AutoHideCheck"
                              Content="Automatisch einklappen (nur Mic-Button anzeigen, bei Maus-Hover ausklappen)"
                              Foreground="#FFCCCCCC" FontSize="12"
                              Margin="0,0,0,4"/>
                    <TextBlock Foreground="#FF9A9A9A" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,16"
                               Text="Aus = das Overlay bleibt immer voll sichtbar (wie frueher). Aenderung wirkt nach dem naechsten Overlay-Neustart."/>

                    <CheckBox x:Name="HorizontalCheck"
                              Content="Horizontal anzeigen (Leiste unten statt Streifen rechts)"
                              Foreground="#FFCCCCCC" FontSize="12"
                              Margin="0,0,0,4"/>
                    <TextBlock Foreground="#FF9A9A9A" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,16"
                               Text="Wirkt nach dem naechsten Overlay-Neustart. Schneller umschalten: der ⇄-Knopf direkt im Overlay neben dem Stern."/>

                    <TextBlock Text="Google Drive Backup" Foreground="#FFFFD700" FontWeight="SemiBold" FontSize="13" Margin="0,8,0,8"/>
                    <TextBlock Foreground="#FF9A9A9A" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"
                               Text="Lege in console.cloud.google.com ein Desktop-OAuth-Client an und fuege die Client ID und Secret hier ein. Dann 'Verbinden' klicken, Google-Konto auswaehlen, fertig."/>

                    <TextBlock Text="Google Client ID" Foreground="#FFCCCCCC" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox x:Name="GoogleClientIdBox"
                             Background="#FF2D2D2D" Foreground="White"
                             BorderBrush="#FF454545" BorderThickness="1"
                             Padding="8,6" FontSize="13" Margin="0,0,0,10"/>

                    <TextBlock Text="Google Client Secret" Foreground="#FFCCCCCC" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox x:Name="GoogleClientSecretBox"
                             Background="#FF2D2D2D" Foreground="White"
                             BorderBrush="#FF454545" BorderThickness="1"
                             Padding="8,6" FontSize="13" Margin="0,0,0,10"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Status:" Foreground="#FFCCCCCC" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock x:Name="GoogleStatus" Text="nicht verbunden" Foreground="#FFE53935" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button x:Name="BtnGoogleConnect"
                                Content="Verbinden"
                                Background="#FF16A34A" Foreground="White"
                                BorderThickness="0" Padding="12,6" Cursor="Hand"
                                Margin="0,0,8,0"/>
                        <Button x:Name="BtnGoogleDisconnect"
                                Content="Trennen"
                                Background="#FF2D2D2D" Foreground="#FFCCCCCC"
                                BorderBrush="#FF454545" BorderThickness="1"
                                Padding="12,6" Cursor="Hand"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="BtnCancel"
                        Content="Abbrechen"
                        Background="#FF2D2D2D" Foreground="#FFCCCCCC"
                        BorderBrush="#FF454545" BorderThickness="1"
                        Padding="12,6" Margin="0,0,8,0" Cursor="Hand"/>
                <Button x:Name="BtnOk"
                        Content="Speichern"
                        Background="#FFB8860B" Foreground="White"
                        BorderThickness="0" Padding="16,6" Cursor="Hand"
                        IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
