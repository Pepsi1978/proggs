<Window x:Class="TerminalVoiceOverlay.Views.GeminiPromptEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gemini-Prompt bearbeiten"
        Width="720" Height="660"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ResizeMode="NoResize">
    <Border CornerRadius="16"
            Background="#FF1E1E1E"
            BorderBrush="#FF3A3A3A"
            BorderThickness="1"
            Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="HeaderText" Grid.Row="0"
                       Text="Gemini-Prompt bearbeiten"
                       Foreground="#FFEEEEEE"
                       FontWeight="Bold"
                       FontSize="14"
                       Margin="0,0,0,8"/>

            <TextBlock Grid.Row="1" Foreground="#FF9A9A9A" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"
                       Text="Das ist die Vorlage, die an Gemini geschickt wird. Setze den Platzhalter für deinen gesprochenen Text an die Stelle, wo er eingefügt werden soll, und den Wörterbuch-Platzhalter dorthin, wo das Wörterbuch stehen soll. Fehlt der Text-Platzhalter, wird dein Text hinten angehängt; fehlt der Wörterbuch-Platzhalter, kommt das Wörterbuch (wenn eingeschaltet) an den Anfang."/>

            <TextBox x:Name="PromptBox" Grid.Row="2"
                     Background="#FF2D2D2D" Foreground="White"
                     BorderBrush="#FF454545" BorderThickness="1"
                     Padding="8,6" FontSize="13" FontFamily="Consolas"
                     AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>

            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                <Button x:Name="BtnInsertText"
                        Content="Platzhalter für gesprochenen Text einfügen"
                        Background="#FF2D2D2D" Foreground="#FFCCCCCC"
                        BorderBrush="#FF454545" BorderThickness="1"
                        Padding="10,6" Margin="0,0,8,0" Cursor="Hand"/>
                <Button x:Name="BtnInsertVocab"
                        Content="Wörterbuch-Platzhalter einfügen"
                        Background="#FF2D2D2D" Foreground="#FFCCCCCC"
                        BorderBrush="#FF454545" BorderThickness="1"
                        Padding="10,6" Cursor="Hand"/>
            </StackPanel>

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="BtnCancel"
                        Content="Abbrechen"
                        Background="#FF2D2D2D" Foreground="#FFCCCCCC"
                        BorderBrush="#FF454545" BorderThickness="1"
                        Padding="12,6" Margin="0,0,8,0" Cursor="Hand"/>
                <Button x:Name="BtnSave"
                        Content="Speichern"
                        Background="#FFB8860B" Foreground="White"
                        BorderThickness="0" Padding="16,6" Cursor="Hand"
                        IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
