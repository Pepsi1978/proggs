<Window x:Class="TerminalVoiceOverlay.Views.PromptInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PromptInput"
        Width="1140" Height="490"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- Stern-Button-Style: 1:1 identisch zum IconButton im PromptBoard.
             Gleiche 26x26-Basis, gleiche Border (#6A6A6A), gleiche Segoe-
             Fluent-Icons-Schriftart, damit der Stern hier exakt so aussieht
             wie sein Pendant in der Toolbar des Promtboards. -->
        <Style x:Key="BoardIconButton" TargetType="Button">
            <Setter Property="Background" Value="#FF383838"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="13" BorderBrush="#FF6A6A6A" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#FF525252"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toolbar-Button im Stil der CircleButtons aus dem Voice-Overlay,
             aber kompakter (28x28) damit die Leiste nicht zu hoch wird. -->
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="#FF2D2D2D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="14"
                                Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#FF3D3D3D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Halbtransparenter Container, gleiche Optik wie PromptBoardPanel,
         damit der Terminal-Text durchschimmert (Alpha C7 = 78%). -->
    <Border CornerRadius="16"
            Background="#C71E1E1E"
            BorderBrush="#FF3A3A3A"
            BorderThickness="1">
        <Grid Margin="10,10,10,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Kopfzeile: Titel + Hint + Buttonleiste rechts.
                 Spalte 2 ist eine StackPanel, damit weitere Buttons spaeter
                 einfach links neben das X eingefuegt werden koennen. -->
            <Grid Grid.Row="0" Margin="4,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="Prompt-Eingabe"
                           Foreground="#FFCCCCCC"
                           FontWeight="Bold"
                           FontSize="13"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           x:Name="HintLabel"
                           Text="Enter sendet · Shift+Enter neue Zeile · Rechtsklick zum Verschieben"
                           Foreground="#FF7F7F7F"
                           FontSize="10"
                           Margin="10,0,10,0"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>

                <!-- Buttonleiste rechts oben.
                     Reihenfolge: Stern (Solo-Andocken ans Voice-Overlay) |
                                  ; (Aufgaben-Trenner manuell einfuegen) |
                                  G (Gemini-Verbesserung) |
                                  rotes X (Eingabe leeren).
                     Der Stern blendet das Promptboard aus und dockt dieses
                     Eingabefenster direkt an die schmale Voice-Overlay-Leiste
                     an. Erneuter Klick holt das Promptboard zurueck und
                     dieses Fenster rutscht wieder an dessen linken Rand.
                     Visuell 1:1 wie der Stern in der Promptboard-Toolbar:
                     Segoe Fluent Icons E734 (Outline, weiss) im Ruhezustand,
                     E735 (Fill, gold #FFD700) wenn Solo-Andocken aktiv. -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="SoloDockStarButton"
                            Style="{StaticResource BoardIconButton}"
                            Click="BtnSoloDockStar_Click"
                            Margin="0,0,4,0"
                            Content="&#xE734;"
                            ToolTip="Promptboard ausblenden und Eingabe direkt ans Voice-Overlay andocken (erneuter Klick blendet das Promptboard wieder ein)."/>
                    <Button x:Name="SeparatorButton"
                            Style="{StaticResource ToolbarButton}"
                            Click="BtnInsertSeparator_Click"
                            Margin="0,0,4,0"
                            ToolTip="Aufgaben-Trenner einfuegen — haengt eine Leerzeile, ein Semikolon und noch eine Leerzeile ans Ende des Textes an.">
                        <TextBlock Text=";"
                                   FontWeight="Bold"
                                   FontSize="16"
                                   Foreground="#FF7FD0FF"/>
                    </Button>
                    <Button x:Name="GeminiButton"
                            Style="{StaticResource ToolbarButton}"
                            Click="BtnGemini_Click"
                            Margin="0,0,4,0"
                            ToolTip="Mit Gemini verbessern — der aktuelle Eingabe-Text wird durch eine bereinigte Variante ersetzt.">
                        <TextBlock Text="G"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   Foreground="#FFFFD700"/>
                    </Button>
                    <Button x:Name="ClearInputButton"
                            Style="{StaticResource ToolbarButton}"
                            Click="BtnClearInput_Click"
                            ToolTip="Eingabe-Text loeschen">
                        <TextBlock Text="X"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   Foreground="#FFFF4444"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Eingabefeld: mehrzeilig, scrollbar. KEIN eigener Hintergrund —
                 die aeussere Border (#C71E1E1E, 78% opak) scheint durch, so
                 dass der Eingabebereich exakt so transparent wirkt wie das
                 Promtboard und die Historie. -->
            <Border Grid.Row="1"
                    CornerRadius="8"
                    Background="Transparent"
                    BorderBrush="#FF3A3A3A"
                    BorderThickness="1">
                <TextBox x:Name="InputBox"
                         AcceptsReturn="True"
                         AcceptsTab="False"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Background="Transparent"
                         Foreground="White"
                         CaretBrush="#FFFFD700"
                         BorderThickness="0"
                         FontSize="26"
                         Padding="10,8"
                         FontFamily="Segoe UI"/>
            </Border>

            <!-- Statuszeile unten: Pre/Post-Vorschau -->
            <TextBlock Grid.Row="2"
                       x:Name="PreviewLabel"
                       Text=""
                       Foreground="#FF8C8C8C"
                       FontSize="10"
                       Margin="4,8,0,0"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis"/>
        </Grid>
    </Border>
</Window>
