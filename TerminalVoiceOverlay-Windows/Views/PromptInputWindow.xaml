<Window x:Class="TerminalVoiceOverlay.Views.PromptInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PromptInput"
        Width="1140" Height="490"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize">

    <!-- Halbtransparenter Container, gleiche Optik wie PromptBoardPanel,
         damit der Terminal-Text durchschimmert (Alpha C7 = 78%). -->
    <Border CornerRadius="16"
            Background="#C71E1E1E"
            BorderBrush="#FF3A3A3A"
            BorderThickness="1">
        <Grid Margin="10,10,10,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Kopfzeile: Titel + Hint -->
            <Grid Grid.Row="0" Margin="4,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="Prompt-Eingabe"
                           Foreground="#FFCCCCCC"
                           FontWeight="Bold"
                           FontSize="13"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           x:Name="HintLabel"
                           Text="Enter sendet · Shift+Enter neue Zeile · Rechtsklick zum Verschieben"
                           Foreground="#FF7F7F7F"
                           FontSize="10"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </Grid>

            <!-- Eingabefeld: mehrzeilig, scrollbar. KEIN eigener Hintergrund —
                 die aeussere Border (#C71E1E1E, 78% opak) scheint durch, so
                 dass der Eingabebereich exakt so transparent wirkt wie das
                 Promtboard und die Historie. -->
            <Border Grid.Row="1"
                    CornerRadius="8"
                    Background="Transparent"
                    BorderBrush="#FF3A3A3A"
                    BorderThickness="1">
                <TextBox x:Name="InputBox"
                         AcceptsReturn="True"
                         AcceptsTab="False"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Background="Transparent"
                         Foreground="White"
                         CaretBrush="#FFFFD700"
                         BorderThickness="0"
                         FontSize="26"
                         Padding="10,8"
                         FontFamily="Segoe UI"/>
            </Border>

            <!-- Statuszeile unten: Pre/Post-Vorschau -->
            <TextBlock Grid.Row="2"
                       x:Name="PreviewLabel"
                       Text=""
                       Foreground="#FF8C8C8C"
                       FontSize="10"
                       Margin="4,8,0,0"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis"/>
        </Grid>
    </Border>
</Window>
