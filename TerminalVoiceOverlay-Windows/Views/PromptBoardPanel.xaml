<Window x:Class="TerminalVoiceOverlay.Views.PromptBoardPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PromptBoard"
        Width="532" Height="490"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="CategoryTab" TargetType="Button">
            <Setter Property="Background" Value="#FF2D2D2D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#FF454545"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CategoryTabActive" TargetType="Button" BasedOn="{StaticResource CategoryTab}">
            <Setter Property="Background" Value="#FFB8860B"/>
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="#FF383838"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <!-- Einheitliche Icon-Schriftart fuer alle Toolbar-Buttons.
                 Segoe Fluent Icons (Win11) bzw. Segoe MDL2 Assets (Win10)
                 haben pro Glyph dieselben vertikalen Metriken — damit
                 sitzt jedes Symbol exakt mittig in seiner runden Basis.
                 Vorher mischten wir ASCII (+), Symbole (★ ⚙) und Emojis
                 (💾 📜) mit drei verschiedenen Glyph-Hoehen, was nie sauber
                 zentriert war. -->
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="13" BorderBrush="#FF6A6A6A" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#FF525252"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RowIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style x:Key="PromptRow" TargetType="Border">
            <Setter Property="Background" Value="#FF252525"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Style.Triggers>
                <!-- Hover feedback: the row lightens slightly under the mouse.
                     Previously there was no visual cue even though the whole row
                     is clickable (toggles Always-On). -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF363636"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PromptButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AddButton" TargetType="Button">
            <Setter Property="Background" Value="#FF3D3D3D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="8" BorderBrush="#FF727272" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#FF4F4F4F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Slightly translucent (alpha C7 ≈ 78%) so the underlying terminal
         text shows through, matching the macOS counterpart's alpha 0.78. -->
    <Border CornerRadius="16"
            Background="#C71E1E1E"
            BorderBrush="#FF3A3A3A"
            BorderThickness="1">
        <Grid Margin="10,10,10,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="4,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="PromptBoard"
                           Foreground="#FFCCCCCC"
                           FontWeight="Bold"
                           FontSize="13"
                           VerticalAlignment="Center"/>
                <!-- Sync-Bereich: Status-Text + Filter-Button "Nur aktivierte
                     Prompts" daneben. Der Button wirkt als Schnell-Filter:
                     Klick blendet alle Prompts ohne Haekchen kurzfristig aus,
                     so dass der Benutzer nach viel Hin-und-Her sofort sehen
                     kann welche Prompts aktuell wirklich aktiv sind. Im
                     aktiven Zustand wird der Button golden — passend zum
                     gelb-goldenen Haekchen der AlwaysOn-Checkboxen in den
                     Prompt-Reihen. Erneuter Klick (oder Klick auf einen
                     Tab) verlaesst den Filter wieder. -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Margin="6,0,0,0"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="SyncLabel"
                               Text=""
                               Foreground="#FF7F7F7F"
                               FontSize="10"
                               VerticalAlignment="Center"/>
                    <Button x:Name="BtnFilterActiveOnly"
                            Style="{StaticResource IconButton}"
                            Content="&#xE73E;"
                            Margin="6,0,0,0"
                            ToolTip="Nur aktivierte Prompts anzeigen — blendet alle Prompts ohne Haekchen aus. Erneuter Klick zeigt wieder alle."/>
                    <!-- Stern direkt neben dem Filter-Button. Foreground auf
                         Gold #FFD700 fix gesetzt — der Stern bleibt auf Wunsch
                         des Benutzers IMMER goldig, unabhaengig vom Solo-Modus.
                         Symmetrisches Pendant zum Stern in der Eingabe-Toolbar
                         (der dort auch dauerhaft gold ist). Klick blendet das
                         Promtboard aus und dockt das Eingabefeld ans Voice-
                         Overlay an. Glyph E735 = FavoriteStarFill (gefuelltes
                         Pendant zur E734-Outline). -->
                    <Button x:Name="BtnBoardStar"
                            Style="{StaticResource IconButton}"
                            Content="&#xE735;"
                            Foreground="#FFFFD700"
                            Click="BtnBoardStar_Click"
                            ToolTip="Promptboard schliessen und Eingabefeld direkt am Voice-Overlay andocken (Stern im Eingabefeld holt das Promtboard wieder zurueck)."/>
                </StackPanel>
                <!-- Reihenfolge der rechten Action-Buttons: [!] [Historie] [+]
                     [Backup] [Settings]. Spalte 2 (Width=*) ist eine
                     leere Lueckenspalte, die alle Toolbar-Buttons nach rechts
                     druckt. Der Stern (BtnBoardStar) sitzt jetzt links neben
                     dem Filter-Button im SyncBlock und nicht hier in der
                     rechten Action-Gruppe — Frank-Wunsch 2026-05-09.
                     Glyphen aus Segoe Fluent Icons / MDL2 Assets damit alle
                     Symbole dieselben vertikalen Metriken haben und mittig
                     in den runden Basen sitzen. -->
                <Button Grid.Column="3"
                        x:Name="BtnClearAllChecks"
                        Style="{StaticResource IconButton}"
                        Content="!"
                        FontFamily="Segoe UI"
                        ToolTip="Alle Häkchen entfernen (Always-On in allen Kategorien)"/>
                <Button Grid.Column="4"
                        x:Name="BtnHistory"
                        Style="{StaticResource IconButton}"
                        Content="&#xE81C;"
                        ToolTip="Prompt-Historie"/>
                <Button Grid.Column="5"
                        x:Name="BtnAddCategory"
                        Style="{StaticResource IconButton}"
                        Content="&#xE710;"
                        ToolTip="Neue Kategorie"/>
                <Button Grid.Column="6"
                        x:Name="BtnBackup"
                        Style="{StaticResource IconButton}"
                        Content="&#xE74E;"
                        ToolTip="Backup / Wiederherstellen"/>
                <Button Grid.Column="7"
                        x:Name="BtnSettings"
                        Style="{StaticResource IconButton}"
                        Content="&#xE713;"
                        ToolTip="Einstellungen"/>
            </Grid>

            <WrapPanel Grid.Row="1"
                       x:Name="CategoryTabs"
                       Orientation="Horizontal"
                       Margin="0,0,0,8"/>

            <ScrollViewer Grid.Row="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="PromptList" Orientation="Vertical"/>
            </ScrollViewer>

            <Button Grid.Row="3"
                    x:Name="BtnAddPrompt"
                    Style="{StaticResource AddButton}"
                    Content="+ Neuer Prompt"/>
        </Grid>
    </Border>
</Window>
