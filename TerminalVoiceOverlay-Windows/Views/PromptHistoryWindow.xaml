<Window x:Class="TerminalVoiceOverlay.Views.PromptHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PromptHistory"
        Width="760" Height="490"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize">

    <!-- Gleiche Optik wie PromptBoard und PromptInputWindow:
         halbtransparent, abgerundete Ecken, dunkler Rahmen. -->
    <Border CornerRadius="16"
            Background="#C71E1E1E"
            BorderBrush="#FF3A3A3A"
            BorderThickness="1">
        <Grid Margin="10,10,10,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Kopfzeile -->
            <Grid Grid.Row="0" Margin="4,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="Prompt-Historie"
                           Foreground="#FFCCCCCC"
                           FontWeight="Bold"
                           FontSize="13"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           x:Name="HintLabel"
                           Text="Klick = in Eingabe einfuegen · Rechtsklick = Fenster verschieben"
                           Foreground="#FF7F7F7F"
                           FontSize="10"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="2"
                           x:Name="CountLabel"
                           Text=""
                           Foreground="#FF7F7F7F"
                           FontSize="10"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- Liste der Historie-Eintraege. KEIN eigener Hintergrund —
                 die aeussere Border (#C71E1E1E, 78% opak) scheint durch und
                 die Historie wirkt damit genauso transparent wie Promtboard
                 und Eingabefenster. -->
            <Border Grid.Row="1"
                    CornerRadius="8"
                    Background="Transparent"
                    BorderBrush="#FF3A3A3A"
                    BorderThickness="1">
                <ScrollViewer x:Name="HistoryScroll"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="0">
                    <StackPanel x:Name="HistoryList"
                                Orientation="Vertical"
                                Margin="6,6"/>
                </ScrollViewer>
            </Border>

            <!-- Statuszeile: leer wenn alles laeuft -->
            <TextBlock Grid.Row="2"
                       x:Name="StatusLabel"
                       Text=""
                       Foreground="#FF8C8C8C"
                       FontSize="10"
                       Margin="4,8,0,0"/>
        </Grid>
    </Border>
</Window>
