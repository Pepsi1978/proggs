{
	"cleanupPeriodDays": 99999,
	"env": {
		"CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
		"DISABLE_COST_WARNINGS": "1",
		"CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
		"CLAUDE_CODE_MAX_OUTPUT_TOKENS": "64000",
		"CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "100",
		"CLAUDE_CODE_SUBAGENT_MODEL": "opus[1m]",
		"CLAUDE_CODE_SESSIONEND_HOOKS_TIMEOUT_MS": "30000",
		"ENABLE_TOOL_SEARCH": "1",
		"ENABLE_SECURITY_REMINDER": "0",
		"ECC_HOOK_PROFILE": "minimal",
		"CLAUDE_CODE_NO_FLICKER": "1"
	},
	"permissions": {
		"defaultMode": "bypassPermissions"
	},
	"enableAllProjectMcpServers": true,
	"worktree": {
		"symlinkDirectories": [
			"node_modules",
			".cache",
			".gradle",
			"build"
		]
	},
	"enabledPlugins": {
		"swift-lsp@claude-plugins-official": true,
		"typescript-lsp@claude-plugins-official": true,
		"csharp-lsp@claude-plugins-official": true,
		"superpowers@claude-plugins-official": true,
		"frontend-design@claude-plugins-official": true,
		"context7@claude-plugins-official": true,
		"github@claude-plugins-official": false,
		"feature-dev@claude-plugins-official": false,
		"code-simplifier@claude-plugins-official": true,
		"commit-commands@claude-plugins-official": true,
		"security-guidance@claude-plugins-official": true,
		"claude-md-management@claude-plugins-official": true,
		"pr-review-toolkit@claude-plugins-official": true,
		"claude-code-setup@claude-plugins-official": true,
		"hookify@claude-plugins-official": true,
		"playground@claude-plugins-official": true,
		"ralph-loop@claude-plugins-official": true,
		"episodic-memory@superpowers-marketplace": false,
		"superpowers-chrome@superpowers-marketplace": false,
		"code-review@claude-plugins-official": true,
		"playwright@claude-plugins-official": true,
		"coderabbit@claude-plugins-official": true,
		"explanatory-output-style@claude-plugins-official": true,
		"superpowers-lab@superpowers-marketplace": false,
		"skill-creator@claude-plugins-official": true,
		"plugin-dev@claude-plugins-official": false,
		"agent-sdk-dev@claude-plugins-official": true,
		"clangd-lsp@claude-plugins-official": true,
		"rust-analyzer-lsp@claude-plugins-official": true,
		"gopls-lsp@claude-plugins-official": true,
		"kotlin-lsp@claude-plugins-official": true,
		"jdtls-lsp@claude-plugins-official": true,
		"lua-lsp@claude-plugins-official": true,
		"php-lsp@claude-plugins-official": true,
		"pyright-lsp@claude-plugins-official": true,
		"ruby-lsp@claude-plugins-official": true,
		"ask-questions-if-underspecified@trailofbits": true,
		"firebase-apk-scanner@trailofbits": true,
		"gh-cli@trailofbits": true,
		"static-analysis@trailofbits": false,
		"second-opinion@trailofbits": true,
		"git-cleanup@trailofbits": true,
		"workflow-skill-design@trailofbits": true,
		"agentic-actions-auditor@trailofbits": true,
		"skill-improver@trailofbits": true,
		"claude-mem@thedotmack": true,
		"everything-claude-code@everything-claude-code": true,
		"compound-engineering@compound-engineering-plugin": false,
		"reflexion@context-engineering-kit": true,
		"git@context-engineering-kit": true,
		"tdd@context-engineering-kit": true,
		"sadd@context-engineering-kit": true,
		"ddd@context-engineering-kit": true,
		"sdd@context-engineering-kit": true,
		"kaizen@context-engineering-kit": true,
		"customaize-agent@context-engineering-kit": true,
		"docs@context-engineering-kit": true,
		"tech-stack@context-engineering-kit": true,
		"mcp@context-engineering-kit": true,
		"fpf@context-engineering-kit": true,
		"xclaude-plugin@xclaude-plugin-marketplace": true,
		"apple-platform-build-tools@apple-platform-build-tools": true,
		"claude-reflect@claude-reflect-marketplace": true,
		"spec-driven-development@context-engineering-kit": true,
		"claude-code-lsps@boostvolt": false,
		"context-kit@FlineDev": false
	},
	"extraKnownMarketplaces": {
		"superpowers-marketplace": {
			"source": {
				"source": "github",
				"repo": "obra/superpowers-marketplace"
			},
			"autoUpdate": true
		},
		"trailofbits": {
			"source": {
				"source": "github",
				"repo": "trailofbits/skills"
			}
		},
		"thedotmack": {
			"source": {
				"source": "github",
				"repo": "thedotmack/claude-mem"
			}
		},
		"everything-claude-code": {
			"source": {
				"source": "github",
				"repo": "affaan-m/everything-claude-code"
			}
		},
		"compound-engineering-plugin": {
			"source": {
				"source": "github",
				"repo": "EveryInc/compound-engineering-plugin"
			}
		},
		"context-engineering-kit": {
			"source": {
				"source": "github",
				"repo": "NeoLabHQ/context-engineering-kit"
			}
		},
		"xclaude-plugin-marketplace": {
			"source": {
				"source": "github",
				"repo": "conorluddy/xclaude-plugin"
			}
		},
		"apple-platform-build-tools": {
			"source": {
				"source": "github",
				"repo": "kylehughes/apple-platform-build-tools-claude-code-plugin"
			}
		},
		"claude-reflect-marketplace": {
			"source": {
				"source": "github",
				"repo": "BayramAnnakov/claude-reflect"
			}
		},
		"trailofbits/skills-curated": {
			"source": {
				"source": "github",
				"repo": "trailofbits/skills-curated"
			}
		}
	},
	"model": "opus[1m]",
	"language": "de",
	"alwaysThinkingEnabled": true,
	"effortLevel": "high",
	"autoUpdatesChannel": "latest",
	"skipDangerousModePermissionPrompt": true,
	"_comment_PermissionRequest": "Intentionally removed — caused bypassPermissions mode reset (2026-03-20)",
	"mcpServers": {
		"android-adb": {
			"type": "stdio",
			"command": "/opt/homebrew/bin/npx",
			"args": [
				"-y",
				"android-debug-bridge-mcp"
			]
		}
	}
}
