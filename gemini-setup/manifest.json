	"settings": {
		"effortLevel": "high",
		"env": {
			"GEMINI_CLI_EXPERIMENTAL_AGENT_TEAMS": "1",
			"GEMINI_CLI_SUBAGENT_MODEL": "gemini-2.0-flash-exp",
			"GEMINI_AUTOCOMPACT_PCT_OVERRIDE": "95",
			"GEMINI_CLI_EFFORT_LEVEL": "high",
			"GEMINI_CLI_DISABLE_FEEDBACK_SURVEY": "1",
			"GEMINI_CLI_MAX_OUTPUT_TOKENS": "64000",
			"GEMINI_CLI_SESSIONEND_HOOKS_TIMEOUT_MS": "30000",
			"DISABLE_COST_WARNINGS": "1",
			"ENABLE_TOOL_SEARCH": "1",
			"ENABLE_SECURITY_REMINDER": "0",
			"ECC_HOOK_PROFILE": "minimal"
		},
		"permissions": {
			"defaultMode": "bypassPermissions",
			"_comment": "NO allow list — bypassPermissions means ALL tools are auto-approved"
		}
	}
