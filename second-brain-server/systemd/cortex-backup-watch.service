[Unit]
Description=Cortex: Watcher fuer Z-Schreibvorgaenge -> sofortiges Google-Drive-Backup
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/second-brain/scripts/gedanken-backup-watch.sh
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
