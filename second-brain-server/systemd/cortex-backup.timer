[Unit]
Description=Cortex: regelmaessiges Google-Drive-Backup (Sicherheitsnetz neben dem Watcher)

[Timer]
OnBootSec=5min
OnUnitActiveSec=30min
# Persistent= entfernt: es wirkt NUR mit OnCalendar= (holt verpasste Kalender-Termine nach).
# Bei rein monotonen Timern (OnBootSec/OnUnitActiveSec) ist es wirkungslos.
Unit=cortex-backup.service

[Install]
WantedBy=timers.target
