<?xml version="1.0" encoding="utf-8"?>
<!--
  Aufgaben-Karte fuer die Widget-ListView (Frank-Wunsch 2026-05-31).

  WICHTIG (Fix 2026-05-31): Der Abstand zwischen den Karten liegt jetzt als
  paddingTop auf einem TRANSPARENTEN Wrapper, NICHT als layout_marginTop auf der
  Karte selbst. Grund: In einer RemoteViews-ListView misst der Adapter die
  Zeilenhoehe ohne den Wurzel-Margin, verschiebt das Item aber um diesen Betrag
  nach unten — dadurch wurde unten exakt 8dp abgeschnitten. Der Wrapper-Padding
  fliesst korrekt in die gemessene Zeilenhoehe ein -> nichts wird gekappt.

   1:1 zur radikal vereinfachten App-Karte (TasksScreen.EntropyEntryCard):
    - Hintergrund: horizontaler Verlauf in der Prioritaetsfarbe (im Code getoent)
    - Zeile 1: Haekchen (hakt die Aufgabe DIREKT ab) + Titel (eine Zeile)
    - Zeile 2 (rechtsbuendig): Verschieben-Button
    Keine Beschreibung, keine Prio-Zahl, kein Schweregrad-Balken, keine Tags,
    kein Empfohlen/Zeitaufwand — genau wie in der App.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="8dp">

    <FrameLayout
        android:id="@+id/task_card_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_widget_task_gradient"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ZEILE 1: Haekchen + Titel -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Haekchen: leeres Quadrat (Widget zeigt nur offene Aufgaben).
                     Tap markiert die Aufgabe als erledigt — ohne die App zu oeffnen. -->
                <ImageView
                    android:id="@+id/task_check_box"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:padding="5dp"
                    android:scaleType="fitCenter"
                    android:background="@drawable/widget_check_box_bg"
                    android:contentDescription="Aufgabe abhaken" />

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="1dp" />

                <TextView
                    android:id="@+id/task_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#EAE6FF"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="Aufgaben-Titel" />
            </LinearLayout>

            <ImageView
                android:layout_width="1dp"
                android:layout_height="8dp" />

            <!-- ZEILE 2: rechtsbuendig — Verschieben-Button wie in der App -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/task_move_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    android:background="@drawable/widget_pill_bg"
                    android:contentDescription="Aufgabe verschieben"
                    android:textSize="12sp"
                    android:textColor="#000000"
                    android:textStyle="bold"
                    android:text="Verschieben" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
