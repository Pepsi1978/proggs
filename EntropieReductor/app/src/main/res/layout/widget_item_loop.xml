<?xml version="1.0" encoding="utf-8"?>
<!--
  Loop-Vorlage in der Widget-ListView (Frank-Wunsch 2026-05-31). Vereinfachte Karte:
  Verlaufs-Hintergrund in der Prioritaetsfarbe (wie die Aufgaben-Karte) + Wiederholen-
  Icon + Titel. Tap oeffnet die App (Aktiv/Inaktiv-Schalten bleibt in der App).

  WICHTIG (Fix 2026-05-31): Abstand jetzt als paddingTop auf einem TRANSPARENTEN
  Wrapper statt layout_marginTop auf der Karte — sonst kappt die RemoteViews-ListView
  die Karte unten um den Margin-Betrag (siehe widget_item_task.xml).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="8dp">

    <FrameLayout
        android:id="@+id/loop_card_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_widget_task_gradient"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/loop_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_widget_loop"
                android:contentDescription="Wiederkehrend" />

            <ImageView
                android:layout_width="12dp"
                android:layout_height="1dp" />

            <TextView
                android:id="@+id/loop_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#EAE6FF"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Wiederkehrende Aufgabe" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
