<?xml version="1.0" encoding="utf-8"?>
<!--
  Loop-Vorlage in der Widget-ListView (Frank-Wunsch 2026-05-31, Folge-Iteration).
   Sieht wie eine normale Aufgaben-Karte aus: Bereichsfarbe, Wiederhol-Icon + Titel
   in Zeile 1 und der Hinzufuegen-Button in Zeile 2. Der Button oeffnet die
   Bereichsauswahl fuer genau diese Vorlage.

  Abstand wie bei der Aufgaben-Karte als paddingTop auf transparentem Wrapper
  (sonst kappt die RemoteViews-ListView die Karte unten).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="8dp">

    <FrameLayout
        android:id="@+id/loop_card_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_widget_task_gradient"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ZEILE 1: Wiederhol-Icon + Titel -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/loop_icon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_widget_loop"
                    android:contentDescription="Wiederkehrend" />

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="1dp" />

                <TextView
                    android:id="@+id/loop_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#EAE6FF"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="Wiederkehrende Aufgabe" />
            </LinearLayout>

            <ImageView
                android:layout_width="1dp"
                android:layout_height="8dp" />

            <!-- ZEILE 2: rechtsbuendig — Hinzufuegen wie in der App -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- Hinzufuegen: oeffnet die App direkt mit der Bereichsauswahl. -->
                <TextView
                    android:id="@+id/loop_add_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:background="@drawable/widget_pill_bg"
                    android:textSize="12sp"
                    android:contentDescription="Wiederkehrende Aufgabe hinzufügen"
                    android:textColor="#000000"
                    android:textStyle="bold"
                    android:text="Hinzufügen" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
