<?xml version="1.0" encoding="utf-8"?>
<!--
  Bucket-Header in der ListView (Heute / Morgen / Freiblock / Spaeter).
  Bucket-Tinted Pille + Anzahl + Chevron rechts (auf/zu). Der ganze Header ist
  antippbar (Akkordeon, Frank-Wunsch 2026-05-31): Klick klappt diese Sektion auf
  und alle anderen zu; Klick auf die offene klappt sie zu.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bucket_header_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="4dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:id="@+id/bucket_pill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="10dp"
        android:paddingVertical="5dp"
        android:background="@drawable/widget_bucket_pill_bg">

        <ImageView
            android:id="@+id/bucket_icon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_widget_bucket_today"
            android:contentDescription="Bucket" />

        <TextView
            android:id="@+id/bucket_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#F472B6"
            android:text="Heute" />
    </LinearLayout>

    <ImageView
        android:layout_width="6dp"
        android:layout_height="1dp" />

    <TextView
        android:id="@+id/bucket_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="#A499D9"
        android:text="0" />

    <!-- Schiebt den Chevron nach ganz rechts -->
    <ImageView
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1" />

    <!-- Auf/Zu-Pfeil (Akkordeon) -->
    <ImageView
        android:id="@+id/bucket_chevron"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:src="@drawable/ic_widget_chevron_down"
        android:contentDescription="Aufklappen/Zuklappen" />
</LinearLayout>
