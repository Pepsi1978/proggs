    <!-- Defaults fuer Prompts -->
    <string name="default_prompt_body_first_name">Koerper zuerst</string>
    <string name="default_prompt_body_first_content">Priorisiere Eintraege der Kategorie KOERPERLICH grundsaetzlich am hoechsten, weil koerperliche Verfassung Voraussetzung fuer jede andere Reduktion ist. Wenn ein koerperlicher Eintrag offen ist, darf kein anderer einen hoeheren Score bekommen.</string>
    <string name="default_prompt_shift_logic_name">Schichtdienst-Logik</string>
    <string name="default_prompt_shift_logic_content">Frank arbeitet im Schichtsystem (4 Tagdienste, 4 frei, 4 Nachtdienste, 4 frei). Beruecksichtige bei zeitlichen Aufgaben, ob ein Eintrag in einem Frei-Block schneller erledigt werden kann. Aufgaben, die einen Frei-Block brauchen, werden im Dienst niedriger priorisiert.</string>
    <string name="default_prompt_quick_wins_name">Schnelle Siege bevorzugen</string>
    <string name="default_prompt_quick_wins_content">Wenn ein Eintrag in unter 10 Minuten erledigbar ist, gib ihm einen Bonus von +15 auf den Priority Score, weil schnelle Siege psychische Entropie sofort senken.</string>
