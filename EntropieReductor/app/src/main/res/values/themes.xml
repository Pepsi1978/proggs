<resources>
    <!--
        Splash-/Bootstrap-Theme: nutzt das System-Theme, weil das eigentliche
        Theming komplett in Compose passiert (siehe presentation/theme/Theme.kt).
        Dadurch entfaellt die Abhaengigkeit zu com.google.android.material:material.
        minSdk = 28: tools:targetApi-Schutzlinien sind nicht mehr noetig.
    -->
    <style name="Theme.EntropieReductor" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowBackground">@color/cosmos_bg_dark</item>
    </style>

    <!--
        Widget-spezifische Style-Overrides (Frank-Wunsch 2026-05-11).
        Versteckt den ListView-Scrollbar in der Glance LazyColumn — der
        ist standardmaessig sichtbar und stoert visuell. Wird via
        android:listViewStyle vom Widget-Host (z.B. Nova Launcher) gelesen.
    -->
    <style name="WidgetListViewNoScrollbar" parent="@android:style/Widget.Material.ListView">
        <item name="android:scrollbars">none</item>
        <item name="android:scrollbarSize">0dp</item>
        <item name="android:scrollbarThumbVertical">@android:color/transparent</item>
        <item name="android:scrollbarTrackVertical">@android:color/transparent</item>
        <item name="android:fadeScrollbars">true</item>
    </style>
</resources>
