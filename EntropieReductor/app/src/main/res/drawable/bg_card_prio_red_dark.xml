<?xml version="1.0" encoding="utf-8"?>
<!--
  Aufgaben-Karten-Hintergrund nach priorityScore (Frank-Wunsch 2026-05-22
  fuenfte Iteration): bg fuer Prio 80-100 = Rot-Stich.
  Gradient BOTTOM-LEFT (dunkler Card-BG) -> TOP-RIGHT (Prio-Tint).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="20dp" />
    <gradient
        android:type="linear"
        android:angle="45"
        android:startColor="#1A1438"
        android:endColor="#33EF4444" />
</shape>
