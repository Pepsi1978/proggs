<?xml version="1.0" encoding="utf-8"?>
<!--
  Verlaufs-Basis fuer die Widget-Aufgabenkarte (Frank-Wunsch 2026-05-31).

  Horizontaler Verlauf von 20%-Weiss (links) zu 100%-Weiss (rechts) mit runden
  Ecken. Im Code wird das Drawable per setBackgroundTintList mit der Prioritaets-
  Farbe getoent (SRC_IN) — dadurch bleibt der Alpha-Verlauf erhalten und es
  entsteht links dezent → rechts volle Prioritaetsfarbe, exakt wie der
  Brush.horizontalGradient(listOf(ramp@20%, ramp)) in der App-Karte.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="20dp" />
    <gradient
        android:startColor="#33FFFFFF"
        android:endColor="#FFFFFFFF"
        android:angle="0" />
</shape>
