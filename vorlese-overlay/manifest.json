{
	"manifest_version": 3,
	"name": "Vorlese-Overlay",
	"version": "0.1.1",
	"description": "Markierten Text auf jeder Webseite vorlesen — Edge TTS (kostenlos) oder Google Chirp 3 HD.",
	"default_locale": "de",
	"permissions": [
		"storage",
		"offscreen",
		"activeTab",
		"scripting",
		"declarativeNetRequestWithHostAccess",
		"downloads"
	],
	"host_permissions": [
		"https://texttospeech.googleapis.com/*",
		"https://speech.platform.bing.com/*",
		"wss://speech.platform.bing.com/*"
	],
	"declarative_net_request": {
		"rule_resources": [
			{
				"id": "edge_ua",
				"enabled": true,
				"path": "rules/edge-ua.json"
			}
		]
	},
	"background": {
		"service_worker": "background/service-worker.js",
		"type": "module"
	},
	"content_scripts": [
		{
			"matches": ["http://*/*", "https://*/*"],
			"js": [
				"diag/diag-content.js",
				"settings/settings.js",
				"content/overlay.js",
				"diag/selftest.js"
			],
			"run_at": "document_idle",
			"all_frames": false
		}
	],
	"web_accessible_resources": [
		{
			"resources": ["content/overlay.css", "icons/*"],
			"matches": ["<all_urls>"]
		}
	],
	"commands": {
		"speak-selection": {
			"suggested_key": {
				"default": "Ctrl+Shift+S",
				"mac": "Command+Shift+S"
			},
			"description": "Markierten Text vorlesen"
		}
	}
}
