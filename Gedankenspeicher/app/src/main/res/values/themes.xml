<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Nur der Start-Anstrich. Die vier Erscheinungen kommen aus Compose (ui/theme/Theme.kt),
      weil F-15 ohne Neustart zwischen ihnen umschaltet.
      Grund = #0D0B07 (UI-Spec §2.1, Gold-Dunkel), damit der Start nicht aufblitzt.
    -->
    <style name="Theme.Gedankenspeicher" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#0D0B07</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
