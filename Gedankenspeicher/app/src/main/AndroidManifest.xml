<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 00-PROJEKT.md §3: RECORD_AUDIO wird erst beim ersten Druck auf den Aufnahmeknopf
         abgefragt, nicht beim Start. INTERNET und ACCESS_NETWORK_STATE sind
         Installationsrechte ohne Abfrage. Ein Benachrichtigungsrecht wird bewusst NICHT
         angefordert (O-03). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- B-09: die Aufnahme läuft weiter, wenn Frank die App verlässt. Android gibt einer App
         im Hintergrund das Mikrofon nur über einen Vordergrunddienst vom Typ `microphone`;
         POST_NOTIFICATIONS macht dessen Anzeige sichtbar (auf Android 13+ sonst stumm). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Kamera und Dokumentenscan aus dem Plus-Menü laufen über fremde Apps
         (ACTION_IMAGE_CAPTURE, ML-Kit-Scanner) — ein eigenes CAMERA-Recht braucht
         die App dafür nicht. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".GedankenspeicherApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="false"
        android:theme="@style/Theme.Gedankenspeicher">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode"
            android:theme="@style/Theme.Gedankenspeicher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>


        <!-- B-09: hält das Mikrofon am Leben, solange eine andere App vorn ist. -->
        <service
            android:name=".audio.AufnahmeDienst"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- F-16: nur der Export-Ordner im Cache wird freigegeben, nichts sonst. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.dateien"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/dateipfade" />
        </provider>

    </application>

</manifest>
