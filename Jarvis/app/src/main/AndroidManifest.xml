<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Live-Gespräch über Bluetooth-Freisprechen (startBluetoothSco) bis Android 11 -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Fahrzeit vom aktuellen Standort (Google Routes API). „Immer“, weil Jarvis im Hintergrund und für ChatGPT arbeitet. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Exakte Wecker für die Tagesauswertung zu den eingestellten Uhrzeiten. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- „Hey Jarvis“: dauerhaft lauschen (Mikrofon-Dienst) und Jarvis danach aus dem Hintergrund nach vorn holen,
         auch über dem Sperrbildschirm. Ohne „Über anderen Apps einblenden“ verbietet Android das. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- Brücke zu Geniale Aufgaben. Beide Apps erklären dieselbe Signatur-Erlaubnis, damit die
         Installationsreihenfolge keine Rolle spielt (gleicher Signierschlüssel vorausgesetzt). -->
    <permission
        android:name="de.frank.aufgaben.permission.JARVIS"
        android:protectionLevel="signature" />
    <uses-permission android:name="de.frank.aufgaben.permission.JARVIS" />

    <!-- Allgemeine Erlaubnis für alle weiteren angebundenen Apps (zuerst: Entropie Reductor, Biomarker). -->
    <permission
        android:name="de.frank.jarvis.permission.BRUECKE"
        android:protectionLevel="signature" />
    <uses-permission android:name="de.frank.jarvis.permission.BRUECKE" />

    <queries>
        <package android:name="de.frank.aufgaben" />
        <!-- Update-Signal vom Server an UpdateStation weiterreichen. -->
        <package android:name="de.frank.updatestation" />
        <!-- Programmieraufträge: Die Benachrichtigung öffnet die Claude-App (Sitzungen unter Code). -->
        <package android:name="com.anthropic.claude" />
        <provider android:authorities="de.frank.aufgaben.jarvis" />
        <provider android:authorities="de.frank.entropyreducer.debug.jarvis" />
        <provider android:authorities="de.frank.entropyreducer.jarvis" />
        <provider android:authorities="de.frank.genialeideen.jarvis" />
        <provider android:authorities="de.frank.genialerwecker.jarvis" />
        <provider android:authorities="de.frank.epigenetik.jarvis" />
        <provider android:authorities="de.frank.stacklabor.werftstudio.jarvis" />
    </queries>

    <application
        android:name=".JarvisApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/datensicherung_regeln"
        android:fullBackupContent="@xml/datensicherung_alt"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Jarvis">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Hält MCP-Server und Tunnel am Leben, auch bei gesperrtem Handy. -->
        <service
            android:name=".dienst.JarvisDienst"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Persönlicher Assistent: nimmt Werkzeugaufrufe des eigenen ChatGPT-Plugins dauerhaft entgegen." />
        </service>

        <!-- Lauscht auf „Hey Jarvis“, auch bei gesperrtem Handy. -->
        <service
            android:name=".weckwort.WeckwortDienst"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Hält die von Hand gestartete Aufnahme am Leben, während eine andere App vorn ist. -->
        <service
            android:name=".audio.AufnahmeDienst"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Unsichtbar: startet nach Neustart und Update den Weckwort-Dienst (das darf nur eine sichtbare App). -->
        <activity
            android:name=".weckwort.WeckwortDienst$Starter"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <receiver android:name=".dienst.StartEmpfaenger" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <receiver android:name=".auswertung.AuswertungsEmpfaenger" android:exported="false" />
        <receiver android:name=".gedaechtnis.LernEmpfaenger" android:exported="false" />
        <receiver android:name=".fahrt.AbfahrtEmpfaenger" android:exported="false" />
        <!-- Ansagen eigener Apps (UpdateStation): nur mit Franks Signatur. -->
        <receiver
            android:name=".speech.AnsageEmpfaenger"
            android:exported="true"
            android:permission="de.frank.jarvis.permission.BRUECKE">
            <intent-filter>
                <action android:name="de.frank.jarvis.ANSAGE" />
            </intent-filter>
        </receiver>
        <receiver android:name=".timer.TimerEmpfaenger" android:exported="false" />
        <receiver android:name=".dienst.AgentenEntscheidungEmpfaenger" android:exported="false" />
        <!-- Wegwischen einer Meldung, die wie ein Wecker klingelt: Jarvis beendet ihren Weckton. -->
        <receiver android:name=".meldung.WeckerTonEmpfaenger" android:exported="false" />

        <!-- Lässt einen abgelaufenen Timer wie einen Wecker klingeln, bis Frank ausschaltet. -->
        <service
            android:name=".timer.TimerKlingelDienst"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Ablage: Dateien zum Teilen und „Mit anderer App öffnen“ als Inhalts-Adresse mit befristeter Leseberechtigung. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="de.frank.jarvis.dateien"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/ablage_pfade" />
        </provider>

        <!-- Hält das Vorlesen am Laufen, auch wenn die App im Hintergrund ist. -->
        <service
            android:name=".speech.VorleseDienst"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- ONNX Runtime ab 1.31 startet hierüber beim App-Start eine Telemetrie an Microsoft (Geräte-ID, Netz,
             Akku). Jarvis sendet nichts davon: Baustein entfernen; WeckwortErkenner schaltet sie zusätzlich ab. -->
        <provider
            android:name="ai.onnxruntime.TelemetryInitializer"
            android:authorities="${applicationId}.onnxruntime_telemetry_initializer"
            tools:node="remove" />
    </application>
</manifest>
