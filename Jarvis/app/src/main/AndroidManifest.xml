<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:requiredSplitTypes="freigabe">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Victron-Solarbatterie (Instant Readout): nur Werbepakete mithören, nie ein Standort daraus. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" tools:targetApi="s" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Fahrzeit vom aktuellen Standort (Google Routes API). „Immer“, weil Jarvis im Hintergrund und für ChatGPT arbeitet. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Exakte Wecker für die Tagesauswertung zu den eingestellten Uhrzeiten. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- „Hey Jarvis“: dauerhaft lauschen (Mikrofon-Dienst) und Jarvis danach aus dem Hintergrund nach vorn holen,
         auch über dem Sperrbildschirm. Ohne „Über anderen Apps einblenden“ verbietet Android das. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- Brücke zu Geniale Aufgaben. Beide Apps erklären dieselbe Signatur-Erlaubnis, damit die
         Installationsreihenfolge keine Rolle spielt (gleicher Signierschlüssel vorausgesetzt). -->
    <permission
        android:name="de.frank.aufgaben.permission.JARVIS"
        android:protectionLevel="signature" />
    <uses-permission android:name="de.frank.aufgaben.permission.JARVIS" />

    <!-- Allgemeine Erlaubnis für alle weiteren angebundenen Apps (zuerst: Entropie Reductor, Biomarker). -->
    <permission
        android:name="de.frank.jarvis.permission.BRUECKE"
        android:protectionLevel="signature" />
    <uses-permission android:name="de.frank.jarvis.permission.BRUECKE" />

    <!-- Brücke zur App Ziele: Ziele lesen, schreiben und steuern. Beide Apps erklären die Erlaubnis (Installationsreihenfolge egal). -->
    <permission
        android:name="de.frank.ziele.permission.JARVIS"
        android:protectionLevel="signature" />
    <uses-permission android:name="de.frank.ziele.permission.JARVIS" />

    <!-- Biomarker (aus Entropie Reductor übernommen): Trainings und Körperwerte aus Health Connect lesen. -->
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />
    <uses-permission android:name="android.permission.health.READ_BODY_FAT" />
    <uses-permission android:name="android.permission.health.READ_LEAN_BODY_MASS" />
    <uses-permission android:name="android.permission.health.READ_BODY_WATER_MASS" />
    <uses-permission android:name="android.permission.health.READ_BONE_MASS" />
    <uses-permission android:name="android.permission.health.READ_HEIGHT" />
    <uses-permission android:name="android.permission.health.READ_BASAL_METABOLIC_RATE" />
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <uses-permission android:name="android.permission.health.READ_ELEVATION_GAINED" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE_ROUTES" />
    <uses-permission android:name="android.permission.health.READ_FLOORS_CLIMBED" />
    <uses-permission android:name="android.permission.health.READ_POWER" />
    <uses-permission android:name="android.permission.health.READ_SPEED" />
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_TOTAL_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_VO2_MAX" />
    <uses-permission android:name="android.permission.health.READ_WHEELCHAIR_PUSHES" />
    <uses-permission android:name="android.permission.health.READ_BLOOD_GLUCOSE" />
    <uses-permission android:name="android.permission.health.READ_BLOOD_PRESSURE" />
    <uses-permission android:name="android.permission.health.READ_BODY_TEMPERATURE" />
    <uses-permission android:name="android.permission.health.READ_BASAL_BODY_TEMPERATURE" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE_VARIABILITY" />
    <uses-permission android:name="android.permission.health.READ_OXYGEN_SATURATION" />
    <uses-permission android:name="android.permission.health.READ_RESPIRATORY_RATE" />
    <uses-permission android:name="android.permission.health.READ_RESTING_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_SKIN_TEMPERATURE" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_HYDRATION" />
    <uses-permission android:name="android.permission.health.READ_NUTRITION" />
    <uses-permission android:name="android.permission.health.READ_CERVICAL_MUCUS" />
    <uses-permission android:name="android.permission.health.READ_INTERMENSTRUAL_BLEEDING" />
    <uses-permission android:name="android.permission.health.READ_MENSTRUATION" />
    <uses-permission android:name="android.permission.health.READ_OVULATION_TEST" />
    <uses-permission android:name="android.permission.health.READ_SEXUAL_ACTIVITY" />
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND" />
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_HISTORY" />

    <queries>
        <package android:name="de.frank.ziele" />
        <provider android:authorities="de.frank.ziele.jarvis" />
        <package android:name="de.frank.aufgaben" />
        <!-- Update-Signal vom Server an UpdateStation weiterreichen. -->
        <package android:name="de.frank.updatestation" />
        <!-- Programmieraufträge: Die Benachrichtigung öffnet die Claude-App (Sitzungen unter Code). -->
        <package android:name="com.anthropic.claude" />
        <provider android:authorities="de.frank.aufgaben.jarvis" />
        <provider android:authorities="de.frank.entropyreducer.debug.jarvis" />
        <provider android:authorities="de.frank.entropyreducer.jarvis" />
        <provider android:authorities="de.frank.genialeideen.jarvis" />
        <provider android:authorities="de.frank.genialerwecker.jarvis" />
        <provider android:authorities="de.frank.epigenetik.jarvis" />
        <provider android:authorities="de.frank.stacklabor.werftstudio.jarvis" />
        <!-- Schnellstart auf dem Startbildschirm: Franks eigene startbare Apps finden und öffnen.
             Auch der Saugroboter: Proscenic-App öffnen und danach zur vorher offenen App zurückkehren. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Biomarker: Waage über die Zepp-App, Trainings über Health Connect. -->
        <package android:name="com.huami.watch.hmwatchmanager" />
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <!-- isSplitRequired und requiredSplitTypes: Ohne den Teil „freigabe“ lehnt Android jede Installation ab
         (INSTALL_FAILED_MISSING_SPLIT). So geht kein nacktes adb install an der Installationsfrage vorbei. -->
    <application
        android:isSplitRequired="true"
        android:networkSecurityConfig="@xml/netz_regeln"
        android:name=".JarvisApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/datensicherung_regeln"
        android:fullBackupContent="@xml/datensicherung_alt"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Jarvis">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Server-Konsole im Tunnel (OpenLauncherServer/web). Falten/Drehen ohne Neuaufbau, damit das Terminal bleibt. -->
        <activity
            android:name=".fernsteuerung.ServerKonsoleActivity"
            android:exported="false"
            android:label="Server-Konsole"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|density|uiMode" />

        <!-- Mac-Bildschirm live bedienen (Gegenstück: werkzeuge/mac-fernsteuerung). Falten/Drehen ohne Neuaufbau. -->
        <activity
            android:name=".fernsteuerung.FernsteuerungActivity"
            android:exported="false"
            android:label="Mac-Bildschirm"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|density|uiMode"
            android:windowSoftInputMode="stateHidden|adjustResize" />

        <!-- Hält MCP-Server und Tunnel am Leben, auch bei gesperrtem Handy. -->
        <service
            android:name=".dienst.JarvisDienst"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Persönlicher Assistent: nimmt Werkzeugaufrufe des eigenen ChatGPT-Plugins dauerhaft entgegen." />
        </service>

        <!-- Bedienungshilfe „Jarvis Staubsauger“: tippt auf Wunsch in der Proscenic-App (M7 Pro). -->
        <service
            android:name=".staubsauger.ProscenicBedienung"
            android:exported="true"
            android:label="@string/staubsauger_bedienung"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/staubsauger_bedienung" />
        </service>

        <!-- Lauscht auf „Hey Jarvis“, auch bei gesperrtem Handy. -->
        <service
            android:name=".weckwort.WeckwortDienst"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Hält die von Hand gestartete Aufnahme am Leben, während eine andere App vorn ist. -->
        <service
            android:name=".audio.AufnahmeDienst"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Overlay-Frage vor einer adb-Installation; gestartet von Werkzeuge/jarvis-install. DUMP hat die adb-Shell, fremde Apps nicht. -->
        <service
            android:name=".ui.InstallFrageDienst"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:foregroundServiceType="shortService" />

        <!-- Unsichtbar: startet nach Neustart und Update den Weckwort-Dienst (das darf nur eine sichtbare App). -->
        <activity
            android:name=".weckwort.WeckwortDienst$Starter"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <receiver android:name=".dienst.StartEmpfaenger" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Listen-Widget: Listenwahl, Abhaken und Blättern laufen als ausdrücklich adressierte Broadcasts an diesen Empfänger. -->
        <receiver android:name=".listen.ListenWidgetEmpfaenger" android:exported="false" android:label="Jarvis Listen">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_listen_info" />
        </receiver>
        <receiver android:name=".auswertung.AuswertungsEmpfaenger" android:exported="false" />
        <receiver android:name=".gedaechtnis.LernEmpfaenger" android:exported="false" />
        <receiver android:name=".fahrt.AbfahrtEmpfaenger" android:exported="false" />
        <!-- Ansagen eigener Apps (UpdateStation): nur mit Franks Signatur. -->
        <receiver
            android:name=".speech.AnsageEmpfaenger"
            android:exported="true">
            <intent-filter>
                <action android:name="de.frank.jarvis.ANSAGE" />
            </intent-filter>
        </receiver>
        <!-- Messlauf der Sprachkette über adb: DUMP besitzt nur die Shell und das System, keine andere App. -->
        <receiver
            android:name=".ui.SprachMesslauf"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="de.frank.jarvis.SPRACH_MESSLAUF" />
            </intent-filter>
        </receiver>
        <!-- Einstellungs-Umzug aufs zweite Gerät (Handy → Tablet): Export nur für Shell und System, siehe data/Umzug.kt. -->
        <receiver
            android:name=".data.UmzugEmpfaenger"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="de.frank.jarvis.EINSTELLUNGEN_UMZUG" />
                <!-- Nach einer Installation per adb: weckt nur den Prozess, damit Dienst und Verbindung sofort wieder laufen. -->
                <action android:name="de.frank.jarvis.AUFWACHEN" />
            </intent-filter>
        </receiver>
        <receiver android:name=".timer.TimerEmpfaenger" android:exported="false" />
        <receiver android:name=".ablage.ErinnerungEmpfaenger" android:exported="false" />
        <service android:name=".ablage.ErinnerungKlingelDienst" android:exported="false" android:foregroundServiceType="mediaPlayback" />
        <activity
            android:name=".ablage.ErinnerungWeckerActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:taskAffinity="de.frank.jarvis.wecker"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.Jarvis" />
        <receiver android:name=".dienst.AgentenEntscheidungEmpfaenger" android:exported="false" />
        <!-- Wegwischen einer Meldung, die wie ein Wecker klingelt: Jarvis beendet ihren Weckton. -->
        <receiver android:name=".meldung.WeckerTonEmpfaenger" android:exported="false" />

        <!-- Lässt einen abgelaufenen Timer wie einen Wecker klingeln, bis Frank ausschaltet. -->
        <service
            android:name=".timer.TimerKlingelDienst"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- App Ziele liest hier das Live-Gedächtnis als Kontext und übernimmt die Schlüssel; nur mit Franks Signatur. -->
        <provider
            android:name=".faehigkeit.ZieleBruecke"
            android:authorities="de.frank.jarvis.ziele"
            android:exported="true" />
        <!-- Ablage: Dateien zum Teilen und „Mit anderer App öffnen“ als Inhalts-Adresse mit befristeter Leseberechtigung. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="de.frank.jarvis.dateien"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/ablage_pfade" />
        </provider>

        <!-- Hält das Vorlesen am Laufen, auch wenn die App im Hintergrund ist. -->
        <service
            android:name=".speech.VorleseDienst"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- ONNX Runtime ab 1.31 startet hierüber beim App-Start eine Telemetrie an Microsoft (Geräte-ID, Netz,
             Akku). Jarvis sendet nichts davon: Baustein entfernen; WeckwortErkenner schaltet sie zusätzlich ab. -->
        <provider
            android:name="ai.onnxruntime.TelemetryInitializer"
            android:authorities="${applicationId}.onnxruntime_telemetry_initializer"
            tools:node="remove" />
        <!-- Offline-Modell für Franks andere Apps; nur mit gleichem Signaturschlüssel erreichbar. -->
        <provider
            android:name=".speech.ParakeetBruecke"
            android:authorities="de.frank.jarvis.parakeet"
            android:exported="true" />

            <!-- Biomarker: Satellitenkarte im Trainings-Detail (Schlüssel aus ~/SK beim Bau). -->
        <meta-data android:name="com.google.android.geo.API_KEY" android:value="${mapsApiKey}" />
        <!-- Biomarker: Whoop meldet sich nach der Anmeldung über diese Adresse zurück (AppAuth). -->
        <activity
            android:name="net.openid.appauth.RedirectUriReceiverActivity"
            android:exported="true"
            tools:node="replace">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${appAuthRedirectScheme}" />
            </intent-filter>
        </activity>
        <!-- Biomarker: Datenschutz-Hinweis für Health Connect (Pflicht ab Android 14). -->
        <activity
            android:name=".bio.presentation.health.HealthConnectPrivacyActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity>
    </application>
</manifest>
