<?xml version="1.0" encoding="utf-8"?>
<!-- Klartext-HTTP nur zur Server-Konsole im WireGuard-Tunnel (der Tunnel verschlüsselt); überall sonst bleibt es verboten. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.8.0.1</domain>
        <!-- Verwaltung des Tenda-Routers im Heim-WLAN (nur lokal; Anmeldung mit MD5 wie die Weboberfläche). -->
        <domain includeSubdomains="false">192.168.0.1</domain>
    </domain-config>
</network-security-config>
