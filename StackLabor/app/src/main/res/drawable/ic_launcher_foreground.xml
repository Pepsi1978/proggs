<?xml version="1.0" encoding="utf-8"?>
<!-- Eine stilisierte Kapsel mit den drei Ampelstufen als Fuellung — das Zeichen der App.
     Sichere Zone eines adaptiven Symbols: mittlere 72 von 108 dp. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Kapsel-Umriss, um 35 Grad geneigt -->
    <group android:pivotX="54" android:pivotY="54" android:rotation="-35">
        <!-- untere Haelfte (weiss) -->
        <path
            android:pathData="M54,30 L54,78 A12,12 0 0,1 42,66 L42,42 A12,12 0 0,1 54,30 Z"
            android:fillColor="#FFFFFF" />
        <!-- obere Haelfte, in Ampelstufen geteilt -->
        <path
            android:pathData="M54,30 A12,12 0 0,1 66,42 L66,46 L54,46 Z"
            android:fillColor="#34D399" />
        <path
            android:pathData="M54,46 L66,46 L66,62 L54,62 Z"
            android:fillColor="#FBBF24" />
        <path
            android:pathData="M54,62 L66,62 L66,66 A12,12 0 0,1 54,78 Z"
            android:fillColor="#F87171" />
    </group>
</vector>
