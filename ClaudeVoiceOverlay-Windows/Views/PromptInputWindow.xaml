<Window x:Class="ClaudeVoiceOverlay.Views.PromptInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PromptInput"
        Width="1140" Height="490"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- Stern-Button-Style: 1:1 identisch zum IconButton im PromptBoard.
             Gleiche 26x26-Basis, gleiche Border (#6A6A6A), gleiche Segoe-
             Fluent-Icons-Schriftart, damit der Stern hier exakt so aussieht
             wie sein Pendant in der Toolbar des Promtboards. -->
        <Style x:Key="BoardIconButton" TargetType="Button">
            <Setter Property="Background" Value="#FF383838"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="13" BorderBrush="#FF6A6A6A" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#FF525252"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toolbar-Button im Stil der CircleButtons aus dem Voice-Overlay,
             aber kompakter (28x28) damit die Leiste nicht zu hoch wird. -->
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="#FF2D2D2D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="14"
                                Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#FF3D3D3D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slot-Button (Prompt-Zwischenspeicher 1…15 sowie Diskette/X).
             Rechteckiger als die runden Toolbar-Buttons (CornerRadius 6), 30x26.
             Auswahl wird ueber BorderBrush/BorderThickness vom Code-Behind
             gesetzt (goldener Rahmen), belegt/leer ueber Foreground. -->
        <Style x:Key="SlotButton" TargetType="Button">
            <!-- Tooltip beim ersten Hover schneller einblenden: Standard ist
                 400ms, hier ~ein Drittel (130ms) auf Frank-Wunsch 2026-06-11. -->
            <Setter Property="ToolTipService.InitialShowDelay" Value="130"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Background" Value="#FF2D2D2D"/>
            <Setter Property="Foreground" Value="#FF8C8C8C"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- Grid: Hintergrund-Border (Prioritaetsfarbe via TemplateBinding
                             Background), darueber ein Hover-Overlay als transparenter
                             Schleier statt Hintergrund-Ersatz — sonst wuerde der Hover
                             die rote/gelbe/gruene Prioritaetsfarbe ueberdecken. Die Zahl
                             (ContentPresenter) liegt ganz oben und bleibt immer scharf. -->
                        <Grid>
                            <Border x:Name="SlotBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"/>
                            <Border x:Name="HoverOverlay"
                                    Background="Transparent"
                                    CornerRadius="6"/>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverOverlay" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tooltip im App-Stil (Frank-Wunsch 2026-06-11): weisser Hintergrund,
             abgerundete Ecken, dezenter Rahmen + Schatten, dunkle Schrift —
             kein eckiger Standard-Kasten. Gilt implizit fuer ALLE Tooltips im
             Eingabefenster (Slot-Zusammenfassungen UND Toolbar-Buttons).
             Der Opened-Handler (SlotToolTip_Opened) schiebt das Popup-HWND auf
             HWND_TOPMOST — sonst rutscht der Tooltip hinter das Topmost-Overlay
             (gleiches Problem + Loesung wie ForcePopupTopmost bei den Menues). -->
        <Style TargetType="ToolTip">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <EventSetter Event="Opened" Handler="SlotToolTip_Opened"/>
            <EventSetter Event="Closed" Handler="SlotToolTip_Closed"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="#FFFFFFFF"
                                CornerRadius="8"
                                BorderBrush="#FFD0D0D0"
                                BorderThickness="1"
                                Padding="11,7"
                                MaxWidth="380">
                            <Border.Effect>
                                <DropShadowEffect Color="#FF000000"
                                                  BlurRadius="12"
                                                  ShadowDepth="2"
                                                  Opacity="0.30"/>
                            </Border.Effect>
                            <TextBlock Text="{TemplateBinding Content}"
                                       TextWrapping="Wrap"
                                       Foreground="#FF1E1E1E"
                                       FontFamily="Segoe UI"
                                       FontSize="13"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Halbtransparenter Container, gleiche Optik wie PromptBoardPanel,
         damit der Terminal-Text durchschimmert (Alpha C7 = 78%). -->
    <Border CornerRadius="16"
            Background="#C71E1E1E"
            BorderBrush="#FF3A3A3A"
            BorderThickness="1">
        <Grid Margin="10,10,10,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Kopfzeile: Titel + Hint + Standard-Symbole + Kopieren/Einfuegen.
                 Spalte 2 = Standard-Symbole (Stern, Trenner, Gemini, Loeschen).
                 Spalte 4 = Kopieren/Einfuegen, GANZ rechts am Rand. Die beiden
                 *-Spalten (1 und 3) teilen sich den freien Platz, so dass das
                 Kopieren/Einfuegen-Paar abgesetzt ganz aussen rechts steht und
                 NICHT direkt neben dem X (Frank-Wunsch 2026-06-06). -->
            <Grid Grid.Row="0" Margin="4,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           x:Name="TitleLabel"
                           Text="Prompt-Eingabe"
                           Foreground="#FFCCCCCC"
                           FontWeight="Bold"
                           FontSize="13"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           x:Name="HintLabel"
                           Text="Enter sendet · Shift+Enter neue Zeile · Rechtsklick zum Verschieben"
                           Foreground="#FF7F7F7F"
                           FontSize="10"
                           Margin="10,0,10,0"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>

                <!-- Buttonleiste rechts oben.
                     Reihenfolge: Stern (Solo-Andocken ans Voice-Overlay) |
                                  ; (Aufgaben-Trenner manuell einfuegen) |
                                  G (Gemini-Verbesserung) |
                                  rotes X (Eingabe leeren).
                     Der Stern blendet das Promptboard aus und dockt dieses
                     Eingabefenster direkt an die schmale Voice-Overlay-Leiste
                     an. Erneuter Klick holt das Promptboard zurueck und
                     dieses Fenster rutscht wieder an dessen linken Rand.
                     Visuell 1:1 wie der Stern in der Promptboard-Toolbar:
                     Segoe Fluent Icons E735 (Fill, gold #FFD700) — auf Wunsch
                     des Benutzers IMMER goldig, unabhaengig vom Solo-Modus. -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="SoloDockStarButton"
                            Style="{StaticResource BoardIconButton}"
                            Click="BtnSoloDockStar_Click"
                            Margin="0,0,4,0"
                            Content="&#xE735;"
                            Foreground="#FFFFD700"
                            ToolTip="Promptboard ausblenden und Eingabe direkt ans Voice-Overlay andocken (erneuter Klick blendet das Promptboard wieder ein)."/>
                    <!-- Semikolon-Button mit Aufleucht-Effekt:
                         Beim Klick blitzt der Button kurz golden auf und legt
                         einen Glow-Schein um sich, der innerhalb von ~400ms
                         wieder verblasst. So sieht der Benutzer SOFORT dass
                         der Aufgaben-Trenner gesetzt wurde, ohne erst nach
                         unten in den Text scrollen zu muessen.
                         Effect-Opacity startet bei 0 (nicht sichtbar im
                         Ruhezustand), die TextBlock-Foreground bleibt
                         standardmaessig hellblau wie bisher. Beide werden
                         beim Klick aus dem Code-Behind animiert. -->
                    <Button x:Name="SeparatorButton"
                            Style="{StaticResource ToolbarButton}"
                            Click="BtnInsertSeparator_Click"
                            Margin="0,0,4,0"
                            ToolTip="Aufgaben-Trenner einfuegen — haengt eine Leerzeile, ein Semikolon und noch eine Leerzeile ans Ende des Textes an.">
                        <Button.Effect>
                            <DropShadowEffect x:Name="SeparatorGlow"
                                              Color="#FFFFE680"
                                              BlurRadius="0"
                                              ShadowDepth="0"
                                              Opacity="0"/>
                        </Button.Effect>
                        <TextBlock x:Name="SeparatorGlyph"
                                   Text=";"
                                   FontWeight="Bold"
                                   FontSize="16"
                                   Foreground="#FF7FD0FF"/>
                    </Button>
                    <Button x:Name="GeminiButton"
                            Style="{StaticResource ToolbarButton}"
                            Click="BtnGemini_Click"
                            Margin="0,0,4,0"
                            ToolTip="Mit Gemini verbessern — der aktuelle Eingabe-Text wird durch eine bereinigte Variante ersetzt.">
                        <TextBlock Text="G"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   Foreground="#FFFFD700"/>
                    </Button>
                    <Button x:Name="ClearInputButton"
                            Style="{StaticResource ToolbarButton}"
                            Click="BtnClearInput_Click"
                            ToolTip="Eingabe-Text loeschen">
                        <TextBlock Text="X"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   Foreground="#FFFF4444"/>
                    </Button>
                </StackPanel>

                <!-- Kopieren/Einfuegen-Paar: eigene StackPanel GANZ rechts am
                     Fensterrand (Spalte 4), abgesetzt von den Standard-Symbolen.
                     Segoe-Fluent-Icons, monochrom. Kopieren legt den Feld-Text in
                     die Zwischenablage (ueberall mit Strg+V einfuegbar), Einfuegen
                     holt den Zwischenablage-Text an die Cursor-Position ins Feld. -->
                <StackPanel Grid.Column="4"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="CopyButton"
                            Style="{StaticResource ToolbarButton}"
                            Click="BtnCopy_Click"
                            Margin="0,0,4,0"
                            ToolTip="Angezeigten Text kopieren — danach überall mit Strg+V einfügbar.">
                        <TextBlock Text="&#xE8C8;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="14"
                                   Foreground="#FFFFD700"/>
                    </Button>
                    <Button x:Name="PasteButton"
                            Style="{StaticResource ToolbarButton}"
                            Click="BtnPaste_Click"
                            ToolTip="Text aus der Zwischenablage ins Eingabefeld einfügen.">
                        <TextBlock Text="&#xE77F;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="14"
                                   Foreground="#FF4CD964"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Trennlinie oben: grenzt das Eingabefeld nach oben gegen die
                 Kopfzeile (Titel + Toolbar) ab — Gegenstueck zur Linie ueber
                 der Slot-Leiste (Frank-Wunsch 2026-06-06). Gleicher Grauton
                 #FF525252 wie der untere Strich. -->
            <Border Grid.Row="1"
                    Height="1"
                    Background="#FF525252"
                    HorizontalAlignment="Stretch"
                    Margin="0,0,0,8"/>

            <!-- Eingabefeld: mehrzeilig, scrollbar. KEIN eigener Hintergrund —
                 die aeussere Border (#C71E1E1E, 78% opak) scheint durch, so
                 dass der Eingabebereich exakt so transparent wirkt wie das
                 Promtboard und die Historie.
                 InputBorder reagiert auf den Tastatur-Fokus der TextBox:
                 BorderBrush wechselt beim Fokus auf gedaempftes Blau (#6A9FD8)
                 und zurueck auf #3A3A3A wenn der Fokus verloren geht. -->
            <Border x:Name="InputBorder"
                    Grid.Row="2"
                    CornerRadius="8"
                    Background="Transparent"
                    BorderBrush="#FF3A3A3A"
                    BorderThickness="1">
                <TextBox x:Name="InputBox"
                         AcceptsReturn="True"
                         AcceptsTab="False"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Background="Transparent"
                         Foreground="White"
                         CaretBrush="#FFFFD700"
                         BorderThickness="0"
                         FontSize="26"
                         Padding="10,8"
                         FontFamily="Segoe UI"
                         FocusVisualStyle="{x:Null}"
                         GotFocus="InputBox_GotFocus"
                         LostFocus="InputBox_LostFocus"
                         TextChanged="InputBox_TextChanged"/>
            </Border>

            <!-- Statuszeile unten: Pre/Post-Vorschau -->
            <TextBlock Grid.Row="3"
                       x:Name="PreviewLabel"
                       Text=""
                       Foreground="#FF8C8C8C"
                       FontSize="10"
                       Margin="4,8,0,0"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis"/>

            <!-- Zahlen-Leiste (Prompt-Zwischenspeicher 1…30) ganz unten.
                 Zwei Reihen: 1…15 oben (SlotBarRow1), 16…30 unten (SlotBarRow2).
                 Eine Trennlinie grenzt sie sichtbar vom Eingabefeld ab — die
                 Slots sind unabhaengig von der Eingabe. Die Buttons werden im
                 Code-Behind (BuildSlotBar) in die beiden Reihen eingehaengt.
                 Diskette, X und Zeitstempel liegen EINMAL rechts daneben
                 (SlotActions, vertikal zentriert ueber beide Reihen) und gelten
                 fuer den aktuell gewaehlten Slot — egal in welcher Reihe.
                 Sie erscheinen erst nach Auswahl einer Zahl. -->
            <StackPanel Grid.Row="4"
                        Orientation="Vertical"
                        Margin="4,8,0,0">
                <Border Height="1"
                        Background="#FF525252"
                        HorizontalAlignment="Stretch"
                        Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <!-- Zwei Zahlen-Reihen untereinander: 1…15 / 16…30 -->
                    <StackPanel Orientation="Vertical">
                        <StackPanel x:Name="SlotBarRow1"
                                    Orientation="Horizontal"
                                    Margin="0,0,0,6"/>
                        <StackPanel x:Name="SlotBarRow2"
                                    Orientation="Horizontal"/>
                    </StackPanel>
                    <!-- Gemeinsame Aktions-Buttons (Diskette/X/Zeit) — EINMAL,
                         vertikal zentriert ueber beide Reihen. -->
                    <StackPanel x:Name="SlotActions"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="8,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
