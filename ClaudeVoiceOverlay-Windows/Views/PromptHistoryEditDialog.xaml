<Window x:Class="ClaudeVoiceOverlay.Views.PromptHistoryEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Historie-Eintrag bearbeiten"
        Width="720" Height="520"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">

    <Border CornerRadius="14"
            Background="#F01E1E1E"
            BorderBrush="#FF3A3A3A"
            BorderThickness="1">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Historie-Eintrag bearbeiten"
                       Foreground="#FFCCCCCC"
                       FontWeight="Bold"
                       FontSize="14"
                       Margin="0,0,0,4"/>
            <TextBlock Grid.Row="1"
                       x:Name="MetaLabel"
                       Text=""
                       Foreground="#FF8C8C8C"
                       FontSize="11"
                       Margin="0,0,0,12"
                       TextTrimming="CharacterEllipsis"/>

            <Border Grid.Row="2"
                    CornerRadius="8"
                    Background="#FF1A1A1A"
                    BorderBrush="#FF3A3A3A"
                    BorderThickness="1">
                <TextBox x:Name="EditBox"
                         AcceptsReturn="True"
                         AcceptsTab="False"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Background="Transparent"
                         Foreground="White"
                         CaretBrush="#FFFFD700"
                         BorderThickness="0"
                         FontSize="14"
                         Padding="12,10"
                         FontFamily="Segoe UI"/>
            </Border>

            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,12,0,0">
                <Button x:Name="BtnCancel"
                        Content="Abbrechen"
                        Padding="14,6"
                        Margin="0,0,8,0"
                        MinWidth="100"
                        Background="#FF383838"
                        Foreground="White"
                        BorderBrush="#FF6A6A6A"
                        BorderThickness="1"
                        FontSize="12"
                        Cursor="Hand"/>
                <Button x:Name="BtnSave"
                        Content="Speichern"
                        Padding="14,6"
                        MinWidth="100"
                        Background="#FFB8860B"
                        Foreground="White"
                        BorderBrush="#FFFFD700"
                        BorderThickness="1"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Cursor="Hand"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
