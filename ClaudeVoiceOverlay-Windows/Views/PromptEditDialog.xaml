<Window x:Class="ClaudeVoiceOverlay.Views.PromptEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Prompt"
        Width="560" Height="780"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ResizeMode="NoResize">
    <Window.Resources>
        <!-- Flat dark-theme button for the dialog footer (Cancel / Save). -->
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FFCCCCCC"/>
            <Setter Property="Background" Value="#FF2D2D2D"/>
            <Setter Property="BorderBrush" Value="#FF454545"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#FF3A3A3A"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#FF606060"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#FF252525"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Accented variant for the primary Save button (golden highlight). -->
        <Style x:Key="DialogButtonAccent" TargetType="Button" BasedOn="{StaticResource DialogButton}">
            <Setter Property="Background" Value="#FFB8860B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#FFD4960D"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#FF9C7209"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Generic flat round button used for the mic and G action buttons. -->
        <Style x:Key="ActionRound" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#FF3D3D3D"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b"
                                Background="{TemplateBinding Background}"
                                CornerRadius="20"
                                BorderBrush="#FF777777"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#FF555555"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="16"
            Background="#FF1E1E1E"
            BorderBrush="#FF3A3A3A"
            BorderThickness="1"
            Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       x:Name="TitleText"
                       Text="Prompt bearbeiten"
                       Foreground="#FFEEEEEE"
                       FontWeight="Bold"
                       FontSize="14"
                       Margin="0,0,0,12"/>

            <TextBlock Grid.Row="1" Text="Kurzbezeichnung" Foreground="#FFCCCCCC" FontSize="12" Margin="0,0,0,4"/>
            <TextBox Grid.Row="2"
                     x:Name="ShortLabelBox"
                     Background="#FF2D2D2D"
                     Foreground="White"
                     CaretBrush="White"
                     BorderBrush="#FF454545"
                     BorderThickness="1"
                     Padding="8,6"
                     FontSize="13"
                     Margin="0,0,0,10"/>

            <TextBlock Grid.Row="3" Text="Prompt-Text" Foreground="#FFCCCCCC" FontSize="12" Margin="0,0,0,4"/>
            <TextBox Grid.Row="4"
                     x:Name="OriginalTextBox"
                     Background="#FF2D2D2D"
                     Foreground="White"
                     CaretBrush="White"
                     BorderBrush="#FF454545"
                     BorderThickness="1"
                     Padding="8,6"
                     FontSize="13"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     Margin="0,0,0,10"/>

            <!-- Always-on master toggle + two sub-options (Pre / Post)
                 stacked vertically. The sub-options are indented so the
                 hierarchy reads at a glance. -->
            <StackPanel Grid.Row="5" Orientation="Vertical" Margin="0,0,0,10">
                <CheckBox x:Name="AlwaysOnCheckbox"
                          Foreground="#FFEEEEEE"
                          Content="Immer mitschicken (Always-On Prefix)"
                          FontSize="12"
                          Margin="0,0,0,4"/>
                <CheckBox x:Name="PrePromptCheckbox"
                          Foreground="#FFEEEEEE"
                          Content="Pre-Prompt (vor dem Diktat)"
                          FontSize="12"
                          Margin="22,0,0,2"/>
                <CheckBox x:Name="PostPromptCheckbox"
                          Foreground="#FFEEEEEE"
                          Content="Post-Prompt (nach dem Diktat)"
                          FontSize="12"
                          Margin="22,0,0,0"/>
            </StackPanel>

            <!-- Hotkey assignment. Pressing Strg+N (1..9) anywhere in a
                 terminal pastes the prompt's effective text. Exactly one
                 toggle can be active at a time; "Kein" clears the binding.
                 Conflict resolution is "last wins": saving a prompt with
                 Strg+3 silently strips that number from any other prompt
                 that owned it before. -->
            <StackPanel Grid.Row="6" Orientation="Vertical" Margin="0,0,0,10">
                <TextBlock Text="Hotkey (Strg + Zahl)"
                           Foreground="#FFCCCCCC"
                           FontSize="12"
                           Margin="0,0,0,4"/>
                <WrapPanel x:Name="HotkeyPanel" Orientation="Horizontal"/>
            </StackPanel>

            <!-- Status line for recording / Gemini progress. -->
            <TextBlock Grid.Row="7"
                       x:Name="StatusText"
                       Text=""
                       Foreground="#FF999999"
                       FontSize="11"
                       Margin="0,0,0,8"
                       TextWrapping="Wrap"/>

            <!-- Three-column footer: cancel | mic+G centered | save (or split save). -->
            <Grid Grid.Row="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        x:Name="BtnCancel"
                        Style="{StaticResource DialogButton}"
                        HorizontalAlignment="Left"
                        Content="Abbrechen"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="BtnMic"
                            Style="{StaticResource ActionRound}"
                            Content="🎤"
                            ToolTip="Aufnehmen — klicken zum Starten/Stoppen. Ergebnis wird in den Prompt-Text eingefuegt."/>
                    <Button x:Name="BtnGemini"
                            Style="{StaticResource ActionRound}"
                            Content="G"
                            ToolTip="Mit Gemini verbessern — der aktuelle Text wird durch eine bereinigte Variante ersetzt. Original bleibt erhalten und kann separat gespeichert werden."/>
                </StackPanel>

                <!-- Single Save button (default before any improvement). -->
                <Button Grid.Column="2"
                        x:Name="BtnOk"
                        Style="{StaticResource DialogButtonAccent}"
                        HorizontalAlignment="Right"
                        Content="Speichern"
                        Padding="16,7"
                        IsDefault="True"/>

                <!-- Two-button save stack — only visible after Gemini produced
                     an improvement. Stacked vertically (not side-by-side) so
                     "Original speichern" and "Verbessert speichern" both fit
                     in the dialog width without truncation. -->
                <StackPanel Grid.Column="2"
                            x:Name="DualSavePanel"
                            Orientation="Vertical"
                            HorizontalAlignment="Right"
                            Visibility="Collapsed">
                    <Button x:Name="BtnSaveImproved"
                            Content="Verbessert speichern"
                            Background="#FFB8860B"
                            Foreground="White"
                            BorderThickness="0"
                            Padding="14,8"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,0,6"
                            Cursor="Hand"/>
                    <Button x:Name="BtnSaveOriginal"
                            Content="Original speichern"
                            Background="#FF2D2D2D"
                            Foreground="#FFEEEEEE"
                            BorderBrush="#FF777777"
                            BorderThickness="1"
                            Padding="14,6"
                            HorizontalAlignment="Stretch"
                            Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
