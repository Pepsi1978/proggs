{
	"name": "bestjournal-functions",
	"version": "1.0.0",
	"description": "Cloud Functions for BestJournal — fetches accurate subscription plan info from Google Play Subscriptions API v2",
	"engines": {
		"node": "20"
	},
	"main": "index.js",
	"scripts": {
		"lint": "echo 'no lint configured'",
		"serve": "firebase emulators:start --only functions",
		"shell": "firebase functions:shell",
		"start": "npm run shell",
		"deploy": "firebase deploy --only functions",
		"logs": "firebase functions:log"
	},
	"dependencies": {
		"firebase-admin": "^13.0.0",
		"firebase-functions": "^6.0.0",
		"googleapis": "^144.0.0"
	},
	"private": true
}
