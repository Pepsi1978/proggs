<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ data extraction rules (API >= 31).

    cloud-backup: Google Drive / Google Auto Backup (user logs out and back in)
    device-transfer: Device-to-device transfer during new phone setup

    Both exclude dashboard_db and retrospective_db so only journal entries +
    SharedPreferences (profile) are restored. Dashboard and retrospectives
    regenerate from journal entries via the profile prompt.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="dashboard_db" />
        <exclude domain="database" path="dashboard_db-journal" />
        <exclude domain="database" path="dashboard_db-wal" />
        <exclude domain="database" path="dashboard_db-shm" />
        <exclude domain="database" path="retrospective_db" />
        <exclude domain="database" path="retrospective_db-journal" />
        <exclude domain="database" path="retrospective_db-wal" />
        <exclude domain="database" path="retrospective_db-shm" />
        <exclude domain="sharedpref" path="entropy_journal_secure_prefs.xml" />
        <exclude domain="sharedpref" path="entropy_journal_secure_prefs" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="dashboard_db" />
        <exclude domain="database" path="dashboard_db-journal" />
        <exclude domain="database" path="dashboard_db-wal" />
        <exclude domain="database" path="dashboard_db-shm" />
        <exclude domain="database" path="retrospective_db" />
        <exclude domain="database" path="retrospective_db-journal" />
        <exclude domain="database" path="retrospective_db-wal" />
        <exclude domain="database" path="retrospective_db-shm" />
        <exclude domain="sharedpref" path="entropy_journal_secure_prefs.xml" />
        <exclude domain="sharedpref" path="entropy_journal_secure_prefs" />
    </device-transfer>
</data-extraction-rules>
