{
	"description": "finale hooks: skill-symlink-verification at session start, destructive-bash-guard in plugin output dirs, audit-only write protection, strings.xml lint after write/edit. Cross-Platform: .sh-Hooks via bash (Git Bash auf Windows, native auf Unix). PowerShell-Pendants existieren als .ps1 fuer Windows ohne bash — siehe README fuer Umstellung.",
	"hooks": {
		"SessionStart": [
			{
				"matcher": "startup|clear|compact|resume",
				"hooks": [
					{
						"type": "command",
						"command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh\"",
						"async": false
					}
				]
			}
		],
		"PreToolUse": [
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/pretooluse-bash.sh\"",
						"async": false
					}
				]
			},
			{
				"matcher": "Edit|Write|MultiEdit",
				"hooks": [
					{
						"type": "command",
						"command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/audit-only-write-guard.sh\"",
						"async": false
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "Edit|Write|MultiEdit",
				"hooks": [
					{
						"type": "command",
						"command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/posttooluse-strings-xml.sh\"",
						"async": false
					}
				]
			}
		]
	}
}
