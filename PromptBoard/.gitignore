# PromptBoard .gitignore

# Un-ignore PromptBoard.App directory — the global ~/.gitignore_global
# uses `*.app/` (intended for macOS .app bundles) which accidentally
# matches our Windows WinUI project folder name. This override restores it.
!PromptBoard.App/
!PromptBoard.App/**

# Build output
bin/
obj/
out/
[Dd]ebug/
[Rr]elease/
x64/
x86/
AppPackages/
BundleArtifacts/

# Publish + installer drops (generated by scripts/build-installer.ps1)
publish/

# Visual Studio / Rider
.vs/
.vscode/
.idea/
*.user
*.suo
*.userosscache
*.sln.docstates
*.ncrunch*
*.psess
*.vsp

# NuGet
*.nupkg
*.snupkg
packages/
project.lock.json
project.fragment.lock.json
artifacts/

# JetBrains
_ReSharper*/
*.[Rr]e[Ss]harper

# Test results
TestResults/
*.trx
*.coverage
*.coveragexml

# Logs (local log output)
logs/
*.log

# Local secrets and user-specific files
secrets.json
*.pfx

# MSIX / Packaging
*.appx
*.appxbundle
*.msix
*.msixbundle
GeneratedArtifacts/

# OS files
Thumbs.db
.DS_Store

# Ignore local EF Core SQLite databases (each user has their own)
*.db
*.db-shm
*.db-wal
