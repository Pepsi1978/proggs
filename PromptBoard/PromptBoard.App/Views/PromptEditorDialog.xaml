<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="PromptBoard.App.Views.PromptEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PromptBoard.App.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d"
    Title="Prompt bearbeiten"
    PrimaryButtonText="Speichern"
    CloseButtonText="Abbrechen"
    DefaultButton="Primary">

    <Grid MinWidth="560" MinHeight="460" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Kurztitel (5 bis 7 Woerter)" Opacity="0.7" />
        <TextBox Grid.Row="1" x:Name="ShortLabelTextBox" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
            <TextBlock Text="Originaltext" Opacity="0.7" VerticalAlignment="Center" />

            <Button x:Name="DictateButton"
                    ToolTipService.ToolTip="Gedrueckt halten zum Diktieren (Groq Whisper)">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <FontIcon Glyph="&#xE720;" FontSize="14" />
                    <TextBlock Text="Diktieren" />
                </StackPanel>
            </Button>

            <TextBlock x:Name="RecordingHint"
                       Text="Aufnahme laeuft... loslassen zum Beenden"
                       Foreground="#C72E2E"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Visibility="Collapsed" />

            <StackPanel x:Name="TranscribingHint"
                        Orientation="Horizontal"
                        Spacing="6"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                <ProgressRing IsActive="True" Width="16" Height="16" />
                <TextBlock Text="Transkribiere..." VerticalAlignment="Center" Opacity="0.7" />
            </StackPanel>

            <TextBlock x:Name="DictateErrorHint"
                       Foreground="#C72E2E"
                       FontStyle="Italic"
                       VerticalAlignment="Center"
                       Visibility="Collapsed"
                       TextWrapping="Wrap" />

            <Button x:Name="ImproveButton"
                    ToolTipService.ToolTip="Mit aktivem Meta-Prompt via Google Gemini verbessern">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <FontIcon Glyph="&#xE8E1;" FontSize="14" />
                    <TextBlock Text="Mit KI verbessern" />
                </StackPanel>
            </Button>

            <StackPanel x:Name="ImprovingHint"
                        Orientation="Horizontal"
                        Spacing="6"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                <ProgressRing IsActive="True" Width="16" Height="16" />
                <TextBlock Text="Gemini arbeitet..." VerticalAlignment="Center" Opacity="0.7" />
            </StackPanel>

            <TextBlock x:Name="ImproveErrorHint"
                       Foreground="#C72E2E"
                       FontStyle="Italic"
                       VerticalAlignment="Center"
                       Visibility="Collapsed"
                       TextWrapping="Wrap" />
        </StackPanel>

        <TextBox Grid.Row="3"
                 x:Name="OriginalTextBox"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 MinHeight="140"
                 ScrollViewer.VerticalScrollBarVisibility="Auto" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
            <TextBlock Text="KI-verbesserter Text" Opacity="0.7" VerticalAlignment="Center" />
            <TextBlock x:Name="ImprovedHint" Text="(noch nicht erzeugt)" Opacity="0.5" FontStyle="Italic" />
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="12">
            <RadioButton x:Name="UseOriginalRadio" Content="Original verwenden" GroupName="Version" />
            <RadioButton x:Name="UseImprovedRadio" Content="Verbesserten Text verwenden" GroupName="Version" />
        </StackPanel>

        <TextBox Grid.Row="6"
                 x:Name="ImprovedTextBox"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 MinHeight="140"
                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
    </Grid>
</ContentDialog>
