<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="PromptBoard.App.Views.PromptEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PromptBoard.App.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d"
    Title="Prompt bearbeiten"
    PrimaryButtonText="Speichern"
    CloseButtonText="Abbrechen"
    DefaultButton="Primary">

    <Grid MinWidth="560" MinHeight="420" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Kurztitel (5–7 Woerter)" Opacity="0.7" />
        <TextBox Grid.Row="1" x:Name="ShortLabelTextBox" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
            <TextBlock Text="Originaltext" Opacity="0.7" VerticalAlignment="Center" />
            <Button x:Name="DictateButton"
                    ToolTipService.ToolTip="Diktieren (folgt in Phase 4)"
                    IsEnabled="False"
                    Content="Mikrofon" />
            <Button x:Name="ImproveButton"
                    ToolTipService.ToolTip="Mit KI verbessern (folgt in Phase 5)"
                    IsEnabled="False"
                    Content="Mit KI verbessern" />
        </StackPanel>

        <TextBox Grid.Row="3"
                 x:Name="OriginalTextBox"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 MinHeight="120"
                 ScrollViewer.VerticalScrollBarVisibility="Auto" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
            <TextBlock Text="KI-verbesserter Text" Opacity="0.7" VerticalAlignment="Center" />
            <TextBlock x:Name="ImprovedHint" Text="(noch nicht erzeugt)" Opacity="0.5" FontStyle="Italic" />
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="12">
            <RadioButton x:Name="UseOriginalRadio" Content="Original verwenden" GroupName="Version" />
            <RadioButton x:Name="UseImprovedRadio" Content="Verbesserten Text verwenden" GroupName="Version" />
        </StackPanel>

        <TextBox Grid.Row="6"
                 x:Name="ImprovedTextBox"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 MinHeight="120"
                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
    </Grid>
</ContentDialog>
