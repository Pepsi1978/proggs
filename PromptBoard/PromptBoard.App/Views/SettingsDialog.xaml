<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="PromptBoard.App.Views.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PromptBoard.App.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d"
    Title="Einstellungen"
    PrimaryButtonText="Speichern"
    CloseButtonText="Abbrechen"
    DefaultButton="Primary">

    <Grid MinWidth="560" MinHeight="420">
        <Pivot x:Name="SettingsPivot">

            <PivotItem Header="API-Keys">
                <StackPanel Spacing="16" Padding="0,12,0,0">

                    <StackPanel Spacing="4">
                        <TextBlock Text="Groq API-Key" FontWeight="SemiBold" />
                        <TextBlock TextWrapping="Wrap" Opacity="0.7"
                                   Text="Wird fuer das Whisper-Diktat verwendet. Du bekommst den Key auf console.groq.com." />
                        <PasswordBox x:Name="GroqKeyBox" PlaceholderText="gsk_..." />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Gemini API-Key" FontWeight="SemiBold" />
                        <TextBlock TextWrapping="Wrap" Opacity="0.7"
                                   Text="Wird fuer die KI-Verbesserung verwendet. Du bekommst den Key auf aistudio.google.com." />
                        <PasswordBox x:Name="GeminiKeyBox" PlaceholderText="AIza..." />
                    </StackPanel>

                    <TextBlock FontStyle="Italic" Opacity="0.6" TextWrapping="Wrap"
                               Text="Hinweis: Die Keys werden aktuell lokal in der Datenbank gespeichert. Eine Migration zum Windows Credential Manager (DPAPI) folgt in einer spaeteren Iteration." />
                </StackPanel>
            </PivotItem>

            <PivotItem Header="Verhalten">
                <StackPanel Spacing="16" Padding="0,12,0,0">

                    <StackPanel Spacing="4">
                        <TextBlock Text="Leisten-Hoehe (Pixel)" FontWeight="SemiBold" />
                        <NumberBox x:Name="BarHeightBox" Minimum="80" Maximum="800" SmallChange="10" SpinButtonPlacementMode="Inline" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Trenner zwischen verketteten Prompts" FontWeight="SemiBold" />
                        <TextBlock Opacity="0.7" TextWrapping="Wrap"
                                   Text="Standard: Leerzeile, Semikolon, Leerzeile. Verwende \n fuer Zeilenumbrueche." />
                        <TextBox x:Name="SeparatorBox" />
                    </StackPanel>

                    <ToggleSwitch x:Name="AlwaysOnTopToggle"
                                  Header="Immer im Vordergrund"
                                  OnContent="An"
                                  OffContent="Aus" />

                    <TextBlock FontStyle="Italic" Opacity="0.6" TextWrapping="Wrap"
                               Text="Nach dem Speichern wird die Leiste neu positioniert, damit die Hoehe sofort sichtbar wird." />
                </StackPanel>
            </PivotItem>

            <PivotItem Header="Modelle">
                <StackPanel Spacing="16" Padding="0,12,0,0">

                    <StackPanel Spacing="4">
                        <TextBlock Text="Groq Whisper-Modell" FontWeight="SemiBold" />
                        <ComboBox x:Name="GroqModelBox" HorizontalAlignment="Stretch" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Gemini-Modelle (Vorschlaege)" FontWeight="SemiBold" />
                        <TextBlock Opacity="0.7" TextWrapping="Wrap"
                                   Text="Das Modell wird aktuell pro Meta-Prompt in der KI-Bibliothek festgelegt. Standardwert ist 'gemini-2.5-flash'." />
                        <ItemsControl x:Name="GeminiModelList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Opacity="0.8" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </PivotItem>

            <PivotItem Header="Google-Konto">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="14" Padding="0,12,0,0">

                        <TextBlock TextWrapping="Wrap" Opacity="0.8"
                                   Text="Fuer die Drive-Sicherung brauchst du eine eigene OAuth-Credential (Desktop-App) aus deinem Google-Cloud-Projekt. Lege dort das Drive-API frei und trage ID und Secret hier ein." />

                        <HyperlinkButton x:Name="GoogleCloudLink"
                                         Content="Google Cloud Console oeffnen"
                                         NavigateUri="https://console.cloud.google.com/apis/credentials" />

                        <StackPanel Spacing="4">
                            <TextBlock Text="OAuth Client-ID" FontWeight="SemiBold" />
                            <TextBox x:Name="GoogleClientIdBox" PlaceholderText="123456789-abc.apps.googleusercontent.com" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="OAuth Client-Secret" FontWeight="SemiBold" />
                            <PasswordBox x:Name="GoogleClientSecretBox" PlaceholderText="GOCSPX-..." />
                        </StackPanel>

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                CornerRadius="6"
                                Padding="12"
                                Margin="0,4,0,0">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ProgressRing x:Name="GoogleBusyRing" Width="18" Height="18" IsActive="False" />
                                    <TextBlock x:Name="GoogleStatusText" VerticalAlignment="Center" TextWrapping="Wrap"
                                               Text="Noch nicht verbunden." />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="GoogleConnectButton" Content="Verbinden">
                                        <Button.Resources>
                                            <Style TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}" />
                                        </Button.Resources>
                                    </Button>
                                    <Button x:Name="GoogleDisconnectButton" Content="Trennen" IsEnabled="False" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock FontStyle="Italic" Opacity="0.6" TextWrapping="Wrap"
                                   Text="Hinweis: Die Anmeldung oeffnet kurz deinen Standardbrowser. Die Sicherung landet im versteckten App-Ordner in deinem Drive und ist fuer andere Apps unsichtbar." />
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>
        </Pivot>
    </Grid>
</ContentDialog>
