<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="PromptBoard.App.Views.AboutDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PromptBoard.App.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d"
    Title="Ueber PromptBoard"
    CloseButtonText="Schliessen"
    DefaultButton="Close">

    <StackPanel MinWidth="420" Spacing="14" Padding="0,8,0,0">

        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <FontIcon Glyph="&#xE8A1;" FontSize="32" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            <StackPanel>
                <TextBlock Text="PromptBoard" FontSize="20" FontWeight="SemiBold" />
                <TextBlock x:Name="VersionText" Opacity="0.7" FontSize="12" />
            </StackPanel>
        </StackPanel>

        <TextBlock TextWrapping="Wrap" Opacity="0.8"
                   Text="Persoenliches Prompt-Board als randlose Leiste am oberen Bildschirmrand. Kategorisiert, diktiert, KI-verbessert, verkettet — und klickt Prompts direkt in deine CLI, ohne den Fokus zu stehlen." />

        <StackPanel Spacing="2">
            <TextBlock Text="Technik" FontWeight="SemiBold" FontSize="13" />
            <TextBlock Opacity="0.7" FontSize="12"
                       Text=".NET 10 · WinUI 3 (unpackaged) · SQLite via EF Core · Serilog · CommunityToolkit.Mvvm · NAudio · Groq Whisper · Google Gemini" />
        </StackPanel>

        <StackPanel Spacing="2">
            <TextBlock Text="Hotkey" FontWeight="SemiBold" FontSize="13" />
            <TextBlock Opacity="0.7" FontSize="12"
                       Text="Strg+Shift+P — Leiste ein/ausblenden (global)" />
        </StackPanel>

        <HyperlinkButton x:Name="RepoLink" Content="github.com/Pepsi1978/proggs"
                         NavigateUri="https://github.com/Pepsi1978/proggs" />
    </StackPanel>
</ContentDialog>
