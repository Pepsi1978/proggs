<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="PromptBoard.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PromptBoard.App"
    xmlns:vm="using:PromptBoard.ViewModels"
    xmlns:conv="using:PromptBoard.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <conv:HexToBrushConverter x:Key="HexToBrush" />
        <conv:BoolToOpacityConverter x:Key="BoolToOpacity" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />

        <DataTemplate x:Key="PromptTemplate" x:DataType="vm:PromptViewModel">
            <Grid Padding="2" ColumnSpacing="6" KeyDown="OnPromptKeyDown"
                  Visibility="{x:Bind IsVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Command="{x:Bind ToggleVersionCommand}"
                        ToolTipService.ToolTip="Original/Verbessert umschalten"
                        Padding="4,0"
                        MinWidth="28"
                        Opacity="{x:Bind CanToggleVersion, Converter={StaticResource BoolToOpacity}, Mode=OneWay}">
                    <TextBlock FontSize="11" FontWeight="SemiBold" Text="O/A" />
                </Button>

                <CheckBox Grid.Column="1"
                          IsChecked="{x:Bind IsAlwaysOn, Mode=TwoWay}"
                          ToolTipService.ToolTip="Always-On (H) — immer mitschicken"
                          MinWidth="0"
                          Padding="0" />

                <Button Grid.Column="2"
                        Command="{x:Bind InsertCommand}"
                        Content="{x:Bind ShortLabel, Mode=OneWay}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left">
                    <ToolTipService.ToolTip>
                        <ToolTip>
                            <TextBlock Text="{Binding EffectiveText, Mode=OneWay}"
                                       TextWrapping="Wrap"
                                       MaxWidth="520" />
                        </ToolTip>
                    </ToolTipService.ToolTip>
                </Button>

                <Button Grid.Column="3"
                        Command="{x:Bind EditCommand}"
                        ToolTipService.ToolTip="Prompt bearbeiten"
                        Padding="6,0"
                        MinWidth="28">
                    <FontIcon Glyph="&#xE70F;" FontSize="12" />
                </Button>

                <Button Grid.Column="4"
                        Command="{x:Bind DeleteCommand}"
                        ToolTipService.ToolTip="Prompt loeschen"
                        Padding="6,0"
                        MinWidth="28">
                    <FontIcon Glyph="&#xE74D;" FontSize="12" />
                </Button>
            </Grid>
        </DataTemplate>

        <!-- Inline rendering (Standard + AiLibrary) — full tile with prompts directly below header. -->
        <DataTemplate x:Key="InlineCategoryTemplate" x:DataType="vm:CategoryViewModel">
            <Border CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    MinWidth="260"
                    MaxWidth="320"
                    Padding="0"
                    Visibility="{x:Bind IsVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{x:Bind BackgroundColorHex, Converter={StaticResource HexToBrush}, Mode=OneWay}"
                            CornerRadius="8,8,0,0"
                            Padding="8,6">
                        <Grid ColumnSpacing="4" KeyDown="OnCategoryKeyDown">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="{x:Bind Name, Mode=OneWay}"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       VerticalAlignment="Center"
                                       Foreground="Black" />

                            <Button Grid.Column="1"
                                    Command="{x:Bind AddPromptCommand}"
                                    ToolTipService.ToolTip="Prompt hinzufuegen"
                                    Padding="6,2"
                                    MinWidth="0">
                                <FontIcon Glyph="&#xE710;" FontSize="12" Foreground="Black" />
                            </Button>

                            <Button Grid.Column="2"
                                    Command="{x:Bind RenameCommand}"
                                    ToolTipService.ToolTip="Umbenennen"
                                    Padding="6,2"
                                    MinWidth="0">
                                <FontIcon Glyph="&#xE70F;" FontSize="12" Foreground="Black" />
                            </Button>

                            <Button Grid.Column="3"
                                    Command="{x:Bind DeleteCommand}"
                                    ToolTipService.ToolTip="Kategorie loeschen"
                                    Padding="6,2"
                                    MinWidth="0">
                                <FontIcon Glyph="&#xE74D;" FontSize="12" Foreground="Black" />
                            </Button>
                        </Grid>
                    </Border>

                    <ListView Grid.Row="1"
                              ItemsSource="{x:Bind Prompts, Mode=OneWay}"
                              ItemTemplate="{StaticResource PromptTemplate}"
                              CanReorderItems="True"
                              CanDragItems="True"
                              AllowDrop="True"
                              SelectionMode="None"
                              Padding="4"
                              IsItemClickEnabled="False">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,1" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Flyout rendering (Project) — just a colored header button; prompts appear in a popup. -->
        <DataTemplate x:Key="ProjectFlyoutTemplate" x:DataType="vm:CategoryViewModel">
            <Button Background="{x:Bind BackgroundColorHex, Converter={StaticResource HexToBrush}, Mode=OneWay}"
                    MinWidth="140"
                    MaxWidth="220"
                    Padding="10,6"
                    VerticalAlignment="Top"
                    Visibility="{x:Bind IsVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{x:Bind Name, Mode=OneWay}"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Foreground="Black"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <FontIcon Glyph="&#xE70D;" FontSize="10" Foreground="Black" />
                </StackPanel>
                <Button.Flyout>
                    <Flyout Placement="Bottom" ShouldConstrainToRootBounds="False">
                        <Grid MinWidth="320" MaxWidth="420" MaxHeight="460" RowSpacing="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" ColumnSpacing="4" KeyDown="OnCategoryKeyDown">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{x:Bind Name, Mode=OneWay}"
                                           FontWeight="SemiBold"
                                           FontSize="14"
                                           VerticalAlignment="Center" />

                                <Button Grid.Column="1"
                                        Command="{x:Bind AddPromptCommand}"
                                        ToolTipService.ToolTip="Prompt hinzufuegen"
                                        Padding="6,2"
                                        MinWidth="0">
                                    <FontIcon Glyph="&#xE710;" FontSize="12" />
                                </Button>

                                <Button Grid.Column="2"
                                        Command="{x:Bind RenameCommand}"
                                        ToolTipService.ToolTip="Projekt umbenennen"
                                        Padding="6,2"
                                        MinWidth="0">
                                    <FontIcon Glyph="&#xE70F;" FontSize="12" />
                                </Button>

                                <Button Grid.Column="3"
                                        Command="{x:Bind DeleteCommand}"
                                        ToolTipService.ToolTip="Projekt loeschen"
                                        Padding="6,2"
                                        MinWidth="0">
                                    <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                </Button>
                            </Grid>

                            <ListView Grid.Row="1"
                                      ItemsSource="{x:Bind Prompts, Mode=OneWay}"
                                      ItemTemplate="{StaticResource PromptTemplate}"
                                      CanReorderItems="True"
                                      CanDragItems="True"
                                      AllowDrop="True"
                                      SelectionMode="None"
                                      IsItemClickEnabled="False">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,1" />
                                        <Setter Property="MinHeight" Value="0" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                            </ListView>
                        </Grid>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="RootGrid" Padding="8" Background="{ThemeResource SystemControlAcrylicWindowBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Column="0"
                      HorizontalScrollMode="Enabled"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollMode="Disabled"
                      VerticalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Horizontal" Spacing="8">

                <!-- Standard zone -->
                <ListView x:Name="StandardList"
                          ItemTemplate="{StaticResource InlineCategoryTemplate}"
                          CanReorderItems="True"
                          CanDragItems="True"
                          AllowDrop="True"
                          SelectionMode="None"
                          IsItemClickEnabled="False"
                          ScrollViewer.HorizontalScrollMode="Disabled"
                          ScrollViewer.VerticalScrollMode="Disabled">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>

                <Border x:Name="SeparatorAfterStandard"
                        Width="1"
                        Background="{ThemeResource CardStrokeColorDefaultBrush}"
                        Margin="4,12,4,12"
                        Opacity="0.5" />

                <!-- Project zone -->
                <ListView x:Name="ProjectList"
                          ItemTemplate="{StaticResource ProjectFlyoutTemplate}"
                          VerticalAlignment="Top"
                          CanReorderItems="True"
                          CanDragItems="True"
                          AllowDrop="True"
                          SelectionMode="None"
                          IsItemClickEnabled="False"
                          ScrollViewer.HorizontalScrollMode="Disabled"
                          ScrollViewer.VerticalScrollMode="Disabled">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="6" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>

                <Border x:Name="SeparatorAfterProjects"
                        Width="1"
                        Background="{ThemeResource CardStrokeColorDefaultBrush}"
                        Margin="4,12,4,12"
                        Opacity="0.5" />

                <!-- AiLibrary zone -->
                <ListView x:Name="AiLibraryList"
                          ItemTemplate="{StaticResource InlineCategoryTemplate}"
                          CanReorderItems="True"
                          CanDragItems="True"
                          AllowDrop="True"
                          SelectionMode="None"
                          IsItemClickEnabled="False"
                          ScrollViewer.HorizontalScrollMode="Disabled"
                          ScrollViewer.VerticalScrollMode="Disabled">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="4"
                    VerticalAlignment="Top"
                    Margin="8,4,4,0">

            <AutoSuggestBox x:Name="SearchBox"
                            PlaceholderText="Suchen..."
                            QueryIcon="Find"
                            Width="200"
                            VerticalAlignment="Center"
                            ToolTipService.ToolTip="Kategorien und Prompts filtern" />

            <Button x:Name="BackupButton"
                    ToolTipService.ToolTip="Sichern und wiederherstellen">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <FontIcon Glyph="&#xE7B8;" FontSize="12" />
                    <TextBlock Text="Backup" />
                </StackPanel>
            </Button>

            <Button x:Name="AddCategoryButton"
                    ToolTipService.ToolTip="Neue Kategorie anlegen"
                    Style="{ThemeResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <FontIcon Glyph="&#xE710;" FontSize="12" />
                    <TextBlock Text="Kategorie" />
                </StackPanel>
            </Button>
        </StackPanel>

        <TextBlock x:Name="EmptyHint"
                   Grid.Column="0"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   Opacity="0.55"
                   FontSize="14"
                   Text="Noch keine Kategorien. Rechts auf &quot;+ Kategorie&quot; klicken, um zu starten."
                   Visibility="Collapsed" />

        <InfoBar x:Name="UndoBar"
                 Grid.Row="1"
                 Grid.Column="0"
                 Grid.ColumnSpan="2"
                 IsOpen="False"
                 IsClosable="True"
                 Severity="Informational"
                 Margin="0,8,0,0"
                 Title="Rueckgaengig moeglich">
            <InfoBar.ActionButton>
                <Button x:Name="UndoButton" Content="Rueckgaengig" />
            </InfoBar.ActionButton>
        </InfoBar>
    </Grid>
</UserControl>
