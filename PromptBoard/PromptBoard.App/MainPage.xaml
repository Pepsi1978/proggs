<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="PromptBoard.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PromptBoard.App"
    xmlns:vm="using:PromptBoard.ViewModels"
    xmlns:conv="using:PromptBoard.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <conv:HexToBrushConverter x:Key="HexToBrush" />
        <conv:BoolToOpacityConverter x:Key="BoolToOpacity" />

        <DataTemplate x:Key="PromptTemplate" x:DataType="vm:PromptViewModel">
            <Grid Padding="2" ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Command="{x:Bind ToggleVersionCommand}"
                        ToolTipService.ToolTip="Original/Verbessert umschalten"
                        Padding="4,0"
                        MinWidth="28"
                        Opacity="{x:Bind CanToggleVersion, Converter={StaticResource BoolToOpacity}, Mode=OneWay}">
                    <TextBlock FontSize="11" FontWeight="SemiBold" Text="O/A" />
                </Button>

                <CheckBox Grid.Column="1"
                          IsChecked="{x:Bind IsAlwaysOn, Mode=TwoWay}"
                          ToolTipService.ToolTip="Always-On (H) — immer mitschicken"
                          MinWidth="0"
                          Padding="0" />

                <Button Grid.Column="2"
                        Command="{x:Bind InsertCommand}"
                        Content="{x:Bind ShortLabel, Mode=OneWay}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        ToolTipService.ToolTip="In CLI einfuegen (wird in Phase 2 aktiviert)" />

                <Button Grid.Column="3"
                        Command="{x:Bind EditCommand}"
                        ToolTipService.ToolTip="Prompt bearbeiten"
                        Padding="6,0"
                        MinWidth="28">
                    <FontIcon Glyph="&#xE70F;" FontSize="12" />
                </Button>

                <Button Grid.Column="4"
                        Command="{x:Bind DeleteCommand}"
                        ToolTipService.ToolTip="Prompt loeschen"
                        Padding="6,0"
                        MinWidth="28">
                    <FontIcon Glyph="&#xE74D;" FontSize="12" />
                </Button>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="CategoryTemplate" x:DataType="vm:CategoryViewModel">
            <Border CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    MinWidth="260"
                    MaxWidth="320"
                    Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{x:Bind BackgroundColorHex, Converter={StaticResource HexToBrush}, Mode=OneWay}"
                            CornerRadius="8,8,0,0"
                            Padding="8,6">
                        <Grid ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="{x:Bind Name, Mode=OneWay}"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       VerticalAlignment="Center"
                                       Foreground="Black" />

                            <Button Grid.Column="1"
                                    Command="{x:Bind AddPromptCommand}"
                                    ToolTipService.ToolTip="Prompt hinzufuegen"
                                    Padding="6,2"
                                    MinWidth="0">
                                <FontIcon Glyph="&#xE710;" FontSize="12" Foreground="Black" />
                            </Button>

                            <Button Grid.Column="2"
                                    Command="{x:Bind RenameCommand}"
                                    ToolTipService.ToolTip="Umbenennen"
                                    Padding="6,2"
                                    MinWidth="0">
                                <FontIcon Glyph="&#xE70F;" FontSize="12" Foreground="Black" />
                            </Button>

                            <Button Grid.Column="3"
                                    Command="{x:Bind DeleteCommand}"
                                    ToolTipService.ToolTip="Kategorie loeschen"
                                    Padding="6,2"
                                    MinWidth="0">
                                <FontIcon Glyph="&#xE74D;" FontSize="12" Foreground="Black" />
                            </Button>
                        </Grid>
                    </Border>

                    <ItemsControl Grid.Row="1"
                                  ItemsSource="{x:Bind Prompts, Mode=OneWay}"
                                  ItemTemplate="{StaticResource PromptTemplate}"
                                  Padding="4" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="RootGrid" Padding="8" Background="{ThemeResource SystemControlAcrylicWindowBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0"
                      HorizontalScrollMode="Enabled"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollMode="Disabled"
                      VerticalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="CategoriesList"
                          ItemTemplate="{StaticResource CategoryTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>

        <Button x:Name="AddCategoryButton"
                Grid.Column="1"
                VerticalAlignment="Top"
                Margin="8,4,4,0"
                ToolTipService.ToolTip="Neue Kategorie anlegen"
                Style="{ThemeResource AccentButtonStyle}">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <FontIcon Glyph="&#xE710;" FontSize="12" />
                <TextBlock Text="Kategorie" />
            </StackPanel>
        </Button>

        <TextBlock x:Name="EmptyHint"
                   Grid.Column="0"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   Opacity="0.55"
                   FontSize="14"
                   Text="Noch keine Kategorien. Rechts auf &quot;+ Kategorie&quot; klicken, um zu starten."
                   Visibility="Collapsed" />
    </Grid>
</UserControl>
