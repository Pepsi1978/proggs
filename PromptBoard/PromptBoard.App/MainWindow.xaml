<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="PromptBoard.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:PromptBoard.App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource SystemControlAcrylicWindowBrush}">
        <StackPanel Orientation="Horizontal"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Spacing="16">
            <FontIcon Glyph="&#xE8A1;" FontSize="28" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            <TextBlock Text="PromptBoard"
                       FontSize="22"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <TextBlock Text="Hello World  ·  Phase 0  ·  borderless, topmost, no-focus-stealing"
                       FontSize="14"
                       Opacity="0.7"
                       VerticalAlignment="Center" />
        </StackPanel>
    </Grid>
</Window>
