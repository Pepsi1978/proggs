{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment": "macOS-Fassung des Minimal-Profils. 1:1 aus Profiles/ClaudeCode/minimal/settings.json; der Emulator-Waechter laeuft hier als bash-Skript statt als PowerShell-Skript. Das Profil bleibt regelfrei - die Skills blendet der Launcher per Symlink ein.",
  "permissions": {
    "defaultMode": "default"
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/proggs/claude-code-setup/hooks/statusline.sh",
    "refreshInterval": 10
  },
  "language": "german",
  "effortLevel": "xhigh",
  "askUserQuestionTimeout": "never",
  "skipDangerousModePermissionPrompt": true,
  "claudeMdExcludes": [
    "**/proggs/CLAUDE.md",
    "**/proggs/CLAUDE.local.md",
    "**/.claude/rules/**"
  ],
  "theme": "dark",
  "preferredNotifChannel": "auto",
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/emulator-start-guard.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
