{
  "env": {
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "claude-sonnet-5-5"
  },
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/proggs/claude-code-setup/hooks/emulator-start-guard.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|mcp__.*firecrawl.*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/proggs/claude-code-setup/hooks/research-approval.sh\"",
            "timeout": 8
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$JARVIS_AUFTRAG_ID\" ] || python3 \"$HOME/proggs/Jarvis/werkzeuge/pc-bruecke/jarvis_hook.py\" lokal frage",
            "timeout": 660
          }
        ],
        "matcher": "AskUserQuestion"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$JARVIS_AUFTRAG_ID\" ] || python3 \"$HOME/proggs/Jarvis/werkzeuge/pc-bruecke/jarvis_hook.py\" lokal puls",
            "timeout": 10,
            "async": true
          }
        ],
        "matcher": "*"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/proggs/OpenLauncher/Profiles/hooks/claude-login-sync.sh\"",
            "timeout": 20
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$JARVIS_AUFTRAG_ID\" ] || python3 \"$HOME/proggs/Jarvis/werkzeuge/pc-bruecke/jarvis_hook.py\" lokal warte",
            "timeout": 43200,
            "asyncRewake": true,
            "rewakeSummary": "Nachricht von Frank über Jarvis"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/proggs/OpenLauncher/Profiles/hooks/claude-login-sync.sh\"",
            "timeout": 20
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$JARVIS_AUFTRAG_ID\" ] || python3 \"$HOME/proggs/Jarvis/werkzeuge/pc-bruecke/jarvis_hook.py\" lokal ende",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$JARVIS_AUFTRAG_ID\" ] || python3 \"$HOME/proggs/Jarvis/werkzeuge/pc-bruecke/jarvis_hook.py\" lokal post",
            "timeout": 15,
            "async": true
          }
        ],
        "matcher": "*"
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$JARVIS_AUFTRAG_ID\" ] || python3 \"$HOME/proggs/Jarvis/werkzeuge/pc-bruecke/jarvis_hook.py\" lokal post",
            "timeout": 15,
            "async": true
          }
        ],
        "matcher": "Bash|PowerShell"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$JARVIS_AUFTRAG_ID\" ] || python3 \"$HOME/proggs/Jarvis/werkzeuge/pc-bruecke/jarvis_hook.py\" lokal prompt",
            "timeout": 15,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$JARVIS_AUFTRAG_ID\" ] || python3 \"$HOME/proggs/Jarvis/werkzeuge/pc-bruecke/jarvis_hook.py\" lokal stop",
            "timeout": 30,
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$JARVIS_AUFTRAG_ID\" ] || python3 \"$HOME/proggs/Jarvis/werkzeuge/pc-bruecke/jarvis_hook.py\" lokal warte",
            "timeout": 43200,
            "asyncRewake": true,
            "rewakeSummary": "Nachricht von Frank über Jarvis"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$JARVIS_AUFTRAG_ID\" ] || python3 \"$HOME/proggs/Jarvis/werkzeuge/pc-bruecke/jarvis_hook.py\" lokal fehlschlag",
            "timeout": 30,
            "async": true
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/proggs/claude-code-setup/hooks/statusline.sh",
    "refreshInterval": 10
  },
  "effortLevel": "high",
  "skipDangerousModePermissionPrompt": true,
  "claudeMdExcludes": [
    "**/.claude/rules/**"
  ],
  "theme": "dark",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "_comment": "macOS-Fassung des Standard-Profils. 1:1 aus Profiles/ClaudeCode/standard/settings.json; der Emulator-Waechter laeuft hier als bash-Skript statt als PowerShell-Skript.",
  "tui": "fullscreen",
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "advisorModel": "fable",
  "enabledPlugins": {
    "bio-research@synced": false,
    "sales@synced": false,
    "small-business@synced": false,
    "marketing@synced": false,
    "legal@synced": false,
    "finance@synced": false,
    "human-resources@synced": false,
    "zapier@synced": false,
    "customer-support@synced": false,
    "operations@synced": false,
    "product-management@synced": false,
    "design@synced": false,
    "data@synced": false,
    "enterprise-search@synced": false,
    "engineering@synced": false,
    "desktop-commander@synced": false,
    "cowork-plugin-management@synced": false
  }
}
