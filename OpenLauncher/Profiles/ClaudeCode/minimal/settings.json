{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "claude-sonnet-5-5"
  },
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File \"$USERPROFILE/proggs/claude-code-setup/hooks/emulator-start-guard.ps1\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|mcp__.*firecrawl.*",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File \"$USERPROFILE/proggs/claude-code-setup/hooks/research-approval.ps1\"",
            "timeout": 8
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$USERPROFILE/proggs/Jarvis/werkzeuge/pc-bruecke/jarvis_hook.py\" lokal frage",
            "timeout": 660
          }
        ],
        "matcher": "AskUserQuestion"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$USERPROFILE/proggs/Jarvis/werkzeuge/pc-bruecke/jarvis_hook.py\" lokal puls",
            "timeout": 10,
            "async": true
          }
        ],
        "matcher": "*"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"$USERPROFILE/proggs/OpenLauncher/Profiles/hooks/claude-login-sync.ps1\"",
            "timeout": 20
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$USERPROFILE/proggs/Jarvis/werkzeuge/pc-bruecke/jarvis_hook.py\" lokal warte",
            "timeout": 43200,
            "asyncRewake": true,
            "rewakeSummary": "Nachricht von Frank über Jarvis"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"$USERPROFILE/proggs/OpenLauncher/Profiles/hooks/claude-login-sync.ps1\"",
            "timeout": 20
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$USERPROFILE/proggs/Jarvis/werkzeuge/pc-bruecke/jarvis_hook.py\" lokal ende",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$USERPROFILE/proggs/Jarvis/werkzeuge/pc-bruecke/jarvis_hook.py\" lokal post",
            "timeout": 15,
            "async": true
          }
        ],
        "matcher": "*"
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$USERPROFILE/proggs/Jarvis/werkzeuge/pc-bruecke/jarvis_hook.py\" lokal post",
            "timeout": 15,
            "async": true
          }
        ],
        "matcher": "Bash|PowerShell"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$USERPROFILE/proggs/Jarvis/werkzeuge/pc-bruecke/jarvis_hook.py\" lokal prompt",
            "timeout": 15,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$USERPROFILE/proggs/Jarvis/werkzeuge/pc-bruecke/jarvis_hook.py\" lokal stop",
            "timeout": 30,
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$USERPROFILE/proggs/Jarvis/werkzeuge/pc-bruecke/jarvis_hook.py\" lokal warte",
            "timeout": 43200,
            "asyncRewake": true,
            "rewakeSummary": "Nachricht von Frank über Jarvis"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$USERPROFILE/proggs/Jarvis/werkzeuge/pc-bruecke/jarvis_hook.py\" lokal fehlschlag",
            "timeout": 30,
            "async": true
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/proggs/claude-code-setup/hooks/statusline.sh",
    "refreshInterval": 10
  },
  "enabledPlugins": {
    "bio-research@synced": false,
    "sales@synced": false,
    "small-business@synced": false,
    "marketing@synced": false,
    "legal@synced": false,
    "finance@synced": false,
    "human-resources@synced": false,
    "zapier@synced": false,
    "customer-support@synced": false,
    "operations@synced": false,
    "product-management@synced": false,
    "design@synced": false,
    "data@synced": false,
    "enterprise-search@synced": false,
    "engineering@synced": false,
    "desktop-commander@synced": false,
    "cowork-plugin-management@synced": false
  },
  "language": "german",
  "feedbackDrafts": "notify",
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "high"
    },
    "claude-opus-5": {
      "effortLevel": "xhigh"
    },
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "advisorModel": "fable",
  "askUserQuestionTimeout": "5m",
  "dialogExpiry": "5m",
  "timeFormat": "24-hour",
  "skipDangerousModePermissionPrompt": true,
  "claudeMdExcludes": [
    "**/proggs/AGENTS.md",
    "**/proggs/CLAUDE.md",
    "**/proggs/CLAUDE.local.md",
    "**/.claude/rules/**"
  ],
  "theme": "dark",
  "verbose": false,
  "preferredNotifChannel": "terminal_bell",
  "autoCompactEnabled": true,
  "switchModelsOnFlag": true,
  "remoteControlAtStartup": true,
  "crossSessionInbound": "accept",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
