{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "model": "opus[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File \"$USERPROFILE/proggs/claude-code-setup/hooks/emulator-start-guard.ps1\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|mcp__.*firecrawl.*",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File \"$USERPROFILE/proggs/claude-code-setup/hooks/research-approval.ps1\"",
            "timeout": 8
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"$USERPROFILE/proggs/OpenLauncher/Profiles/hooks/claude-login-sync.ps1\"",
            "timeout": 20
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"$USERPROFILE/proggs/OpenLauncher/Profiles/hooks/claude-login-sync.ps1\"",
            "timeout": 20
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/proggs/claude-code-setup/hooks/statusline.sh",
    "refreshInterval": 10
  },
  "enabledPlugins": {
    "bio-research@synced": false,
    "sales@synced": false,
    "small-business@synced": false,
    "marketing@synced": false,
    "legal@synced": false,
    "finance@synced": false,
    "human-resources@synced": false,
    "zapier@synced": false,
    "customer-support@synced": false,
    "operations@synced": false,
    "product-management@synced": false,
    "design@synced": false,
    "data@synced": false,
    "enterprise-search@synced": false,
    "engineering@synced": false,
    "desktop-commander@synced": false,
    "cowork-plugin-management@synced": false
  },
  "language": "german",
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "high"
    },
    "claude-opus-5": {
      "effortLevel": "xhigh"
    }
  },
  "advisorModel": "fable",
  "askUserQuestionTimeout": "never",
  "skipDangerousModePermissionPrompt": true,
  "claudeMdExcludes": [
    "**/proggs/CLAUDE.md",
    "**/proggs/CLAUDE.local.md",
    "**/.claude/rules/**"
  ],
  "theme": "dark",
  "preferredNotifChannel": "auto",
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
