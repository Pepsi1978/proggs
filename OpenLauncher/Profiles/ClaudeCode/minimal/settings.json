{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "statusLine": {
    "type": "command",
    "command": "bash ~/proggs/claude-code-setup/hooks/statusline.sh",
    "refreshInterval": 10
  },
  "effortLevel": "xhigh",
  "skipDangerousModePermissionPrompt": true,
  "claudeMdExcludes": [
    "**/proggs/CLAUDE.md",
    "**/proggs/CLAUDE.local.md",
    "**/.claude/rules/**"
  ],
  "theme": "dark",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File \"$USERPROFILE/.claude/hooks/emulator-start-guard.ps1\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
