<Window x:Class="OpenLauncher.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Einstellungen · Modell-Recherche" Width="760" Height="780" MinWidth="580" MinHeight="540"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBg}" TextElement.Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource HoverBg}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBg}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{DynamicResource SurfaceBg}" BorderBrush="{DynamicResource BorderBrushStrong}" BorderThickness="1" CornerRadius="8">
                                            <TextBlock Text="▾" HorizontalAlignment="Right" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="12,6,30,6" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
                                <Border Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource BorderBrushStrong}" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="260"><ItemsPresenter/></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource PanelBg}"/>
            <Setter Property="Padding" Value="12,7"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Modell-Recherche" FontSize="23" FontWeight="SemiBold"/>
            <TextBlock Text="Codex ergänzt fehlende Effort-Angaben mit belegten Webquellen." Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="VERBINDUNG" Foreground="{DynamicResource MutedBrush}" FontSize="12" FontWeight="Bold"/>
                        <TextBlock x:Name="ConnectionText" Text="Anmeldestatus wird geladen …" Margin="0,8,0,10" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="LoginButton" Content="Mit OpenAI anmelden" Click="Login_Click"/>
                            <Button x:Name="ReloadButton" Content="Modelle laden" Margin="8,0,0,0" Click="Reload_Click"/>
                            <Button x:Name="CancelButton" Content="Abbrechen" Margin="8,0,0,0" Click="Cancel_Click" IsEnabled="False"/>
                        </StackPanel>
                        <TextBox x:Name="DeviceText" Visibility="Collapsed" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource AccentBrush}" FontSize="17" Margin="0,12,0,0"/>
                        <Button x:Name="DeviceLinkButton" Visibility="Collapsed" Content="Anmeldeseite öffnen" HorizontalAlignment="Left" Margin="0,8,0,0" Click="DeviceLink_Click"/>
                        <TextBlock Text="Eigene verschlüsselte Anmeldung. Deine vorhandene Codex-CLI-Session bleibt unverändert. Ohne Anmeldung keine KI-Aufrufe." FontSize="12" Foreground="{DynamicResource DimBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel x:Name="SettingsPanel">
                        <TextBlock Text="RECHERCHE" Foreground="{DynamicResource MutedBrush}" FontSize="12" FontWeight="Bold"/>
                        <TextBlock Text="Modus" Margin="0,10,0,5"/>
                        <ComboBox x:Name="ModeBox" DisplayMemberPath="Label" SelectedValuePath="Value"/>
                        <TextBlock Text="Normale Katalogabfragen bleiben aktiv. KI hilft bei Lücken oder Widersprüchen. Regelmäßig: benutzte Modelle werden bei geöffnetem Launcher erneut abgeglichen. KI-Anfragen können dein Kontingent verbrauchen." TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource DimBrush}" Margin="0,6,0,12"/>
                        <TextBlock Text="Recherche-Modell (verfügbare Modelle deines Kontos)" Margin="0,0,0,5"/>
                        <ComboBox x:Name="ModelBox" DisplayMemberPath="Id" SelectionChanged="Model_Changed"/>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Recherche-Effort" Margin="0,0,0,5"/><ComboBox x:Name="EffortBox"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Periodischer Abstand" Margin="0,0,0,5"/><ComboBox x:Name="PeriodBox" DisplayMemberPath="Label" SelectedValuePath="Hours"/></StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="LETZTER BERICHT PRO MODELL" Foreground="{DynamicResource MutedBrush}" FontSize="12" FontWeight="Bold"/>
                        <TextBlock x:Name="TargetText" TextWrapping="Wrap" Margin="0,8,0,8"/>
                        <Button x:Name="ResearchButton" Content="Ausgewähltes Launcher-Modell recherchieren" HorizontalAlignment="Left" Click="Research_Click"/>
                        <TextBox x:Name="ReportText" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="100" MaxHeight="280" VerticalScrollBarVisibility="Auto"
                                 Background="{DynamicResource SurfaceBg}" Foreground="{DynamicResource TextBrush}" BorderThickness="0" Padding="10" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" Margin="0,0,12,0"/>
            <Button x:Name="SaveButton" Grid.Column="1" Content="Speichern" Click="Save_Click"/>
            <Button Grid.Column="2" Content="Schließen" Margin="8,0,0,0" Click="Close_Click"/>
        </Grid>
    </Grid>
</Window>
