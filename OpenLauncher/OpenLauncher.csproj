<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>OpenLauncher</RootNamespace>
    <AssemblyName>OpenLauncher</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.20.0</Version>
    <FileVersion>1.20.0.0</FileVersion>
    <AssemblyVersion>1.20.0.0</AssemblyVersion>
    <Company>Pepsi1978</Company>
    <Product>OpenLauncher</Product>
    <Copyright>© 2026 Pepsi1978</Copyright>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
  </ItemGroup>

  <!-- Build-Zeitstempel sekundengenau in die Assembly schreiben. Frueher stand die Uhrzeit als
       Literal im MainViewModel und musste von Hand gepflegt werden - genau da entstanden falsche
       (sogar in der Zukunft liegende) Stempel. Jetzt liefert MSBuild den echten Build-Zeitpunkt;
       von Hand eintragen ist nicht mehr moeglich. Wird bei jedem Compile neu gesetzt. -->
  <Target Name="SetBuildTimestamp" BeforeTargets="GetAssemblyAttributes">
    <PropertyGroup>
      <BuildTimestamp>$([System.DateTime]::Now.ToString("dd.MM.yyyy, HH.mm"))</BuildTimestamp>
    </PropertyGroup>
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>BuildTimestamp</_Parameter1>
        <_Parameter2>$(BuildTimestamp)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>

  <!-- Profil-Quellen (Profiles/OpenCode/<id>/AGENTS.md, Profiles/ClaudeCode/sources/<id>.md) werden
       zur Laufzeit direkt aus dem Repo gelesen, nicht aus dem Build-Output -> kein Content-Eintrag noetig. -->

  <!-- Profiles\ClaudeCode ist ein LIVE Claude-Code-Config-Ordner (CLAUDE_CONFIG_DIR), kein
       Assembly-Inhalt. Vom Build-Globbing ausschliessen, damit Laufzeit-Dateien (Login-Token,
       projects/, sessions/) niemals kompiliert oder in den Publish-Output gebuendelt werden. -->
  <ItemGroup>
    <Compile Remove="Profiles\ClaudeCode\**" />
    <Page Remove="Profiles\ClaudeCode\**" />
    <None Remove="Profiles\ClaudeCode\**" />
    <Content Remove="Profiles\ClaudeCode\**" />
    <EmbeddedResource Remove="Profiles\ClaudeCode\**" />
  </ItemGroup>

</Project>
