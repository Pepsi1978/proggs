[Unit]
Description=tmux-Server aller CLI-Sitzungen (Speicherdeckel 7 GB schützt Relay und Second Brain, CPU ohne Deckel)
After=network-online.target

[Service]
Type=forking
User=jarvis
WorkingDirectory=/home/jarvis/proggs
Environment=HOME=/home/jarvis TZ=Europe/Berlin LANG=C.UTF-8 LC_ALL=C.UTF-8
ExecStart=/usr/bin/tmux -L jarvis -f /home/jarvis/proggs/OpenLauncherServer/systemd/tmux.conf new-session -d -s basis
ExecStop=/usr/bin/tmux -L jarvis kill-server
Restart=always
RestartSec=5
# 7 GB (Franks Vorgabe 13.11.2026, nach dem Entfernen von Werft Studio): ab 6,5 GB bremst der Kernel, bei 7 GB ist Schluss.
MemoryHigh=6500M
MemoryMax=7000M
# Kein CPU-Deckel (Franks Vorgabe 13.11.2026): Die Sitzungen dürfen alle vCPUs voll nutzen; Nice=5 lässt Relay und Second Brain bei Last trotzdem vor.
CPUQuota=
OOMPolicy=continue
Nice=5

[Install]
WantedBy=multi-user.target
