<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Bewusst UNSANDBOXED (Projekt-Anker der macOS-Apps): der Launcher schreibt in ~/proggs,
         ~/.config/opencode und startet Terminal-Prozesse. Mit App-Sandbox waere nichts davon moeglich. -->
    <key>com.apple.security.app-sandbox</key>
    <false/>
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
