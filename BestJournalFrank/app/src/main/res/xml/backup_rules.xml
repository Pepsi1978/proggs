<?xml version="1.0" encoding="utf-8"?>
<!--
    Google Auto Backup rules (Android 11 and below, API <= 30).

    Only the journal entries database (entropy_journal_db) and SharedPreferences
    (profile + settings) are backed up. Dashboard and retrospective databases are
    excluded so they regenerate from journal entries after restore, using the
    profile's prompt configuration.
-->
<full-backup-content>
    <!--
        The encrypted prefs are sealed with a hardware-bound Keystore master key that never
        leaves the original device. Restoring the file elsewhere yields an undecryptable
        keyset, so it is excluded rather than restored as unreadable data.
    -->
    <exclude domain="sharedpref" path="entropy_journal_secure_prefs.xml" />
    <exclude domain="database" path="dashboard_db" />
    <exclude domain="database" path="dashboard_db-journal" />
    <exclude domain="database" path="dashboard_db-wal" />
    <exclude domain="database" path="dashboard_db-shm" />
    <exclude domain="database" path="retrospective_db" />
    <exclude domain="database" path="retrospective_db-journal" />
    <exclude domain="database" path="retrospective_db-wal" />
    <exclude domain="database" path="retrospective_db-shm" />
</full-backup-content>
