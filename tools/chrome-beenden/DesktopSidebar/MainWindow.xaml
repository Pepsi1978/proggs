<Window x:Class="DesktopSidebar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chrome-Shutdown-Sidebar"
        Width="188" Height="372"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI Variable, Segoe UI">

    <Window.Resources>
        <!-- Symbol-Font: Windows 11 (Segoe Fluent Icons) mit Fallback auf Windows 10 (Segoe MDL2 Assets) -->
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- Wiederverwendbarer Stil fuer die beiden Aktions-Buttons (Neustart / Herunterfahren) -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                CornerRadius="12"
                                Background="{TemplateBinding Background}"
                                BorderThickness="1"
                                BorderBrush="#22FFFFFF">
                            <Grid Margin="0,16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0"
                                           x:Name="Glyph"
                                           FontFamily="{StaticResource IconFont}"
                                           Text="{TemplateBinding Tag}"
                                           FontSize="30"
                                           HorizontalAlignment="Center"
                                           Foreground="{TemplateBinding Foreground}"/>
                                <TextBlock Grid.Row="1"
                                           Margin="0,8,0,0"
                                           Text="{TemplateBinding Content}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Foreground="#F2FFFFFF"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#55FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97" CenterX="74" CenterY="50"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Der gesamte sichtbare Inhalt liegt im RootBorder. SlideTransform faehrt ihn rein/raus. -->
    <Border x:Name="RootBorder"
            CornerRadius="18,0,0,18"
            Margin="0"
            Background="#F01B1B1F"
            BorderBrush="#26FFFFFF"
            BorderThickness="1,1,0,1">
        <Border.RenderTransform>
            <TranslateTransform x:Name="SlideTransform" X="200"/>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="0" Opacity="0.45"/>
        </Border.Effect>

        <Grid Margin="14,18,14,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Kopfzeile -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,16">
                <TextBlock Text="Beenden" FontSize="15" FontWeight="SemiBold"
                           Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                <TextBlock Text="schliesst zuerst Chrome" FontSize="10.5"
                           Foreground="#9AFFFFFF" HorizontalAlignment="Center" Margin="0,2,0,0"/>
            </StackPanel>

            <!-- Die zwei Buttons -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <Button x:Name="RestartButton"
                        Style="{StaticResource ActionButton}"
                        Content="Neustart"
                        Tag="&#xE777;"
                        Background="#FF2D6CDF"
                        Height="118"
                        Click="RestartButton_Click"/>
                <Button x:Name="ShutdownButton"
                        Style="{StaticResource ActionButton}"
                        Content="Herunterfahren"
                        Tag="&#xE7E8;"
                        Background="#FFD13438"
                        Height="118"
                        Margin="0,12,0,0"
                        Click="ShutdownButton_Click"/>
            </StackPanel>

            <!-- Fusszeile -->
            <TextBlock Grid.Row="2" Text="Chrome-Sidebar" FontSize="9.5"
                       Foreground="#66FFFFFF" HorizontalAlignment="Center" Margin="0,14,0,0"/>

            <!-- Countdown-Overlay (liegt ueber allem, normal unsichtbar) -->
            <Border x:Name="CountdownOverlay"
                    Grid.RowSpan="3"
                    CornerRadius="17,0,0,17"
                    Background="#F00F0F12"
                    Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10">
                    <TextBlock x:Name="CountdownTitle" Text="Neustart"
                               FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="CountdownNumber" Text="3"
                               FontSize="58" FontWeight="Bold" Foreground="#FFFFFF"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    <TextBlock x:Name="CountdownHint" Text="Sekunden"
                               FontSize="11" Foreground="#9AFFFFFF"
                               HorizontalAlignment="Center"/>
                    <Button x:Name="CancelButton" Content="Abbrechen"
                            Margin="0,22,0,0" Padding="18,8"
                            FontSize="13" FontWeight="SemiBold"
                            Foreground="#FFFFFF" Cursor="Hand"
                            Click="CancelButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Cb" CornerRadius="10" Background="#26FFFFFF"
                                        BorderBrush="#44FFFFFF" BorderThickness="1">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" Margin="18,8"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Cb" Property="Background" Value="#40FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
