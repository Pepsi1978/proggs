#!/usr/bin/env bash
# Git wrapper for Codex Git multi-session locking.

set +e
set -u

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

resolve_real_git() {
    if [ -n "${CODEX_GIT_LOCK_REAL_GIT:-}" ] && [ -x "${CODEX_GIT_LOCK_REAL_GIT:-}" ]; then
        printf '%s' "$CODEX_GIT_LOCK_REAL_GIT"
        return
    fi

    if command -v git.exe >/dev/null 2>&1; then
        command -v git.exe
        return
    fi

    local candidates candidate home_bin home_local_bin
    candidates="$(which -a git 2>/dev/null || command -v git 2>/dev/null || true)"
    home_bin="${HOME:-}/bin/git"
    home_local_bin="${HOME:-}/.local/bin/git"
    for candidate in $candidates; do
        case "$candidate" in
            "$SCRIPT_DIR/git"|"$home_bin"|"$home_local_bin") continue ;;
        esac
        if [ -x "$candidate" ]; then
            printf '%s' "$candidate"
            return
        fi
    done

    printf 'git'
}

normalize_windows_path_for_bash() {
    local value="$1"
    case "$value" in
        [A-Za-z]:\\*)
            local drive rest
            drive="$(printf '%s' "${value:0:1}" | tr '[:upper:]' '[:lower:]')"
            rest="${value:3}"
            rest="${rest//\\//}"
            printf '/%s/%s' "$drive" "$rest"
            ;;
        *)
            printf '%s' "$value"
            ;;
    esac
}

quote_arg() {
    case "$1" in
        *[[:space:]\"]*)
            local escaped
            escaped="${1//\"/\\\"}"
            printf '"%s"' "$escaped"
            ;;
        *)
            printf '%s' "$1"
            ;;
    esac
}

parse_invocation() {
    cwd="$PWD"
    subcommand=""
    subcommand_index=-1
    args=("$@")
    i=0
    while [ "$i" -lt "${#args[@]}" ]; do
        arg="${args[$i]}"
        case "$arg" in
            -C)
                i=$((i + 1))
                if [ "$i" -lt "${#args[@]}" ]; then
                    cwd="${args[$i]}"
                fi
                i=$((i + 1))
                ;;
            --git-dir|--work-tree|--namespace|-c|--config-env)
                i=$((i + 2))
                ;;
            --git-dir=*|--work-tree=*|--namespace=*|--no-pager|--paginate|--bare|--version|--help)
                i=$((i + 1))
                ;;
            -*)
                i=$((i + 1))
                ;;
            *)
                subcommand="$arg"
                subcommand_index="$i"
                break
                ;;
        esac
    done
    cwd="$(normalize_windows_path_for_bash "$cwd")"
}

is_write_operation() {
    case "$subcommand" in
        add|commit|push|fetch|rebase|pull|reset|restore|checkout|switch|rm|mv|clean|gc|maintenance|stash|am|cherry-pick|revert|merge)
            return 0
            ;;
        tag)
            [ "$#" -gt 0 ]
            return $?
            ;;
        branch)
            [ "$#" -gt 0 ] || return 1
            case "$1" in
                -D|-d|--delete|--force|--move) return 0 ;;
                -m|-M) [ "$#" -gt 1 ]; return $? ;;
                *) return 1 ;;
            esac
            ;;
        remote)
            [ "$#" -gt 0 ] || return 1
            case "$1" in add|remove|rm|rename|set-url|prune|update) return 0 ;; *) return 1 ;; esac
            ;;
        worktree)
            [ "$#" -gt 0 ] || return 1
            case "$1" in add|remove|move|prune) return 0 ;; *) return 1 ;; esac
            ;;
        submodule)
            [ "$#" -gt 0 ] || return 1
            case "$1" in update|add|deinit) return 0 ;; *) return 1 ;; esac
            ;;
        *)
            return 1
            ;;
    esac
}

release_own_lock() {
    local lockfile="$1"
    local session="$2"
    local owner_pid="$3"
    [ -n "$lockfile" ] && [ -f "$lockfile" ] || return 0
    local raw session_needle pid_needle
    raw="$(cat "$lockfile" 2>/dev/null || true)"
    session_needle="\"sessionId\":\"$session\""
    pid_needle="\"pid\":$owner_pid"
    case "$raw" in
        *"$session_needle"*"$pid_needle"*|*"$pid_needle"*"$session_needle"*)
            rm -f "$lockfile" 2>/dev/null || true
            ;;
    esac
}

real_git="$(resolve_real_git)"
if [ "${CODEX_GIT_LOCK_BYPASS:-}" = "1" ]; then
    exec "$real_git" "$@"
fi

parse_invocation "$@"

remaining=()
if [ "$subcommand_index" -ge 0 ]; then
    index=0
    for arg in "$@"; do
        if [ "$index" -gt "$subcommand_index" ]; then
            remaining[${#remaining[@]}]="$arg"
        fi
        index=$((index + 1))
    done
fi

if ! is_write_operation "${remaining[@]}"; then
    exec "$real_git" "$@"
fi

helper="$SCRIPT_DIR/../hooks/codex-git-multi-session-lock.sh"
if [ ! -f "$helper" ]; then
    helper="${HOME:-}/.codex/hooks/codex-git-multi-session-lock.sh"
fi

git_common_dir="$("$real_git" -C "$cwd" rev-parse --git-common-dir 2>/dev/null || true)"
lockfile=""
if [ -n "$git_common_dir" ]; then
    case "$git_common_dir" in
        /*|[A-Za-z]:[/\\]*) lockfile="$git_common_dir/claude-multi-session.lock" ;;
        *) lockfile="$cwd/$git_common_dir/claude-multi-session.lock" ;;
    esac
else
    exec "$real_git" "$@"
fi

session_id="${CODEX_GIT_LOCK_SESSION_ID:-${CODEX_SESSION_ID:-ppid-$PPID}}"
normalized="git $subcommand"
for arg in "${remaining[@]}"; do
    normalized="$normalized $(quote_arg "$arg")"
done

if [ -f "$helper" ]; then
    CODEX_GIT_LOCK_COMMAND="$normalized" \
    CODEX_GIT_LOCK_CWD="$cwd" \
    CODEX_GIT_LOCK_SESSION_ID="$session_id" \
    CODEX_GIT_LOCK_OWNER_PID="$$" \
    CODEX_GIT_LOCK_COMMON_DIR="$git_common_dir" \
    CODEX_GIT_LOCK_REAL_GIT="$real_git" \
        bash "$helper" >/dev/null || true
fi

CODEX_GIT_LOCK_BYPASS=1 "$real_git" "$@"
git_exit=$?
release_own_lock "$lockfile" "$session_id" "$$"
exit "$git_exit"
